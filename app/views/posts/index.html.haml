- content_for :title, @author ? t('.title.author_posts', author: @author) : t('.title.default')

- content_for :breadcrumbs do
  %li.breadcrumb-item= link_to t('.posts'), posts_path
  - if @author.present?
    %li.breadcrumb-item= link_to @author, @author
    %li.breadcrumb-item.active= link_to t('.posts'), posts_path(author: @author.slug)

%h1= @author ? t('.title.author_posts', author: @author) : t('.title.default')

.row
  .col-md-2
  .col-md-8= will_paginate @posts
.row
  .col-md-2
    = render 'layouts/nav', model: Post
    %hr/
    %p
      - if @author
        = render @author
        - feed = link_to(t('.author_feed', author: @author), member_posts_path(@author, format: 'rss'))
        = t('.subscribe_author_html', feed: feed)

      - else
        = t('.subscribe_html', site: ENV.fetch('GROWSTUFF_SITE_NAME', nil),
          posts: link_to(t('.posts_feed'), posts_path(format: 'rss')),
          comments: link_to(t('.comments_feed'), comments_path(format: 'rss')))
  .col-md-10
    .row.posts
      - @posts.each do |post|
        .col-lg-3.col-md-6.mb-3.post
          = render 'posts/preview', post: post
    = will_paginate @posts

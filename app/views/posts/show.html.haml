= content_for :title, @post.subject
- content_for :opengraph do
  = tag("meta", property: "og:image", content: post_image_path(@post))
  = tag("meta", property: "og:image", content: avatar_uri(@post.author, 200))
  = tag("meta", property: "og:description", content: og_description(@post.body))
  = tag("meta", property: "og:title", content: @post.subject)
  = tag("meta", property: "og:type", content: "article")
  = tag("meta", property: "og:url", content: request.original_url)
  = tag("meta", property: "og:site_name", content: ENV['GROWSTUFF_SITE_NAME'])

- if @post.author && !current_member
  .alert.alert-info
    = t('.visitor_intro_html', author: link_to(@post.author.login_name, member_path(@post.author)),
      site: link_to(ENV.fetch('GROWSTUFF_SITE_NAME', nil), root_path), subject: @post.subject,
      crops: link_to(t('.different_crops'), crops_url))
    :ruby
      sign_in_options = { data: { auth_dialog: 'sign_in' }, class: 'text-success' }
      sign_up_options = { data: { auth_dialog: 'sign_up' }, class: 'text-info' }
      sign_in_link = link_to(t('.sign_in'), new_member_session_path, sign_in_options)
      sign_up_link = link_to(t('.sign_up'), new_member_registration_path, sign_up_options)
    = t('.join_html', sign_in: sign_in_link, sign_up: sign_up_link, site: ENV.fetch('GROWSTUFF_SITE_NAME', nil))

- content_for :buttonbar do
  - if @post.comments.count > 10 && can?(:create, Comment)
    = link_to t('.comment'), '#new-comment', class: 'btn'

- content_for :breadcrumbs do
  %li.breadcrumb-item= link_to @post.author, @post.author
  %li.breadcrumb-item= link_to t('posts.index.posts'), member_posts_path(member_slug: @post.author.slug)
  %li.breadcrumb-item.active{"aria-current" => "page"}= @post.subject

.row.record-page
  .col-md-8.col-12
    .card.post{ id: "post-#{@post.id}" }
      - if (card_photo = @post.default_photo)
        .post-card-photo
          = image_tag card_photo.fullsize_url, alt: card_photo.title
      - if can?(:update, @post) && @post.photos.any?
        - content_for :scripts do
          = javascript_include_tag 'react_islands', defer: true
        .post-card-photo-change
          = react_component('CardPhotoDialog', card_photo_dialog_props(@post))
      .card-header
        %h2.display-3.float-start
          = @post.subject
          - if @post.draft?
            %span.badge.text-bg-warning.fs-6= t('posts.draft')
        = render 'posts/actions', post: @post
      .card-body
        .post-content= render 'posts/single', post: @post
        .index-cards
          - @post.photos.each do |photo|
            = render 'photos/thumbnail', photo: photo

      .card-footer
        = render 'likes/likes', object: @post
        - if current_member
          .shareon.mt-2
            %a.bluesky
            %a.fediverse
            %a.mastodon
            %a.telegram
            %a.copy-url
            %a.email
            %a.print
            %a.web-share
        .float-end
          - if can? :create, Comment
            = link_to '#new-comment', class: 'btn' do
              = icon 'fas', 'comment'
              = t('.comment')

    %section.comments
      = render "comments/comments", commentable: @post
      - if can? :create, Comment
        = render 'comments/inline_form', commentable: @post

  .col-md-4.col-12
    = render @post.author
    - more = @post.more_from_author
    - if more.any?
      %section.more-from-author
        %h2= t('posts.more_from', author: @post.author)
        - more.each do |other|
          = link_to other, class: 'post-compact d-flex gap-2 mb-2' do
            = image_tag post_thumbnail_path(other), class: 'post-compact-photo', alt: ''
            %span
              %strong= other.subject
              %br
              %small.text-muted= l(other.created_at.to_date, format: :short)
    - unless @post.crops.approved.empty?
      %section.crops
        %h2= t('.crops_mentioned')
        .index-cards
          - @post.crops.approved.each do |c|
            = render 'crops/thumbnail', crop: c

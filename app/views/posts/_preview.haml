
.view
  = link_to post do
    = image_tag post_image_path(post), class: 'img img-cover', alt: t('.photo_alt')
%h4.fw-bold.mb-3
  %strong
    = link_to post, lang: post.language.to_s do
      = post.subject.presence || t('posts.untitled')
    - if post.draft?
      %span.badge.text-bg-warning= t('posts.draft')
%p
  = t('.author_html', author: content_tag(:span, post.author, class: 'fw-bold'))
.post-body{ lang: post.language.to_s }
  :markdown
    #{post_stripped_tags(post, length: 300)}
%h6.fw-bold.mb-3
  - post.crops.each do |crop|
    = link_to crop do
      = crop_icon(crop)
      = crop.name.pluralize
/ = image_tag avatar_uri(post.author, 50), class: 'avatar', alt: post.author
= link_to t('.read_more'), post, class: 'btn btn-rounded btn-md'

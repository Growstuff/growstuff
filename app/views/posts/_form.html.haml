-# The body editor is a React island.
- content_for :scripts do
  = javascript_include_tag 'react_islands', defer: true

- draft = @post.new_record? || @post.draft?
- autosave = { createUrl: posts_path, updateUrl: (post_path(@post.id) if @post.persisted?), subjectId: 'post_subject' }

= bootstrap_form_for(@post, html: { class: 'post-edit-page' }) do |f|
  .row
    .col-12.col-lg-8.mb-3
      .card.white.z-depth-1
        .card-header
          - if content_for? :title
            %h1.h2-responsive
              %strong=yield :title
          - if draft
            %span.badge.text-bg-warning.me-2= t('posts.draft')
            %span.text-muted.small= t('.draft_visibility')
          - if @post.errors.any?
            #error_explanation
              %h2
                = t('.errors', count: @post.errors.size)
              %ul
                - @post.errors.full_messages.each do |msg|
                  %li= msg

        .card-body
          = f.text_field :subject, autofocus: 'autofocus', maxlength: 255

          - if @post.forum || @forum
            = label_tag :body, t('.forum_body')
          - else
            = label_tag :body, t('.garden_body')
          -# Falls back to the plain textarea if the editor script does not load.
          - editor_props = { name: 'post[body]', value: @post.body.to_s, previewUrl: preview_posts_path,
            canAddPhoto: can?(:create, Photo), photos: post_photo_props(@post), cardPhotoId: @post.card_photo_id,
            postPath: (post_path(@post.id) if @post.persisted?) }
          - editor_props[:autosave] = autosave if draft
          = react_component('PostEditor', editor_props) do
            = f.text_area :body, rows: 12, label: false
          %span.form-text= t('.editor_instructions_html')

          - if @post.forum || @forum
            - forum = @post.forum || @forum
            %p
              = t('.forum_notice_html', forum: link_to(forum.name, forum))
            .field
              = f.hidden_field :forum_id, value: forum.id

    - if @post.new_record?
      .col-lg-4
        %section.card.mb-3{ 'aria-label': t('.photos') }
          .card-body
            %p.text-muted.small.mb-0
              = t('.photo_instructions_html')
    - if @post.persisted?
      .col-lg-4
        %section.card.mb-3{ 'aria-label': t('.card_photo') }
          .card-header
            %h2.h5.mb-0= t('.card_photo')
          .card-body
            - if (card_photo = @post.default_photo)
              = image_tag card_photo.thumbnail_url, class: 'img-fluid mb-2', alt: card_photo.title
              %p.text-muted.small= t('.card_photo_help')
            - else
              %p.text-muted.small= t('.card_photo_empty')
            - if @post.photos.any?
              = react_component('CardPhotoDialog', card_photo_dialog_props(@post))

        %section.card.mb-3{ 'aria-label': t('.photos_in_post') }
          .card-header.d-flex.justify-content-between
            %h2.h5.mb-0= t('.photos')
            - if can?(:create, Photo)
              = link_to t('.pick_from_flickr'), new_photo_path_for(@post), data: photo_dialog_data(@post),
                class: 'btn btn-sm btn-outline-secondary'
          .card-body
            .index-cards
              - @post.photos.each do |photo|
                = render 'photos/thumbnail', photo: photo
            %p.text-muted.small.mb-0= t('.flickr_photos')

  .post-save-bar.d-flex.flex-wrap.align-items-center.gap-2
    %p.text-muted.small.mb-0.me-auto
      - if draft
        = t('.autosave_help')
    - if draft && @post.persisted?
      = link_to t('.discard_draft'), post_path(@post), method: :delete, data: { confirm: t('.confirm_discard') },
        class: 'btn btn-outline-danger'
    - if @post.persisted?
      = link_to t('.close'), post_path(@post), class: 'btn btn-outline-secondary'
    - if draft
      = button_tag t('.save_draft'), name: 'post[draft]', value: 'true', class: 'btn btn-outline-primary'
      = button_tag t('.publish_post'), name: 'post[draft]', value: 'false', class: 'btn btn-primary'
    - else
      = f.submit t('.save_changes'), class: 'btn btn-primary'

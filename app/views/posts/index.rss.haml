<?xml version="1.0" encoding="UTF-8"?>
%rss{ version: 2.0 }
  %channel
    %title= t('.feed_title', author: @author || t('.all_members'), site: ENV.fetch('GROWSTUFF_SITE_NAME', nil))
    %link= posts_url
    - @posts.each do |post|
      %item
        %title= t('.item_title', subject: post.subject, author: post.author.login_name)
        %description
          :escaped_markdown
            #{ strip_tags markdownify(post.body) }
        %pubdate= post.created_at.to_fs(:rfc822)
        %link= post_url(post)
        %guid= post_url(post)

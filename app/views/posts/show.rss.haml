<?xml version="1.0" encoding="UTF-8"?>
%rss{ version: 2.0 }
  %channel
    %title= t('.feed_title', subject: @post.subject, site: ENV.fetch('GROWSTUFF_SITE_NAME', nil))
    %link= post_url(@post)
    - @post.comments.includes(:author).limit(50).each do |comment|
      %item
        %title= t('.comment_title', author: comment.author.login_name, date: l(comment.created_at, format: :long))
        %description

          :escaped_markdown
            <p>
            #{ t('.comment_description_html', post: link_to(@post.subject, post_url(@post))) }
            </p>

          :escaped_markdown
            #{ strip_tags markdownify(comment.body) }

        %pubdate= comment.created_at.to_fs(:rfc822)
        %link= post_url(@post)
        %guid= comment_url(comment)

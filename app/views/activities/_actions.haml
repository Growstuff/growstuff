- if can?(:edit, activity)
  - copy_path = new_activity_path(name: activity.name, description: activity.description, category: activity.category,
                                   garden_id: activity.garden_id, planting_id: activity.planting_id, due_date: activity.due_date)
  - finish_path = activity_path(slug: activity.slug, activity: { finished: 1 })
  = actions_menu('activity') do
    = menu_link_to :edit, t('buttons.edit'), edit_activity_path(slug: activity.slug)
    = menu_link_to :copy, t('buttons.copy'), copy_path
    - if activity.active
      = menu_link_to :finish, t('buttons.mark_as_finished'), finish_path, method: :put, class: 'append-date'
    .dropdown-divider
    = menu_delete_button(activity)

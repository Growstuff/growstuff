.section-header
  %h2= t('plantings.show.seeds_saved')
  -# Saving seeds is in the page's actions menu too; this is the quiet
  -# affordance in place, and the link behind the menu item.
  - if can?(:edit, planting) && !planting.failed?
    = link_to new_planting_seed_path(planting_slug: planting.slug), class: 'btn btn-sm section-add' do
      = icon 'fas', 'plus'
      add

- if planting.child_seeds.size.positive?
  .index-cards
    - planting.child_seeds.each do |seed|
      = render 'seeds/card', seed: seed
- else
  %p.text-muted= t('plantings.show.no_seeds')
  - if can?(:edit, planting)
    %p= t('plantings.show.no_seeds_prompt')

-# A small question mark beside a fact card's title that says more on a tap or a hover.
%button.btn.btn-link.p-0.ms-1{ class: local_assigns[:css], type: 'button', 'aria-label': label,
  data: { 'bs-toggle': 'popover', 'bs-trigger': 'hover focus', 'bs-placement': 'top', 'bs-title': title, 'bs-content': content } }
  = icon 'far', 'circle-question'

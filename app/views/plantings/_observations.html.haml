-# What the grower noticed about this planting, newest first, as a timeline. The
-# add link opens the same dialog as the actions menu item (see PlantingActions).
.section-header
  %h2= t('plantings.show.observations')
  - if can?(:edit, planting)
    - add_options = { class: 'btn btn-sm section-add', data: { planting_dialog: 'observation' } }
    = link_to planting_path(planting, anchor: 'observations'), add_options do
      = icon 'fas', 'plus'
      = t('.add')
- if observations.empty?
  %p.text-muted.mb-0= t('plantings.show.no_observations')
- else
  %ol.observation-timeline.list-unstyled
    - observations.each do |observation|
      %li.observation{ class: ("observation-problem" if observation.problem?), id: "observation-#{observation.id}" }
        %span.observation-icon= observation_icon(observation.kind)
        .observation-when
          %time{ datetime: observation.observed_at.iso8601 }= l(observation.observed_at.to_date)
          - if planting.planted_at.present? && observation.observed_at.to_date >= planting.planted_at
            %span.observation-day= t('.day', count: (observation.observed_at.to_date - planting.planted_at).to_i)
        .observation-body
          %strong.observation-kind= observation_kind_label(observation.kind)
          - if observation.author_id != planting.owner_id
            %span.text-muted.small= t('.logged_by', author: observation.author.login_name)
          - if observation.description.present?
            %p.observation-note.mb-0= observation.description
        - if can?(:edit, planting)
          = button_to planting_observation_path(planting_slug: planting.slug, id: observation.id), method: :delete,
            class: 'btn btn-sm btn-link text-danger observation-delete', title: t('.delete'),
            data: { confirm: t('are_you_sure') }, 'aria-label': t('.delete') do
            = icon 'fas', 'times'

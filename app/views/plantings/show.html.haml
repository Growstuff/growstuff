-# This page is about a planting: one member's crop, in one garden, in one season.
-# The crop is context in the right-hand column, not the subject of the page.
- planting_title = t('plantings.show.title', crop: @planting.display_name, owner: @planting.owner)
-# The actions menu and its dialogs are a React island.
- content_for :scripts do
  = javascript_include_tag 'react_islands', defer: true
= render 'plantings/meta', planting: @planting, title: planting_title

- content_for :breadcrumbs do
  %li.breadcrumb-item= link_to 'Plantings', plantings_path
  %li.breadcrumb-item= link_to @planting.owner, member_plantings_path(@planting.owner)
  %li.breadcrumb-item.active{'aria-current' => 'page'}= @planting.display_name

- if can?(:edit, @planting)
  - crop_was = Crop.find_by(id: params[:crop_was]) unless params[:crop_was] == @planting.crop_id.to_s
  - if crop_was
    .origin-undo{role: 'status'}
      = image_tag crop_icon_url(@planting.crop), alt: '', width: 32, height: 32 if crop_icon_url(@planting.crop)
      %p= t('plantings.origin.crop_changed', crop: @planting.crop.name, was: crop_was.name)
      = button_to t('plantings.origin.undo'), planting_path(@planting), method: :patch, params: { planting: { crop_id: crop_was.id } },
        class: 'origin-btn'

= render 'plantings/transplant', planting: @planting

.planting-show.record-page
  .row
    .col-md-8.col-12
      .record-panel.planting-detail
        -# If there's a photo of this planting, lead with it. Only a real one:
        -# the placeholder says nothing worth the space.
        - if @planting.default_photo
          = link_to planting_photos_path(@planting), class: 'record-hero-photo' do
            = image_tag planting_image_path(@planting), alt: "#{@planting.display_name} grown by #{@planting.owner}"
        .jumbotron
          .d-flex.justify-content-between.align-items-start
            -# The grower leads the hero. Somebody grew this; their face belongs
            -# beside it, not tucked into a sidebar block of small links.
            .record-identity
              = render 'shared/record_owner', owner: @planting.owner
              .record-identity-text
                .planting-title
                  %h1.display-3
                    = crop_icon(@planting.crop)
                    %strong= t('plantings.show.heading', crop: @planting.display_name.titleize)
                  = render 'likes/likes', object: @planting
                %p.lead.planting-subtitle
                  grown by
                  %strong.record-grower-name= link_to @planting.owner, @planting.owner
                  %span.text-muted
                    in
                    = link_to @planting.garden, @planting.garden
                    -# Where it grows is one of the first things worth knowing
                    -# about a planting: it decides the seasons and harvest times.
                    - if @planting.garden.location.present?
                      &middot;
                      = link_to @planting.garden.location, place_path(@planting.garden.location, anchor: "plantings")
                    - if @planting.alternate_name.present?
                      = link_to "(#{@planting.crop.name})", @planting.crop
                %p.planting-grower-more.small.mb-0
                  = link_to t('plantings.show.view_all_plantings', owner: @planting.owner), member_plantings_path(@planting.owner)
            .d-flex.align-items-center.gap-2
              - if @planting.short_code.present?
                %span.badge.text-bg-secondary.planting-short-code= @planting.short_code
              - if @planting.failed?
                %span.badge.text-bg-danger Failed
              - elsif @planting.finished?
                %span.badge.text-bg-success Finished
              = render 'plantings/actions', planting: @planting

          = render 'timeline', planting: @planting
          = render 'harvest_months', planting: @planting

        %section.planting-facts= render 'facts', planting: @planting
        -# The dialog the "Grown from" fact opens to ask how the planting was started.
        = react_component 'PlantingOrigin', planting_origin_props(@planting) if can?(:edit, @planting)

        -# The weather it grew through is a section of its own below the facts. Only the charts are the #weather that specs and links go to.
        - if @weather_status
          %section.planting-weather{id: ('weather' if @weather_status == :charts)}
            .section-header
              %h2
                - place = weather_place(@planting.garden)
                = place ? t('plantings.show.weather_in', place:) : t('plantings.show.weather')
                %span.badge.text-bg-light.align-middle.ms-2= t('plantings.show.weather_new')
            - case @weather_status
            - when :charts
              = render 'plantings/weather', planting: @planting, readings: @weather, expected: @expected_weather
            - when :needs_location
              = render 'plantings/weather_location_prompt', garden: @planting.garden
            - when :pending
              .card.weather-pending
                .card-body.text-center
                  = icon 'fas', 'cloud-sun', class: 'fa-2x text-muted'
                  %p.mb-0.mt-2= t('plantings.show.weather_pending')

        - if @planting.description.present?
          = cute_icon
          %section.planting-notes
            .section-header
              %h2= t('plantings.show.notes')
            :markdown
              #{strip_tags markdownify(@planting.description)}

        %section#photos= render 'plantings/photos', photos: @photos, planting: @planting

        = render 'frost/section', frost: @frost if @frost

        %section#harvests.harvests
          = render 'plantings/harvests', planting: @planting, harvests: @harvests

        %section#seeds.descendants
          = render 'plantings/descendants', planting: @planting, child_seeds: @child_seeds

        %section#jobs
          -# Same shape as every other section: one heading bar, one "+ add",
          -# and no sub-heading above an empty list.
          .section-header
            %h2= t('plantings.show.jobs')
            - if can?(:edit, @planting) && can?(:create, Job)
              = link_to new_job_path(garden_id: @planting.garden_id, planting_id: @planting.id), class: 'btn btn-sm section-add' do
                = icon 'fas', 'plus'
                add
          - if @cultivate_soil_link
            .alert.alert-info
              This was the last planting recently in this bed. Would you like to cultivate the soil soon?
              = link_to 'Cultivate soil', @cultivate_soil_link, class: 'btn btn-secondary btn-sm ms-2'
          - if @current_jobs&.size&.positive?
            .index-cards
              - @current_jobs.each do |job|
                = render "jobs/card", job: job
          - else
            %p.text-muted.mb-0= t('plantings.show.no_jobs')
          - if @finished_jobs&.size&.positive?
            %h3= t('plantings.show.jobs_finished')
            .index-cards
              - @finished_jobs.each do |job|
                = render "jobs/card", job: job

        %section#comments.comments
          = render "comments/comments", commentable: @planting
          - if can? :create, Comment
            = render "comments/inline_form", commentable: @planting

    .col-md-4.col-12
      %section.planting-crop
        .section-header
          %h2= t('plantings.show.crop')
        = render 'plantings/crop', crop: @planting.crop

      - if @planting.location && @neighbours.any?
        %section.neighbours
          .section-header
            %h2= t('plantings.show.neighbours')
          %p.text-muted.small.planting-neighbours-lead
            = t('plantings.show.neighbours_explanation', crop: @planting.crop.name)
          .planting-neighbours
            - @neighbours.each do |neighbour|
              = render 'plantings/neighbour', neighbour: neighbour

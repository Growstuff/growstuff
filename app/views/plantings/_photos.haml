.section-header
  %h2= t('plantings.show.photos')
  - if can?(:edit, planting) && can?(:create, Photo)
    = link_to new_photo_path(id: planting.id, type: 'planting'), class: 'btn btn-sm section-add', data: { planting_dialog: 'photo' } do
      = icon 'fas', 'plus'
      add
- if planting.photos.size.positive?
  = render 'photos/gallery', photos: photos
  -# Only worth offering when the page isn't already showing them all.
  - if planting.photos.size > photos.size
    %p.text-end.mb-0
      = link_to t('plantings.show.more_photos'), planting_photos_path(planting)
- else
  %p.text-muted= t('plantings.show.no_photos')
  - if can?(:edit, planting) && can?(:create, Photo)
    %p= t('plantings.show.no_photos_prompt')

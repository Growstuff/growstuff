.section-header
  %h2= t('plantings.show.photos')
  - if can?(:edit, planting) && can?(:create, Photo)
    = link_to new_photo_path(id: planting.id, type: 'planting'), class: 'btn btn-sm section-add' do
      = icon 'fas', 'plus'
      add
- if planting.photos.size.positive?
  = render 'photos/gallery', photos: photos
  %p.text-end.mb-0
    = link_to planting_photos_path(planting), class: 'btn btn-sm section-add' do
      = t('plantings.show.more_photos')
- else
  %p.text-muted= t('plantings.show.no_photos')
  - if can?(:edit, planting) && can?(:create, Photo)
    %p= t('plantings.show.no_photos_prompt')

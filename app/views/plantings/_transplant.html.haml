-# Transplanting is rare, so it lives in the actions menu rather than taking up
-# room in the sidebar. The dialog is hidden until that menu item opens it.
- if can?(:transplant, planting) && planting.active && transplantable_gardens_by_owner(planting).any?
  #transplant-modal.modal.fade{ "aria-hidden" => "true", "aria-labelledby" => "transplant-modal-title", role: "dialog", tabindex: "-1" }
    .modal-dialog{ role: "document" }
      .modal-content
        = form_tag transplant_planting_path(planting), method: :post do
          .modal-header
            %h4#transplant-modal-title.modal-title= t('.title', crop: planting.display_name)
            %button.btn-close{ "aria-label" => t('.close'), "data-bs-dismiss" => "modal", type: "button" }
          -# Same body class as the React dialogs, so it reads at the same size.
          .modal-body.plant-dialog-body
            - if planting.quantity.to_i > 1
              = label_tag :quantity, t('plantings.transplant.quantity'), class: 'form-label'
              = number_field_tag :quantity, planting.quantity, min: 1, max: planting.quantity, required: true, class: 'form-control'
            = label_tag :garden_id, t('.move_to'), class: 'form-label'
            = select_tag :garden_id, options_from_collection_for_select(transplantable_gardens_by_owner(planting), :id, :name), class: 'form-select'
          .modal-footer
            %button.btn.btn-secondary{ "data-bs-dismiss" => "modal", type: "button" }= t('.cancel')
            = submit_tag t('.submit'), class: 'btn btn-primary'

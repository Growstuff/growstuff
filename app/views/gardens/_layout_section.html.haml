-# The bed map, in its own section: it leads to the layout page.
- if @garden.active
  -# Its own page, so a section that leads there: the current bed map, or a teaser to create one.
  - layout_path = layout_member_garden_path(@garden.owner, @garden)
  - can_arrange = can?(:update_layout, @garden)
  - placed_plants = @garden.placed_plants.pluck(:bed_x, :bed_y, :diameter)
  %section.garden-layout-section
    .section-header
      %h2 Layout
      = link_to layout_path, class: 'btn btn-sm section-add',
        'aria-label': (can_arrange ? 'Edit the bed layout' : 'View the bed layout') do
        = can_arrange ? 'edit layout' : 'view layout'
    .garden-layout-body
      = link_to layout_path, class: 'garden-layout-map', tabindex: -1, 'aria-hidden': 'true' do
        %span.garden-layout-teaser-bed
          - if @garden.has_layout?
            %svg{ viewBox: "0 0 #{@garden.grid_columns} #{@garden.grid_rows}", class: 'garden-layout-teaser-svg' }
              - if @garden.layout_features.present?
                - @garden.layout_features.each do |feature|
                  - if feature['x2'].present? && feature['y2'].present?
                    %line{ x1: feature['x'], y1: feature['y'], x2: feature['x2'], y2: feature['y2'], class: "feature-line #{feature['kind']}" }
                  - else
                    %circle{ cx: feature['x'], cy: feature['y'], r: 0.3, class: "feature-point #{feature['kind']}" }
              - placed_plants.each do |x, y, diameter|
                %circle{ cx: x, cy: y, r: (diameter || 1) / 2.0, class: 'placed-plant' }
          - else
            %span
            %span
            %span
            %span
      .garden-layout-text
        - if @garden.has_layout?
          %p.garden-layout-headline= pluralize(placed_plants.size, 'plant') + ' placed on the bed'
          %p.text-muted
            - if can_arrange
              Drag plants around the map to see what fits where.
            - else
              Where each plant in this garden is growing, on a map of the bed.
        - elsif can_arrange
          %p.garden-layout-headline
            %span.badge.text-bg-success New
            Map out this bed
          %p.text-muted Drag your plants onto a picture of the bed, and see what fits where.
        - else
          %p.garden-layout-headline See how this bed is laid out
          %p.text-muted Where each plant in this garden is growing, on a map of the bed.

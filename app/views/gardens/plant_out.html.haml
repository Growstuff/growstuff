- content_for :title, 'Plant out seedlings'

- content_for :breadcrumbs do
  %li.breadcrumb-item= link_to 'Gardens', gardens_path
  %li.breadcrumb-item= link_to 'Nursery', nursery_path
  %li.breadcrumb-item.active Plant out

%h1 Plant out seedlings
%p.lead Move seedlings from the nursery into a garden. They keep the date they were sown.

- if @batches.empty?
  %p There are no seedlings in the nursery to plant out.
  = link_to 'Back to my gardens', member_gardens_path(current_member), class: 'btn btn-outline-secondary'
- elsif @gardens.empty?
  %p You need a garden to plant them into.
  = link_to 'Add a garden', new_garden_path, class: 'btn btn-primary'
- else
  = form_tag plant_out_nursery_path, method: :post do
    .card.mb-3
      .card-body
        .row
          .col-md-6
            %fieldset
              %legend.h6 Into which garden?
              - @gardens.each do |garden|
                .form-check
                  = radio_button_tag :garden_slug, garden.slug, params[:garden_slug] == garden.slug,
                                     class: 'form-check-input'
                  = label_tag "garden_slug_#{garden.slug}", garden.name, class: 'form-check-label'
              = link_to 'A new garden', new_garden_path, class: 'd-inline-block mt-2'
          .col-md-6
            %fieldset
              %legend.h6 When did you plant them out?
              - [['today', 'Today'], ['yesterday', 'Yesterday'], ['other', 'Pick a date']].each do |value, label|
                .form-check
                  = radio_button_tag :when, value, (params[:when] || 'today') == value, class: 'form-check-input'
                  = label_tag "when_#{value}", label, class: 'form-check-label'
              = date_field_tag :date, params[:date], class: 'form-control mt-2 w-auto', 'aria-label': 'Date planted out'
    .card.mb-3
      .card-body
        %h2.h6 How many of each?
        - @batches.each do |batch|
          .row.align-items-center.py-2.border-top
            .col-md-5
              %strong= batch.display_name
              %br
              - if batch.planted_at
                %small.text-muted Sown #{l(batch.planted_at, format: '%a %-d %b')}
            .col-md-3
              %small.text-muted #{batch.quantity || 1} in the nursery
            .col-md-4
              = label_tag "quantities_#{batch.id}", "How many #{batch.display_name}", class: 'visually-hidden'
              = number_field_tag "quantities[#{batch.id}]", params.dig(:quantities, batch.id.to_s) || batch.quantity || 1,
                                 min: 0, max: batch.quantity || 1, class: 'form-control w-auto d-inline-block'
              %small.text-muted of #{batch.quantity || 1}
        %p.form-text.mt-2 Planting out some of a batch leaves the rest in the nursery. Set a batch to 0 to leave it.
    = submit_tag 'Plant out', class: 'btn btn-primary'
    = link_to 'Cancel', member_gardens_path(current_member), class: 'btn btn-link'

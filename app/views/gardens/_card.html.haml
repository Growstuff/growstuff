.card
  .card-header
    .row
      .col-12.col-md-3
        %h2= link_to garden.name, garden, name: "garden-#{garden.id}"
        = link_to layout_member_garden_path(garden.owner, garden),
                  class: 'btn btn-outline-success btn-sm garden-card-layout-button' do
          %i.fa.fa-th-large{ 'aria-hidden': 'true' }
          = t('.layout')
          %span.visually-hidden
            = t('.of')
            = garden.name
    .row
      .col-md-3
        - if @owner.blank?
          = t('.owner')
          = render 'members/tiny', member: garden.owner


        = image_tag garden_image_path(garden), alt: garden.name, class: 'img-card'

      .col-md-9
        %section
          = render 'gardens/actions', garden: garden

        - active_plantings = garden.plantings.active

        %section
          - if active_plantings.perennial.any?
            %strong= t('.perennials')
            - active_plantings.perennial.limit(10).each do |planting|
              = link_to planting do
                = crop_icon planting.crop
                = planting.crop
          - else
            %p= t('.no_perennials')

        %hr

        %section
          - if active_plantings.annual.any?
            = render 'plantings/progress_list', plantings: active_plantings.annual.limit(5)
          - else
            %p= t('.no_annuals')

- crops = garden.plantings.map(&:crop).uniq
- shown = 8
.card.h-100.inactive-garden-card
  = link_to garden_path(garden) do
    = image_tag garden_image_path(garden), alt: t('.image_alt', name: garden.name), class: 'card-img-top'
  .card-body
    %h2.h5.card-title= link_to garden.name, garden_path(garden)
    %p.inactive-garden-meta= garden_history_summary(garden)
    - if garden.description.present?
      %p.card-text= truncate(garden.description, length: 130, separator: ' ', omission: '...')
    - if crops.any?
      %ul.inactive-garden-crops.list-unstyled{'aria-label': t('.grown_here')}
        - crops.first(shown).each do |crop|
          %li
            = link_to crop_path(crop) do
              .chip.crop-chip
                = crop_icon(crop)
                = crop.name
        - if crops.size > shown
          %li.inactive-garden-more= t('.more_crops', count: crops.size - shown)
  - if can?(:edit, garden)
    .card-footer
      = garden_mark_active_button(garden, classes: 'btn btn-sm btn-outline-success')

- garden_title = "#{@garden.owner}'s #{@garden}"
= render 'shared/record_meta',
         title: garden_title,
         description: @garden.description.presence || "#{garden_title}, on Growstuff.",
         image: garden_image_path(@garden)

- content_for :breadcrumbs do
  %li.breadcrumb-item= link_to 'Gardens', gardens_path
  %li.breadcrumb-item.active= link_to @garden.name, garden_path(@garden)

.garden-show.record-page
  .row
    .col-md-8.col-12
      -# Everything that is this garden, inside one border. See DESIGN.md.
      .record-panel.garden-detail
        -# The garden's photo leads the panel, when it has one.
        - if @garden.photos.any?
          = link_to garden_photos_path(@garden), class: 'garden-hero', 'aria-label': "Photos of #{@garden.name}" do
            = image_tag garden_image_path(@garden), alt: ''
            %span.garden-hero-caption= "Photo of the garden · #{pluralize(@garden.photos.size, 'photo')}"
        .jumbotron
          .d-flex.justify-content-between.align-items-start
            .record-identity
              = render 'shared/record_owner', owner: @garden.owner
              .record-identity-text
                .garden-edit-row
                  %h1.garden-title
                    = garden_icon
                    = @garden.name
                  = editable :text_field, @garden, :name, display_field: '.garden-title'
                - if @garden.nursery?
                  %p.mb-1
                    %span.badge.text-bg-success Nursery
                    %small.text-muted Seedlings raised here can be transplanted into your gardens.
                %p.garden-grower
                  garden of
                  %strong.record-grower-name= link_to @garden.owner, @garden.owner
                - details = [(link_to(@garden.location, place_path(@garden.location)) if @garden.location.present?), @garden.garden_type&.name,
                             (pluralize(number_with_precision(@garden.area, precision: 2, strip_insignificant_zeros: true), @garden.area_unit) if @garden.area.present?),
                             garden_distance(@garden)].compact
                - if details.any?
                  %p.garden-meta.text-muted= safe_join(details, ' · ')
                %p.garden-owner-link= link_to "All of #{@garden.owner}'s gardens", member_gardens_path(@garden.owner)
            .garden-hero-actions
              .record-grower-follow
                = render 'members/follow_button', person: @garden.owner
              = render 'gardens/actions', garden: @garden
        - unless @garden.active
          .alert.alert-warning
            This garden is inactive.
            - if can? :edit, @garden
              = link_to 'Set it to active', edit_garden_path(@garden)
              to plant something in this garden.
        - if @suggestion_count&.positive?
          .mb-3
            = render 'jobs/ideas_banner', href: suggestions_path, open: false,
              text: t('.suggested_plantings', count: @suggestion_count), go: t('.suggested_plantings_go')
        = render 'gardens/facts', garden: @garden, growing_now: @current_plantings.size

        .garden-description-block
          .garden-edit-row
            .garden-description
              - if @garden.description.present?
                :markdown
                  #{strip_tags markdownify(@garden.description)}
              - else
                %p.text-muted No description available yet.
            = editable :text_area, @garden, :description, display_field: '.garden-description'

        - if @garden.active
          -# Its own page, so a section that leads there: the current bed map, or a teaser to create one.
          - layout_path = layout_member_garden_path(@garden.owner, @garden)
          - can_arrange = can?(:update_layout, @garden)
          - placed_plants = @garden.placed_plants.pluck(:bed_x, :bed_y, :diameter)
          %section.garden-layout-section
            .section-header
              %h2 Layout
              = link_to layout_path, class: 'btn btn-sm section-add',
                'aria-label': (can_arrange ? 'Edit the bed layout' : 'View the bed layout') do
                = can_arrange ? 'edit layout' : 'view layout'
            .garden-layout-body
              = link_to layout_path, class: 'garden-layout-map', tabindex: -1, 'aria-hidden': 'true' do
                %span.garden-layout-teaser-bed
                  - if @garden.has_layout?
                    %svg{ viewBox: "0 0 #{@garden.grid_columns} #{@garden.grid_rows}", class: 'garden-layout-teaser-svg' }
                      - if @garden.layout_features.present?
                        - @garden.layout_features.each do |feature|
                          - if feature['x2'].present? && feature['y2'].present?
                            %line{ x1: feature['x'], y1: feature['y'], x2: feature['x2'], y2: feature['y2'], class: "feature-line #{feature['kind']}" }
                          - else
                            %circle{ cx: feature['x'], cy: feature['y'], r: 0.3, class: "feature-point #{feature['kind']}" }
                      - placed_plants.each do |x, y, diameter|
                        %circle{ cx: x, cy: y, r: (diameter || 1) / 2.0, class: 'placed-plant' }
                  - else
                    %span
                    %span
                    %span
                    %span
              .garden-layout-text
                - if @garden.has_layout?
                  %p.garden-layout-headline= pluralize(placed_plants.size, 'plant') + ' placed on the bed'
                  %p.text-muted
                    - if can_arrange
                      Drag plants around the map to see what fits where.
                    - else
                      Where each plant in this garden is growing, on a map of the bed.
                - elsif can_arrange
                  %p.garden-layout-headline
                    %span.badge.text-bg-success New
                    Map out this bed
                  %p.text-muted Drag your plants onto a picture of the bed, and see what fits where.
                - else
                  %p.garden-layout-headline See how this bed is laid out
                  %p.text-muted Where each plant in this garden is growing, on a map of the bed.

        %section.garden-plantings
          .section-header
            %h2 Growing now
            - if can?(:edit, @garden)
              -# The plant something dialog, a React island. The link is what shows without scripts.
              = react_component 'GardenPlanter', { garden: { id: @garden.id, name: @garden.name }, buttonClass: 'btn btn-sm section-add',
                                                   iconUrl: image_path('icons/planting.svg') } do
                = link_to new_planting_path(garden_id: @garden.id), class: 'btn btn-sm section-add' do
                  = icon 'fas', 'plus'
                  add
          .index-cards
            - if @current_plantings.size.positive?
              - @current_plantings.each do |planting|
                = render "plantings/card", planting: planting
            - else
              .col-md-12
                %p Nothing is currently planted here.

        - if @notepad
          -# Not a section: the notepad is its own bordered block, with its own green bar.
          .garden-notepad
            = render 'jobs/notepad', owner: current_member, garden: @garden, groups: @notepad.groups, done_this_week: @notepad.done_this_week,
              autofocus: false
        - else
          %section
            .section-header
              %h2 Current jobs in garden
              %span.badge.text-bg-light.garden-jobs-public{ title: t('jobs.pad.public_note') } Public
            .index-cards
              - if @current_jobs&.size&.positive?
                - @current_jobs.each do |job|
                  = render "jobs/card", job: job
              - else
                .col-md-12
                  %p Nothing is currently planned here.

        - if @photos.present? || can?(:edit, @garden)
          %section.photos.garden-photos
            .section-header
              %h2 Photos
              - if can?(:edit, @garden) && can?(:create, Photo)
                = link_to new_photo_path_for(@garden), class: 'btn btn-sm section-add', data: photo_dialog_data(@garden) do
                  = icon 'fas', 'plus'
                  add
            - if @photos.present?
              .index-cards
                - @photos.each do |photo|
                  = render 'photos/thumbnail', photo: photo
              - if @garden.photos.size > @photos.size
                .garden-more-photos= link_to 'More photos', garden_photos_path(@garden)
            - else
              %p No photos yet.

        - if @suggested_companions.any?
          %section.companions
            %h2 Suggestioned companions
            - @suggested_companions.each do |companion|
              = render 'crops/tiny', crop: companion

        %section.garden-previously= render 'previously'

    .col-md-4.col-12
      %section.garden-about
        .section-header
          %h2 About this garden
        .garden-side-body
          .garden-person
            = image_tag avatar_uri(@garden.owner, 88), alt: '', class: 'garden-person-avatar', width: 44, height: 44
            %div
              %small.text-muted.d-block Owner
              %strong= link_to @garden.owner, @garden.owner
              - if @garden.owner == current_member
                %span.text-muted (you)
          .garden-collaborators
            .garden-side-row
              %strong Collaborators
              - if can?(:create, GardenCollaborator.new(garden: @garden))
                = link_to "Manage", garden_garden_collaborators_path(@garden)
              - elsif current_member.present? && (collab = @garden.garden_collaborators.find_by(member: current_member))
                = link_to "Leave garden", garden_garden_collaborator_path(@garden, collab), method: :delete, class: 'text-danger', data: { confirm: 'Are you sure you want to leave this garden?' }
            - if @garden.garden_collaborators.any?
              - @garden.garden_collaborators.includes(:member).find_each do |collaborator|
                .garden-person.garden-person-small
                  = image_tag avatar_uri(collaborator.member, 48), alt: '', class: 'garden-person-avatar', width: 24, height: 24
                  = link_to collaborator.member, collaborator.member
            - else
              %p.text-muted.mb-0 None
          - if @garden.location.present?
            %div
              %strong Location
              %br
              = @garden.location
              - if garden_distance(@garden)
                %br
                %small.text-muted= garden_distance(@garden)
          - if @garden.location_wikidata_id.present?
            %p.garden-temperatures.text-muted
              Local temperatures from
              = succeed ':' do
                = link_to "Wikidata", "https://www.wikidata.org/wiki/#{@garden.location_wikidata_id}", target: '_blank', rel: 'noopener noreferrer'
              hottest
              = succeed ',' do
                = @garden.highest_temp_c.present? ? "#{@garden.highest_temp_c.round(1)}°C" : 'not known'
              coldest
              = @garden.lowest_temp_c.present? ? "#{@garden.lowest_temp_c.round(1)}°C" : 'not known'
          - elsif can?(:edit, @garden) && @garden.location.present?
            .alert.alert-info.mb-0
              %p Wikidata information is missing for this location.
              = button_to "Fetch Wikidata info", fetch_wikidata_garden_path(@garden), method: :post, class: 'btn btn-info btn-sm'

      - owner_gardens = @garden.owner.gardens.active.order_by_name.to_a
      - growing_counts = Planting.current.where(garden_id: owner_gardens.map(&:id)).group(:garden_id).count
      - inactive_count = @garden.owner.gardens.inactive.count
      %section.garden-gardens
        .section-header
          %h2 #{@garden.owner}'s gardens
        %ul.garden-list
          - owner_gardens.each do |garden|
            %li
              - if @garden == garden
                %strong= garden
              - else
                = link_to garden, garden_path(garden)
              %span.text-muted= garden.nursery? ? 'nursery' : "#{growing_counts.fetch(garden.id, 0)} growing"
        - if inactive_count.positive? || @garden.owner == current_member
          .garden-list-footer
            - if inactive_count.positive?
              = link_to pluralize(inactive_count, 'inactive garden'), member_inactive_gardens_path(@garden.owner)
            - if @garden.owner == current_member
              = link_to new_garden_path, class: 'btn btn-outline-secondary btn-sm' do
                + New garden

-# The to-do list's menu opens the add-photo dialog over the page, and the plantings'
-# add opens the plant dialog: both React islands.
-# Last, so it can see whether something above has asked for it already.
- if (@notepad || can?(:edit, @garden)) && !content_for(:scripts).to_s.include?('react_islands')
  - content_for :scripts do
    = javascript_include_tag 'react_islands', defer: true

- content_for :title, t('.title', owner: @owner)

- content_for :breadcrumbs do
  %li.breadcrumb-item= link_to 'Gardens', gardens_path
  %li.breadcrumb-item= link_to t('.owner_gardens', owner: @owner), member_gardens_path(@owner)
  %li.breadcrumb-item.active= link_to t('.inactive_gardens'), member_inactive_gardens_path(@owner)

%h1= t('.title', owner: @owner)

.row
  .col-md-2
    %small.d-block.sidebar-inset
      %a{href: "#content"}= t('.skip_to_content')
    = render 'layouts/nav', model: Garden
    %hr/
    = render @owner
    .inactive-gardens-link.sidebar-inset.mt-3
      = link_to t('.current_gardens'), member_gardens_path(@owner)

  .col-md-10#content
    - if @gardens.empty?
      %p
        = t('.empty_body')
        - if @owner == current_member
          = t('.empty_owner_hint')
    - else
      %p.lead= t('.lead')
      %p.text-muted
        = t('.explanation')
        - if @owner == current_member
          = t('.owner_reactivate_hint')
      .row.row-cols-1.row-cols-sm-2.row-cols-lg-3.g-4
        - @gardens.each do |garden|
          .col= render 'gardens/inactive_card', garden: garden
      .mt-3= will_paginate @gardens

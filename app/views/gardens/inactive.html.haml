- content_for :title, "#{@owner}'s inactive gardens"

- content_for :breadcrumbs do
  %li.breadcrumb-item= link_to 'Gardens', gardens_path
  %li.breadcrumb-item= link_to "#{@owner}'s gardens", member_gardens_path(@owner)
  %li.breadcrumb-item.active= link_to 'Inactive gardens', member_inactive_gardens_path(@owner)

%h1 #{@owner}'s inactive gardens

.row
  .col-md-2
    %small.d-block.sidebar-inset
      %a{href: "#content"}
        Skip to main content
    = render 'layouts/nav', model: Garden
    %hr/
    = render @owner
    .inactive-gardens-link.sidebar-inset.mt-3
      = link_to "Current gardens", member_gardens_path(@owner)

  .col-md-10#content
    - if @gardens.empty?
      %p
        There are no inactive gardens to show.
        - if @owner == current_member
          A garden you mark as inactive will appear here.
    - else
      %p.lead Gardens that are no longer in use, and what was grown in them.
      %p.text-muted
        A garden becomes inactive when it is marked as inactive, and its plantings are marked as finished.
        They stay here as a record of what was grown.
        - if @owner == current_member
          You can mark a garden as active again to go back to editing it.
      .row.row-cols-1.row-cols-sm-2.row-cols-lg-3.g-4
        - @gardens.each do |garden|
          .col= render 'gardens/inactive_card', garden: garden
      .mt-3= will_paginate @gardens

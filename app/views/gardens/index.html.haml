- title = @owner ? "#{@owner}'s gardens" : "Everyone's gardens"
- content_for :title, title

- content_for :scripts do
  = javascript_include_tag 'react_islands', defer: true

- content_for :breadcrumbs do
  - if @owner
    %li.breadcrumb-item= link_to 'Gardens', gardens_path
    %li.breadcrumb-item.active= link_to "#{@owner}'s gardens", member_gardens_path(@owner)
  - else
    %li.breadcrumb-item.active= link_to 'Gardens', gardens_path

.gardens-page
  .gardens-page-header
    %div
      %h1= title
      - if @owner && !@own_gardens
        %p.gardens-page-owner
          - if @owner.location.present?
            = link_to @owner.location, place_path(@owner.location)
            &middot;
          = link_to 'Profile', @owner
      - if @owner && @nursery.nil? && (!@own_gardens || @owner.nursery_declined?)
        %p.gardens-page-owner
          #{@owner} has no seedling raising nursery.
          - if @own_gardens
            = link_to 'Change this', nursery_path
    .gardens-page-actions
      - if @own_gardens
        = react_component 'GardenPicker', { label: 'Add a garden', buttonClass: 'btn btn-success' }
      - elsif @owner
        = render 'members/follow_buttons', member: @owner

  - if @nursery || (@own_gardens && !@owner.nursery_declined?)
    = render 'gardens/nursery_panel', owner: @owner, nursery: @nursery

  %section.gardens-section
    .gardens-section-header
      %h2 Gardens
      %small= pagination_info @pagy, "gardens"
    - if @gardens.empty?
      .gardens-section-body
        %p There are no gardens to display.
        - if can?(:create, Garden) && @own_gardens
          = link_to 'Add a garden', new_garden_path, class: 'btn btn-primary'
    - else
      = react_component 'GardenCards', garden_cards_props(@gardens, owner: @owner)
      %noscript
        %p The garden cards need JavaScript to display.
      .gardens-section-body
        = pagination_nav @pagy
        - if @owner.present?
          = link_to 'Inactive gardens', member_inactive_gardens_path(@owner)
          %small.text-muted Gardens no longer in use, kept as a record of what was grown.

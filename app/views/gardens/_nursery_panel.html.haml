-# The member's nursery, above their gardens: where seedlings are raised before
-# they're planted out. A member who hasn't chosen one yet is asked about it.
:ruby
  seedlings = nursery_seedlings(nursery)
  sown_groups = nursery_sown_groups(seedlings)
  planned = nursery_planned(seedlings)
.card.nursery-panel
  .nursery-panel-header
    %div
      %h2.nursery-panel-title
        = garden_icon
        = nursery ? link_to(nursery.name, nursery) : 'Nursery'
      - if nursery
        %p.nursery-panel-subtitle
          #{nursery_seedling_count(seedlings)} &middot; raised here before they go into a garden
    - if nursery && can?(:edit, nursery)
      = react_component 'NurseryPlanter', nursery_planter_props(nursery)
  .nursery-panel-body
    - if nursery.nil?
      = render 'gardens/what_is_a_nursery'
      = link_to 'Set up a nursery', nursery_path, class: 'btn btn-primary'
    - elsif seedlings.empty?
      %p.text-muted.mb-0 Sow some seeds and they'll show up here, ready to plant out.
    - else
      - sown_groups.each do |(day, got), group|
        %section.nursery-day
          .nursery-day-head
            %b.nursery-day-heading= nursery_day_title(day)
            %small= nursery_day_subtitle(day, got)
            - photos = group.filter_map { |seedling| seedling.photos.first }.first(3)
            - if photos.any?
              .nursery-day-photos
                - photos.each do |photo|
                  = image_tag thumbnail_url(photo), alt: 'Photo of a seed tray'
          %ul.nursery-seedlings
            - group.each do |seedling|
              %li
                = render 'plantings/tiny', planting: seedling
                - if seedling.quantity.present?
                  %small.nursery-seedling-details &times; #{seedling.quantity}
      - if sown_groups.any? && can?(:edit, nursery)
        = link_to 'Plant out seedlings', plant_out_nursery_path, class: 'btn btn-outline-success mt-3'
      - if planned.any?
        %section.nursery-day.nursery-planned
          .nursery-day-head
            %b.nursery-day-heading To sow
            %small planned
          %ul.nursery-seedlings
            - planned.each do |seedling|
              %li
                = render 'plantings/tiny', planting: seedling
                %small.nursery-seedling-details= l(seedling.planted_at, format: '%a %-d %b')

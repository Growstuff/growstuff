-# What came before in this garden: finished plantings under their year, then
-# finished jobs. Each part is only here when there is something for it.
- dated, undated = @finished_plantings.partition(&:planted_at)
- if @finished_plantings.any?
  %h2= t('.previously_planted')

  - dated.sort_by(&:planted_at).reverse.group_by { |planting| planting.planted_at.year }.each do |year, plantings|
    %h4= year
    - plantings.each do |planting|
      = render 'plantings/tiny', planting:

  - if undated.any?
    %h4= t('.unknown_year')
    - undated.each do |planting|
      = render 'plantings/tiny', planting:

- if @finished_jobs&.size&.positive?
  %h2{ class: ('mt-4' if @finished_plantings.any?) }= t('.finished_jobs')
  .index-cards
    - @finished_jobs.each do |job|
      = render 'jobs/card', job: job

-# The garden's jobs: the member's own notepad, or the public list for everyone else.
- if @notepad
  -# Not a section: the notepad is its own bordered block, with its own green bar.
  .garden-notepad
    = render 'jobs/notepad', owner: current_member, garden: @garden, groups: @notepad.groups, done_this_week: @notepad.done_this_week,
      autofocus: false
- else
  -# Public, and only to look at.
  .garden-notepad
    .notepad
      .notepad-title
        %h2= t('jobs.pad.garden_title', garden: @garden.name)
        %span.badge.text-bg-light.garden-jobs-public{ title: t('jobs.pad.public_note') }= t('.public')
      = render 'jobs/notepad_groups', groups: @public_jobs&.groups || [], in_garden: true, readonly: true

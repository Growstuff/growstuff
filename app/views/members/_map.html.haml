- if member.latitude && member.longitude
  #membermap.member-map{ data: { marker_icon: image_path('spade-marker.svg') } }
  %p.text-end
    = t('.see_nearby_html', location: link_to(member.location, place_path(member.location, anchor: "members")))
- else
  .location-not-set
    %h1= t('.not_known')
    %p= t('.cant_show_nearby')

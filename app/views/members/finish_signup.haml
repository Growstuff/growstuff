- site_name = ENV.fetch('GROWSTUFF_SITE_NAME', nil)
- content_for :title, "Join #{site_name}"
- email_missing = current_member.email.blank?

= render 'devise/shared/card', title: "Welcome to #{site_name}", links: false do
  %p Nearly there. Choose the name that will show on the website.

  = bootstrap_form_for(current_member, as: 'member', url: finish_signup_path(current_member), html: { data: { turbo: false } }) do |f|
    - if @show_errors
      = render 'devise/shared/error_messages', resource: current_member

    = f.text_field :login_name, autofocus: true, help: 'This is the name that will show on the website. You can change it later.'

    - if email_missing
      = f.email_field :email, label: 'Email (optional)', placeholder: 'you@example.com',
                              help: "Add one if you'd like planting reminders. We'll send a link to confirm it, and we never spam."
    - else
      = f.email_field :email, help: "We'll use this address to contact you (we never spam!)"

    - unless current_member.tos_agreement
      = f.check_box :tos_agreement, label: safe_join(['I agree to the ', link_to('Terms of Service', '/policy/tos')])

    = f.submit 'Continue', class: 'btn w-100 btn-success'

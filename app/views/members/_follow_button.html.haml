-# Follow, or Following, for a member. With named, the member's name is in the
-# words, as on their garden's page; button_class styles the Follow button.
- named = local_assigns[:named]
- if current_member && current_member != person
  - if current_member.already_following?(person)
    %span.member-card-follow.on= named ? t('members.follow_button.following_named', name: person) : t('members.follow_button.following')
  - elsif can?(:create, Follow)
    - label = named ? t('members.follow_button.follow_named', name: person) : t('members.follow_button.follow')
    = button_to label, follows_path(followed: person), class: local_assigns.fetch(:button_class, 'member-card-follow'), form_class: 'd-inline'

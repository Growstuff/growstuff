- if @location
  - content_for :title, t('.title_near', location: @location)
- else content_for :title, t('.title_find')

%p
  = form_tag(nearby_members_path, method: :get, class: 'd-flex flex-wrap align-items-center gap-2') do
    = label_tag :distance, t('.find_within'), class: 'form-label'
    = text_field_tag :distance, @distance, class: 'input-mini'
    = select_tag :units, options_for_select({ t('.miles') => :mi, t('.km') => :km }, @units), class: 'input-small'
    = label_tag :location, t('.of'), class: 'form-label'
    = text_field_tag :location, @location
    = submit_tag t('.search'), class: 'btn btn-primary'

- if can? :update, current_member
  %p
    = link_to t('.edit_location'), edit_member_registration_path(current_member)

- if !@nearby_members.empty?
  %h3= t('.results_found')
  .index-cards
    - @nearby_members.each do |member|
      = render partial: "members/thumbnail", locals: { member: member }
- elsif @location
  %h3= t('.no_results')

= content_for :title, t(".title", site_name: ENV['GROWSTUFF_SITE_NAME'])

%h1
  = member_icon
  = t(".title", site_name: ENV['GROWSTUFF_SITE_NAME'])
= bootstrap_form_tag(url: members_path, method: :get, layout: :inline) do |f|
  = f.select "sort",
        options_for_select({ t('.sort_alphabetically') => 'alpha', t('.sort_recently_joined') => "recently_joined" },
                                      @sort || 'alpha'),
        label: t('.sort_by')
  = f.submit t('.show')

.pagination
  = page_entries_info @members
  = will_paginate @members

.member-cards= render partial: 'members/card', collection: @members, as: :person

.pagination
  = page_entries_info @members
  = will_paginate @members

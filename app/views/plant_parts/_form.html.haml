= form_for @plant_part do |f|
  - if @plant_part.errors.any?
    #error_explanation
      %h2= t('.errors', count: @plant_part.errors.size)
      %ul
        - @plant_part.errors.full_messages.each do |msg|
          %li= msg

  .field
    = f.label :name, t('.name')
    = f.text_field :name
  .actions
    = f.submit t('.save')

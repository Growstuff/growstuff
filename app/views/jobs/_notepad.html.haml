-# A member's own jobs as a notepad: grouped by when, with what each is about.
.notepad
  .notepad-title
    %h1= t('jobs.pad.title', owner: owner.login_name)
  .notepad-tabs{ role: 'group', 'aria-label': t('jobs.pad.title', owner: owner.login_name) }
    = link_to t('jobs.pad.to_do'), member_jobs_path(owner), class: ['notepad-tab', ('active' unless done)], 'aria-current': (done ? nil : 'page')
    = link_to t('jobs.pad.done'), member_jobs_path(owner, tab: 'done'), class: ['notepad-tab', ('active' if done)], 'aria-current': (done ? 'page' : nil)
  %p.notepad-note= t('jobs.pad.public_note')

  - if done
    - if jobs.empty?
      %p.notepad-empty= t('jobs.pad.empty_done')
    - else
      .notepad-group
        - jobs.each do |job|
          = render 'jobs/notepad_row', job:
  - elsif groups.empty?
    %p.notepad-empty= t('jobs.pad.empty')
  - else
    - groups.each do |group|
      .notepad-group
        .notepad-heading
          %h2= t("jobs.pad.#{group.key}")
          - if group.from
            %small= "#{l(group.from, format: '%a %-d')} & #{l(group.to, format: '%a %-d %b')}"
          - elsif group.key == :someday
            %small= t('jobs.pad.someday_note')
        - group.jobs.each do |job|
          = render 'jobs/notepad_row', job:

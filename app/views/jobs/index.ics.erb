<%
# TODO Refactor to a Job <-> Ical view class?
cal = Icalendar::Calendar.new
cal.description = t('jobs.index.ics_description', owner: @owner.login_name)
@jobs.each do |job|

  event = Icalendar::Event.new

  lines = []
  lines << t('jobs.index.ics_garden', garden: job.garden_name || t('jobs.index.not_applicable'))
  lines << t('jobs.index.ics_planting', planting: job.planting_name || t('jobs.index.not_applicable'))

  lines << job.description
  finish_date = job.due_date

  event.dtstart     = job.created_at
  event.dtend       = finish_date || 1.day.from_now
  event.summary     = job.name
  event.description = lines.join("\n")
  event.ip_class    = "PUBLIC"

  cal.add_event(event)

  if finish_date && finish_date > Time.zone.today
    todo = Icalendar::Todo.new
    todo.dtstart = finish_date
    todo.due = finish_date
    todo.summary     = job.name
    todo.description = lines.join("\n")

    cal.add_todo(todo)
  end
end
cal.publish
%>
<%= cal.to_ical %>

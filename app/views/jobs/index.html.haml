- content_for :title, title('jobs', @owner, nil, nil)

-# The add-photo dialog, which the notepad's menu opens over the page, is a React island.
- if @job_groups
  - content_for :scripts do
    = javascript_include_tag 'react_islands', defer: true

- content_for :breadcrumbs do
  - if @owner
    %li.breadcrumb-item= link_to t('.breadcrumbs_jobs'), jobs_path
    %li.breadcrumb-item.active= link_to t('.owner_jobs', owner: @owner), member_jobs_path(@owner)
  - else
    %li.breadcrumb-item.active= link_to t('.breadcrumbs_jobs'), jobs_path

- if @owner && @owner == current_member && Feature.enabled?(:job_ideas)
  - ideas_count = JobIdeas.count_for(@owner)
  - if ideas_count.positive?
    .mb-3
      = render 'jobs/ideas_banner', count: ideas_count
    = render 'jobs/ideas_modal'

.row
  -# A member's own jobs are a notepad across the page. Anyone else's, or everyone's,
  -# are a list, with its options beside it.
  - if @job_groups
    .col-12
      = render 'jobs/notepad', owner: @owner, groups: @job_groups, done_this_week: @done_this_week, ideas_banner: false
  - else
    .col-md-3
      %h1.h2
        = job_icon
        = t('.sidebar_heading')
      = link_to show_inactive_tickbox_path('jobs', owner: @owner, crop: nil, show_all: @show_all) do
        = check_box_tag 'active', 'all', @show_all
        = t('.include_finished_jobs')
      - if @owner.present? && @owner != current_member
        %hr
        = render @owner, cached: true

      %section.open-data.mt-3
        %h2= t('.open_data')
        %p= t('label.data')
        - ['csv', 'json', 'rss'].each do |format|
          .badge.text-bg-info
            = link_to (@owner ? member_jobs_path(@owner, format: format) : jobs_path(format: format)) do
              = icon 'fas', format.to_s
              = format.upcase
        - if @owner
          .badge.text-bg-info= link_to "iCal", member_jobs_path(@owner, format: 'ics', protocol: 'webcal', only_path: false)
        .badge.text-bg-success= link_to t('.api_methods'), '/api-docs'

    .col-md-9
      %section
        %h2= title('jobs', @owner, nil, nil)
        = will_paginate @jobs
        .index-cards
          - @jobs.each do |a|
            = render 'jobs/card', job: a
        = will_paginate @jobs

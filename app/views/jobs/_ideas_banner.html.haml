-# The yellow box over the notepad's jobs, when there are suggestions for the member.
= link_to job_ideas_path, class: 'notepad-ideas', data: { job_ideas_open: true } do
  %svg{ width: 24, height: 24, viewBox: '0 0 24 24', fill: 'none', stroke: 'currentColor', 'stroke-width': 1.8,
        'stroke-linecap': 'round', 'stroke-linejoin': 'round', 'aria-hidden': 'true' }
    %path{ d: 'M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3z' }
  %span.notepad-ideas-text= t('job_ideas.banner', count:)
  %span.notepad-ideas-go= t('job_ideas.banner_go')

- cache job do
  .card.job{class: job.active ? '' : 'card-finished'}
    - if member_signed_in? && current_member.id == job.owner_id
      .job-quick-actions= render 'jobs/actions', job:
    .card-body
      %h4= job.name
      - if job.due_date
        %small.due-date{title: job.due_date}
          = standard_time_distance(job.due_date.to_date, Time.zone.now.to_date)
      %div
        %small.text-justify{title: job.description}= job.description.to_s.truncate(150)
      %ul.list-unstyled.mb-0
        - if job.garden
          %li
            %small= link_to job.garden_name, garden_path(job.garden)
        - if job.planting
          %li
            %small= link_to job.planting_name, planting_path(job.planting)

    .card-footer
      %small.chip.member-chip
        = link_to member_path(slug: job.owner_slug) do
          = job.owner_login_name

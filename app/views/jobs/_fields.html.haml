-# The fields of a job's form, in the edit dialog and on the form page.
.row
  .col-md-12
    = f.text_field :name, required: true, label: 'What needs to be done?', autofocus: true
.row
  .col-md-12
    = f.text_area :description, rows: 6, label: 'Tell us more about it'

.row
  .col-md-4
    = f.collection_radio_buttons(:garden_id, job.owner.gardens.active.order_by_name,
      :id, :name,
      label: 'Is this for a specific garden?')
    = link_to "Add a garden.", new_garden_path

  .col-md-4
    = f.collection_radio_buttons(:planting_id, job.owner.plantings.active.recent,
      :id, :crop_name,
      label: 'Is this for a specific planting?')
    = link_to "Add a planting.", new_planting_path

  .col-md-4
    = f.date_field :due_date,
               value: job.due_date ? job.due_date.to_fs(:ymd) : '',
               label: 'When?'
%hr

.row
  .col-md-6
    = f.check_box :finished, label: t('buttons.mark_as_finished')
    %span.form-text= t('jobs.form.finish_helper')

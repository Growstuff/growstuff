.card.col-md-8.col-lg-7.mx-auto.float-none.white.z-depth-1.py-2.px-2
  .card-header
    - if content_for? :title
      %h1.h2-responsive.text-center
        = planting_icon
        %strong=yield :title
  = bootstrap_form_for(@job) do |f|
    .card-body
      - if @job.errors.any?
        #error_explanation
          %h2
            = pluralize(@job.errors.size, "error")
            prohibited this job from being saved:
          %ul
            - @job.errors.full_messages.each do |msg|
              %li= msg

      = render 'jobs/fields', f:, job: @job
      - if @job.new_record?
        .row
          .col-md-6
            = label_tag :repeat_times, 'Repeat how many times?'
            = number_field_tag :repeat_times, nil, class: 'form-control'
          .col-md-6
            = label_tag :repeat_weeks, 'Every how many weeks?'
            = number_field_tag :repeat_weeks, nil, class: 'form-control'

    .card-footer
      .text-end= f.submit 'Save'

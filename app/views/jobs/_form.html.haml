.card.col-md-8.col-lg-7.mx-auto.float-none.white.z-depth-1.py-2.px-2
  .card-header
    - if content_for? :title
      %h1.h2-responsive.text-center
        = planting_icon
        %strong=yield :title
  = bootstrap_form_for(@job) do |f|
    .card-body
      - if @job.errors.any?
        #error_explanation
          %h2= t('.errors', count: @job.errors.size)
          %ul
            - @job.errors.full_messages.each do |msg|
              %li= msg

      .row
        .col-md-12
          = f.text_field :name, required: true, label: t('.name_label'), autofocus: true
      .row
        .col-md-12
          = f.text_area :description, rows: 6, label: t('.description_label')

      .row
        .col-md-4
          = f.collection_radio_buttons(:garden_id, @job.owner.accessible_gardens.active.order_by_name,
            :id, :name,
            label: t('.garden_label'))
          = link_to t('.add_garden'), new_garden_path

        .col-md-4
          = f.collection_radio_buttons(:planting_id, Planting.active.where(garden_id: @job.owner.accessible_gardens).recent,
            :id, :crop_name,
            label: t('.planting_label'))
          = link_to t('.add_planting'), new_planting_path

        .col-md-4
          = f.date_field :due_date,
                     value: @job.due_date ? @job.due_date.to_fs(:ymd) : '',
                     label: t('.when_label')
      %hr

      .row
        .col-md-6
          = f.check_box :finished, label: t('buttons.mark_as_finished')
          %span.form-text= t('jobs.form.finish_helper')
      - if @job.new_record?
        .row
          .col-md-6
            = label_tag :repeat_times, t('.repeat_times_label')
            = number_field_tag :repeat_times, nil, class: 'form-control'
          .col-md-6
            = label_tag :repeat_weeks, t('.repeat_weeks_label')
            = number_field_tag :repeat_weeks, nil, class: 'form-control'

    .card-footer
      .text-end= f.submit t('.save')

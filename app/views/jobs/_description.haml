- if event_model.finished
  = t('.planned', name: event_model.name)
- else
  = t('.plans', name: event_model.name)
  - if event_model.due_date && event_model.due_date >= Time.zone.today
    = t('.due', due: job_due_label(event_model))

- if event_model.planting
  %span= t('.on_planting_html', link: link_to(event_model.planting, event_model.planting))

- if event_model.garden
  %span= t('.in_garden_html', link: link_to(event_model.garden, event_model.garden))

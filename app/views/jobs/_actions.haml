- if can?(:edit, job)
  - copy_path = new_job_path(name: job.name, description: job.description,
                                   garden_id: job.garden_id, planting_id: job.planting_id, due_date: job.due_date)
  - update_path = ->(attributes) { job_path(job, job: attributes) }
  = actions_menu('job', id: job.id) do
    = menu_link_to :edit, t('buttons.edit'), edit_job_path(job)
    = menu_link_to :copy, t('buttons.copy'), copy_path
    - if job.active
      = menu_link_to :finish, t('buttons.mark_as_finished'), update_path.call(finished: 1), method: :put, class: 'append-date'
    = menu_link_to :job, t('jobs.pad.move_today'), update_path.call(due_date: Time.zone.today), method: :put
    = menu_link_to :job, t('jobs.pad.move_week'), update_path.call(due_date: JobList.week_end(Time.zone.today)), method: :put
    .dropdown-divider
    = menu_delete_button(job)

<?xml version="1.0" encoding="UTF-8"?>
%rss{ version: 2.0 }
  %channel
    %title
      Recent jobs from #{@owner ? @owner : 'all members'} (#{ENV['GROWSTUFF_SITE_NAME']})
    %link= jobs_url
    - @jobs.each do |job|
      %item
        %title #{job['name']}
        %pubdate= job['created_at'].to_fs(:rfc822)
        %description
          :escaped
            <p>Due Date: #{job['due_date'] ? job['due_date'] : 'unknown' }</p>
            <p>Garden: #{job['garden_name'] ? job['garden_name'] : 'N/A' }</p>
            <p>Planting: #{job['planting_name'] ? job['planting_name'] : 'N/A' }</p>
          :escaped_markdown
            #{ strip_tags markdownify(job['description']) }
        %link= member_jobs_url(job.owner)
        %guid{ isPermaLink: 'false' }= "job-#{job['id']}"

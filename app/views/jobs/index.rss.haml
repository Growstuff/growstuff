<?xml version="1.0" encoding="UTF-8"?>
%rss{ version: 2.0 }
  %channel
    %title= t('jobs.index.rss_title', owner: (@owner ? @owner.to_s : t('jobs.index.all_members')), site: ENV['GROWSTUFF_SITE_NAME'])
    %link= jobs_url
    - @jobs.each do |job|
      %item
        %title= job.name
        %pubdate= job.created_at.to_fs(:rfc822)
        %description
          :escaped
            <p>#{t('jobs.index.due_date_html', date: (job.due_date ? l(job.due_date) : t('jobs.index.unknown')))}</p>
            <p>#{t('jobs.index.garden_html', garden: (job.garden_name || t('jobs.index.not_applicable')))}</p>
            <p>#{t('jobs.index.planting_html', planting: (job.planting_name || t('jobs.index.not_applicable')))}</p>
          :escaped_markdown
            #{strip_tags markdownify(job.description)}
        %link= member_jobs_url(job.owner)
        %guid{ isPermaLink: 'false' } job-#{job.id}

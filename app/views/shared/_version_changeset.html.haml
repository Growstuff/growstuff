- if version.changeset.present?
  .changes
    - version.changeset.each do |field, changes|
      - if field != "updated_at"
        .row
          .col-md-3
            %strong= field.humanize
          .col-md-9
            = version_change_value(field, changes[0])
            %span.text-muted ->
            = version_change_value(field, changes[1])

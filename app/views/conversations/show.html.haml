- content_for :breadcrumbs do
  %li.breadcrumb-item= link_to t('.breadcrumb_conversations'), conversations_path
  %li.breadcrumb-item.active= link_to @conversation.subject, conversation_path(@conversation)

.row
  .col-md-2
  .col-md-10
    %h1= @conversation.subject
.row
  .col-md-2
    .card
      .card-header
        %h6= t('.participants')
      %ul.list-group.list-group-flush
        - @participants.each do |member|
          %li.list-group-item= render 'members/tiny', member: member
  .col-md-10
    .card
      %ul.list-group.list-group-flush
        - @conversation.messages.order(:created_at).each do |message|
          %li.list-group-item
            .col-md-8.text-muted
              = comment_icon
              = t('.sent_on', date: message.created_at)
            .col-md-4.text-end.float-end
              = render 'members/tiny', member: message.sender
            - if message.notified_object.present?
              .col-12
                = t('.about')
                = link_to message.notified_object.to_s, polymorphic_path(message.notified_object)
            .col-12
              %p.text-justify
                :markdown
                  #{ strip_tags markdownify(message.body) }
        %li.list-group-item
          - if @discussion_topic
            = link_to t('.reply_publicly'), polymorphic_path(@discussion_topic, anchor: @discussion_topic.is_a?(Photo) ? 'comments' : 'new-comment'), class: 'btn btn-primary'
            %details.mt-3
              %summary= t('.send_private_message')
              %p.mt-2= t('.private_reply_hint')
              = render 'messages/form', conversation: @conversation
          - else
            = icon 'fas', 'reply'
            = render 'messages/form', conversation: @conversation

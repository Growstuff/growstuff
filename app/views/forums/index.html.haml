- content_for :title, t('.title')

- if can? :create, Forum
  %p
    = link_to t('.new_forum'), new_forum_path, class: 'btn btn-outline-secondary'

- @forums.each do |forum|
  %h2= forum
  %p= forum.description
  %p
    = localize_plural(forum.posts, Post)
    |
    = link_to t('.visit_forum'), forum
    |
    = link_to t('.post'), new_post_path(forum_id: forum.id)
  = render partial: "posts/summary", locals: { posts: forum.posts, howmany: 4 }

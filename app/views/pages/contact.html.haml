- content_for :title, t('.title')

%h1= t('.title')
%dl
  %dt= t('.general_email')
  %dd= mail_to 'info@growstuff.org', 'info@growstuff.org'
%dl
  %dt= t('.support_enquiries_html', faq_link: link_to(t('.faq'), '/support'))
  %dd= mail_to 'support@growstuff.org', 'support@growstuff.org'
%dl
  %dt= t('.media_enquiries')
  %dd= mail_to 'media@growstuff.org', 'media@growstuff.org'
%dl
  %dt= t('.twitter')
  %dd= link_to '@growstufforg', 'http://twitter.com/growstufforg'

-# The seedlings on the stall that nobody has been given yet, as cards on the table with their photo, like the packets of
-# seed. A friend can claim one; the owner then gives it to them, or says who else took it, or takes it off.
-# Available ones first; claimed ones are dimmed, and say who has them.
- offers = stall.seedlings_on_offer.to_a.sort_by { |offer| offer.claim ? 1 : 0 }
- available = offers.count { |offer| offer.claim.nil? }
%section.stall-section{ 'aria-labelledby': 'stall-offer-h' }
  .stall-section-header
    %h2#stall-offer-h= t('.heading')
    %span= available == offers.size ? t('.count', count: offers.size) : t('.available', available:, count: offers.size)
    = link_to t('.add'), new_stall_planting_path(status: 'offered'), class: 'stall-add' if owner
  .stall-section-body
    - unless member_signed_in?
      %p.stall-signin-hint
        = icon 'fas', 'circle-info'
        = t('.sign_in_hint')
    %p.stall-legend
      %span.stall-offer-tag.stall-offer-free= t('stalls.offers.free')
      = t('.legend')
    .stall-packets-grid
      - offers.each do |offer|
        = render 'stalls/seedling_card', offer:, owner:
    .stall-tabletop{ 'aria-hidden': 'true' }

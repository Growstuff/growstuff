-# The packets on the stall, as seed packet cards on the table, each saying in
-# words and colour whether it is free or a swap. The owner can add more, or take
-# one off. A friend can claim a packet; it is theirs straight away.
%section.stall-section{ 'aria-labelledby': 'stall-tin-h' }
  .stall-section-header
    %h2#stall-tin-h= t('.heading', name: stall.member)
    - stall_seeds = stall.stall_seeds_on_table.includes(:seed, claim: { member: :authentications }).sort_by { |stall_seed| stall_seed.claim ? 1 : 0 }
    - available = stall_seeds.count { |stall_seed| stall_seed.claim.nil? }
    %span= available == stall_seeds.size ? t('.packets', count: stall_seeds.size) : t('.available', available:, count: stall_seeds.size)
    = link_to t('.add'), new_stall_seed_path, class: 'stall-add' if owner
  .stall-section-body
    %p.stall-legend
      %span.stall-offer-tag.stall-offer-free= t('stalls.offers.free')
      %span.stall-offer-tag.stall-offer-swap= t('stalls.offers.swap')
      = t('.legend')
    .stall-packets-grid
      -# Available ones first; claimed ones are dimmed, and say who has them.
      - stall_seeds.each do |stall_seed|
        - seed = stall_seed.seed
        .stall-tin-item{ class: ('stall-tin-item-claimed' if stall_seed.claim) }
          = render 'seeds/card', seed: seed
          = render 'stalls/offer_tag', offer: stall_seed.offer, claim: stall_seed.claim
          = render 'stalls/claim', item: stall_seed, claim_path: stall_seed_claim_path(stall_seed), owner:
          - if owner
            = button_to stall_seed_path(seed), method: :delete, class: 'stall-take-off', title: t('.take_off') do
              = icon 'fas', 'xmark'
              %span.visually-hidden= t('.take_off')
    .stall-tabletop{ 'aria-hidden': 'true' }

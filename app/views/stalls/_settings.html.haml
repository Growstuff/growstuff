-# The owner choosing who can claim: where friends can be, and whether they may be asked to pay for postage. A dialog over
-# the stall, opened from the owner's "Edit my stall settings" button.
.modal.fade.stall-settings#stall-settings{ 'aria-hidden': 'true', 'aria-labelledby': 'stall-settings-h', role: 'dialog', tabindex: '-1' }
  .modal-dialog{ role: 'document' }
    .modal-content
      = form_with model: stall, url: stall_path, method: :patch do |f|
        .modal-header
          %h2.modal-title#stall-settings-h= t('.heading')
          %button.btn-close{ 'aria-label': t('.close'), 'data-bs-dismiss': 'modal', type: 'button' }
        .modal-body
          %fieldset
            %legend= t('.where')
            - Stall.claim_areas.each_key do |area|
              = f.label "claim_area_#{area}", class: 'stall-offer-choice' do
                = f.radio_button :claim_area, area
                = t(".areas.#{area}", place: stall.member.location_place || t('.your_place'))
            %p.text-muted= t('.where_help')
          - unless stall.member.located?
            %p.stall-note
              = t('.unplaced')
              = link_to t('.set_place'), edit_member_registration_path
          %label.stall-offer-choice
            = f.check_box :postage
            = t('.postage')
        .modal-footer
          %button.btn.btn-secondary{ 'data-bs-dismiss': 'modal', type: 'button' }= t('.cancel')
          = f.submit t('.save'), class: 'btn btn-primary'

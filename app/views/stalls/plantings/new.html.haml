- content_for :title, t('.title')

- content_for :scripts do
  = javascript_include_tag 'react_islands', defer: true

- content_for :breadcrumbs do
  %li.breadcrumb-item= link_to t('layouts.menu.gardens'), gardens_path
  %li.breadcrumb-item= link_to t('stalls.show.breadcrumb'), member_stall_path(current_member)
  %li.breadcrumb-item.active= t('.title')

-# One question, what has happened to the seedlings, then only the fields that answer needs: see GiveAwayForm.
= react_component 'GiveAwayForm', give_away_props(seedlings: @seedlings, selected: @selected, status: @status, values: @values, recipients: @recipients, errors: @errors.to_a)
%noscript
  %p= t('.needs_javascript')

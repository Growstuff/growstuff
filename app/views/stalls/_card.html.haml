-# On the nursery garden: where the owner opens their garden stall, or goes to it.
- if garden.nursery? && can?(:edit, garden) && Feature.enabled?(:garden_stall)
  - stall = garden.owner.stall
  .stall-card.mb-3
    %h2.h5= t('.heading')
    - if stall&.open?
      %p= t('.open_text')
      = link_to t('.go'), member_stall_path(garden.owner), class: 'btn btn-outline-success'
    - else
      %p= t('.text')
      = link_to t('.open'), member_stall_path(garden.owner), class: 'btn btn-success'

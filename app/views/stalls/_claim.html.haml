-# What a friend can do with a packet of seed or an offered seedling: claim it, or, once it's claimed, see who has
-# it. Their own claim they can give back. `item` is the StallSeed or StallPlanting, and `claim_path` where claims go.
- claim = item.claim
- if claim
  .stall-ribbon
    %strong= t('.claimed')
    = render 'stalls/claimer', member: claim.member
  = tag.p t('.note', note: claim.note), class: 'stall-claim-note' if owner && claim.note.present?
  - mine = claim.member == current_member
  = render 'stalls/handover', item:, claim:, owner:, mine:
  = button_to t('.undo'), claim_path, class: 'btn btn-secondary btn-sm', method: :delete if mine && claim.undoable?
- elsif !owner
  - if member_signed_in?
    - stall = item.stall
    - check = stall.area_check(current_member)
    - if %i(outside owner_unplaced).include?(check)
      %button.stall-claim-blocked{ type: 'button', 'aria-disabled': 'true' }
        = check == :outside ? t('.outside', place: stall.area_name) : t('.owner_unplaced')
      = link_to t('.set_place'), edit_member_registration_path, class: 'stall-set-place' if check == :outside
    - else
      %details.stall-claim
        %summary.btn.btn-primary= t('.claim')
        = form_with url: claim_path do
          - if stall.postage?
            %p.stall-note= t('.postage', owner: stall.member)
          = label_tag dom_id(item, :note), t('.note_label'), class: 'form-label fw-bold'
          = text_area_tag :note, nil, id: dom_id(item, :note), rows: 2, maxlength: 500, class: 'form-control mb-2',
            placeholder: t('.note_placeholder')
          - if check == :ask
            %label.stall-here
              = check_box_tag :here, '1', false, id: dom_id(item, :here)
              = t('.here', place: stall.area_name)
            %p.stall-set-place= link_to t('.set_place_ask'), edit_member_registration_path
          = submit_tag t('.confirm'), class: 'btn btn-primary btn-sm'
  - else
    = render 'stalls/sign_in_to_claim'

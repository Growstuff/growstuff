-# Seedlings given away from the stall, and when. Only their owner sees who they went to, and whether it has been claimed.
%section.stall-section{ 'aria-labelledby': 'stall-given-h' }
  .stall-section-header
    %h2#stall-given-h= t('.heading')
    %span= t('.count', count: stall.stall_plantings.given.size)
  .stall-section-body
    %ul.list-unstyled.mb-0
      - stall.stall_plantings.given.includes(planting: :crop).each do |gift|
        %li
          %strong= gift.planting.display_name
          %span.text-muted= l(gift.given_away_at.to_date)
          - if owner
            %span= t('.to', recipient: gift.recipient_label)
            %span.badge{ class: gift.claimed? ? 'text-bg-success' : 'text-bg-secondary' }= t(gift.claimed? ? '.claimed' : '.waiting')

- content_for :title, 'Resend unlock instructions'

= render 'devise/shared/card', title: 'Resend unlock instructions' do
  = form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post, role: 'form' }) do |f|
    = render 'devise/shared/error_messages', resource: resource
    .mb-3
      = f.label :email, 'Email', class: 'form-label fw-semibold'
      = f.email_field :email, class: 'form-control', autocomplete: 'email', autofocus: true
    = f.submit 'Resend unlock instructions', class: 'btn btn-success w-100'

- content_for :title, 'Resend unlock instructions'

= render 'devise/shared/card', title: 'Resend unlock instructions' do
  = bootstrap_form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post }) do |f|
    = render 'devise/shared/error_messages', resource: resource
    = f.email_field :email, autocomplete: 'email', autofocus: true
    = f.submit 'Resend unlock instructions', class: 'btn btn-success w-100'

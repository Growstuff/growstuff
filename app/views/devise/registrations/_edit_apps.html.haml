= render layout: 'devise/registrations/app_service',
         locals: { title: 'Flickr', note: t('devise_views.flickr_use'),
                   icon: image_tag('flickr_32.png', size: '32x32', alt: t('devise_views.provider_logo', provider: 'Flickr')) } do
  - if @flickr_auth
    = render 'devise/registrations/app_account', authentication: @flickr_auth,
             name: link_to(@flickr_auth.name, "https://flickr.com/photos/#{@flickr_auth.uid}")
  - else
    = button_to t('devise_views.connect_provider', provider: 'Flickr'), '/members/auth/flickr', class: 'btn btn-outline-dark'

- if Authentication.enabled_sign_in_providers.include?('bluesky')
  = render layout: 'devise/registrations/app_service', locals: { title: 'Bluesky', note: t('devise_views.bluesky_use'), icon: icon('fab', 'bluesky', class: 'fa-2x') } do
    - if (bluesky_auth = current_member.auth('bluesky'))
      = render 'devise/registrations/app_account', authentication: bluesky_auth,
               name: link_to("@#{bluesky_auth.name}", "https://bsky.app/profile/#{bluesky_auth.uid}")
    - else
      = render 'authentications/sign_in/bluesky', label: t('devise_views.connect_provider', provider: 'Bluesky'), tos: false

- if Authentication.enabled_sign_in_providers.include?('mastodon')
  = render layout: 'devise/registrations/app_service', locals: { title: t('devise_views.fedi_heading'), note: t('devise_views.fedi_use'), icon: icon('fab', 'mastodon', class: 'fa-2x') } do
    - if @mastodon_auths&.any?
      - @mastodon_auths.each do |mastodon_auth|
        = render 'devise/registrations/app_account', authentication: mastodon_auth, name: mastodon_auth.name || mastodon_auth.uid
    -# One button, which asks for the server in a dialog. Without JavaScript it is the plain form.
    = react_component 'FediConnect', { url: omniauth_authorize_path(:member, :mastodon), buttonLabel: t('devise_views.fedi_add'),
                                       copy: t('devise_views.fedi_connect') } do
      = render 'authentications/sign_in/mastodon', label: t('devise_views.connect_provider', provider: 'Mastodon'), tos: false

- if Authentication.enabled_sign_in_providers.include?('github')
  = render layout: 'devise/registrations/app_service', locals: { title: 'GitHub', icon: icon('fab', 'github', class: 'fa-2x') } do
    - if (github_auth = current_member.auth('github'))
      = render 'devise/registrations/app_account', authentication: github_auth, name: github_auth.name || github_auth.uid
    - else
      = render 'authentications/sign_in/github', label: t('devise_views.connect_provider', provider: 'GitHub'), tos: false

= render layout: 'devise/registrations/app_service',
         locals: { title: t('devise_views.api_heading'), icon: image_tag('icons/post.svg', size: '32x32', alt: t('devise_views.provider_logo', provider: 'API')) } do
  - if current_member.api_token?
    %p.mb-2
      = t('devise_views.api_token')
      -# The token is hidden, and copied with a button. Without JavaScript it is shown.
      = react_component 'ApiTokenCopy', { token: current_member.api_token.token, copyLabel: t('devise_views.copy'),
                                          copiedLabel: t('devise_views.copied') }, { class: 'd-inline' } do
        %code.app-service-token= current_member.api_token.token
    .d-flex.flex-wrap.gap-2
      = link_to t('devise_views.regenerate'), regenerate_api_token_path,
                data: { confirm: t('devise_views.regenerate_confirm') },
                method: :post, class: 'remove btn btn-outline-warning btn-sm'
      = link_to t('devise_views.delete_token'), destroy_api_token_path,
                data: { confirm: t('devise_views.delete_token_confirm') },
                method: :delete, class: 'remove btn btn-outline-danger btn-sm'
  - else
    = link_to t('devise_views.generate_token'), regenerate_api_token_path, method: :post, class: 'btn btn-outline-dark'

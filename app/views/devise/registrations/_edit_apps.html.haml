%br/
.row
  .col-md-12
    %p
      = image_tag "flickr_32.png", size: "32x32", alt: t('devise_views.provider_logo', provider: 'Flickr')
      - if @flickr_auth
        = t('devise_views.connected_html', provider: 'Flickr', account: link_to(@flickr_auth.name, "https://flickr.com/photos/#{@flickr_auth.uid}"))
        = link_to t('devise_views.disconnect'), @flickr_auth,
                  data: { confirm: t('devise_views.disconnect_confirm') },
                  method: :delete, class: "remove btn btn-danger"
      - else
        = button_to t('devise_views.connect_provider', provider: 'Flickr'), '/members/auth/flickr', class: 'btn'
- if Authentication.enabled_sign_in_providers.include?('bluesky')
  %hr
  .row
    .col-md-12
      - if (bluesky_auth = current_member.auth('bluesky'))
        %p
          = icon 'fab', 'bluesky'
          = t('devise_views.connected_html', provider: 'Bluesky', account: link_to("@#{bluesky_auth.name}", "https://bsky.app/profile/#{bluesky_auth.uid}"))
          = link_to t('devise_views.disconnect'), bluesky_auth,
                    data: { confirm: t('devise_views.disconnect_confirm') },
                    method: :delete, class: "remove btn btn-danger"
      - else
        = render 'authentications/sign_in/bluesky', label: t('devise_views.connect_provider', provider: 'Bluesky'), tos: false
- if Authentication.enabled_sign_in_providers.include?('mastodon')
  %hr
  .row
    .col-md-12
      %p
        = icon 'fab', 'mastodon', class: 'fa-2x align-middle me-1'
        - if @mastodon_auths&.any?
          = t('devise_views.mastodon_accounts')
          %ul.mt-2
            - @mastodon_auths.each do |mastodon_auth|
              %li.mb-2
                = mastodon_auth.name || mastodon_auth.uid
                = link_to t('devise_views.disconnect'), mastodon_auth,
                          data: { confirm: t('devise_views.disconnect_confirm') },
                          method: :delete, class: "remove btn btn-danger btn-sm ms-2"
        - else
          = t('devise_views.mastodon_help')
      -# These two controls belong to the #mastodon-connect form at the foot of this
      -# partial. HTML doesn't allow a form inside this one, so they point at it with `form`.
      .row.g-2.align-items-center
        .col-auto
          = label_tag :identifier, t('devise_views.mastodon_address'), class: 'visually-hidden'
          = text_field_tag :identifier, nil, form: 'mastodon-connect', placeholder: 'you@mastodon.social',
                            class: 'form-control', required: true, autocomplete: 'off'
        .col-auto
          = submit_tag(@mastodon_auths&.any? ? t('devise_views.connect_another') : t('devise_views.connect_provider', provider: 'Mastodon'),
                        form: 'mastodon-connect', name: nil, class: 'btn btn-primary')

%hr
.row
  .col-md-12
    %p
      = image_tag "icons/post.svg", size: "32x32", alt: t('devise_views.provider_logo', provider: 'API')
      - if current_member.api_token?
        = t('devise_views.api_token')
        %code= current_member.api_token.token
        = link_to t('devise_views.regenerate'), regenerate_api_token_path,
                  data: { confirm: t('devise_views.regenerate_confirm') },
                  method: :post, class: "remove btn btn-warning"
        = link_to t('devise_views.delete_token'), destroy_api_token_path,
                  data: { confirm: t('devise_views.delete_token_confirm') },
                  method: :delete, class: "remove btn btn-danger"
      - else
        = link_to t('devise_views.generate_token'), regenerate_api_token_path, method: :post, class: 'btn btn-primary'

-# See the Mastodon controls above. Any server can be chosen, so the address is asked for here.
= form_with url: omniauth_authorize_path(:member, :mastodon), method: :post, id: 'mastodon-connect', local: true, data: { turbo: false } do
  -# The fields are up in the settings form; see above.

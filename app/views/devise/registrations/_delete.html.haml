= form_for(resource, as: resource_name,
    url: registration_path(resource_name) + '#delete',
    html: { method: :delete }) do |f|
  %br/
  = render 'devise/shared/error_messages', resource: resource

  %p= t('devise_views.delete_help', site_name: ENV['GROWSTUFF_SITE_NAME'])
  .row.mb-3
    = f.label :current_password, t('devise_views.delete_password'), class: 'col-form-label col-md-2'
    .col-md-4
      = f.password_field :current_password, class: 'form-control', id: 'current_pw_for_delete'

  .row.mb-3
    .offset-md-2.col-md-8
      = f.submit t('devise_views.delete'), class: 'btn btn-danger'

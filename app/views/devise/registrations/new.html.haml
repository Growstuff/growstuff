- site_name = ENV.fetch('GROWSTUFF_SITE_NAME', nil)

= render 'devise/shared/card', title: t('devise_views.join_site', site_name: site_name) do
  %p= t('devise_views.signup_help', site_name: site_name)
  %p= t('devise_views.captcha_help')

  = bootstrap_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { data: { turbo: false } }) do |f|
    = render 'devise/shared/error_messages', resource: resource

    = f.text_field :login_name, label: t('devise_views.login_name'), help: t('devise_views.login_help')
    = f.email_field :email, label: t('devise_views.email'), help: t('devise_views.email_help')
    = f.password_field :password, label: t('devise_views.password')
    = f.password_field :password_confirmation, label: t('devise_views.confirm_password')

    = f.check_box :tos_agreement, label: t('devise_views.agreement_html', link: link_to(t('devise_views.terms'), '/policy/tos'))

    = f.submit t('devise_views.sign_up'), class: 'btn w-100 btn-success'

    = flash[:recaptcha_error]
    = recaptcha_tags

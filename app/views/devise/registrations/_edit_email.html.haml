= form_for(resource, as: resource_name,
    url: registration_path(resource_name) + '#email',
    html: { method: :put }) do |f|
  %br/
  = render 'devise/shared/error_messages', resource: resource

  .row.mb-3
    = f.label :email, t('devise_views.email'), class: 'col-form-label col-md-2'
    .col-md-8
      = f.email_field :email, class: 'form-control'
      %span.form-text= t('devise_views.reconfirm_email')

  .row.mb-3
    .offset-md-2.col-md-8.checkbox
      %label
        = f.check_box :show_email
        = t('devise_views.show_email')

  .row.mb-3
    .offset-md-2.col-md-8.checkbox
      %label
        = f.check_box :send_notification_email
        = t('devise_views.notification_email')

  .row.mb-3
    .offset-md-2.col-md-8.checkbox
      %label
        = f.check_box :send_planting_reminder
        = t('devise_views.planting_reminders')

  .row.mb-3
    .offset-md-2.col-md-8.checkbox
      %label
        = f.check_box :send_harvest_reminder
        = t('devise_views.harvest_reminders')

  .row.mb-3
    .offset-md-2.col-md-8
      = f.submit t('devise_views.save'), class: 'btn btn-primary'
      = f.hidden_field(:tos_agreement, value: true)

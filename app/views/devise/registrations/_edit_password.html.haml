= form_for(resource, as: resource_name,
    url: registration_path(resource_name) + '#password',
    html: { method: :put }) do |f|
  %br/
  = render 'devise/shared/error_messages', resource: resource

  .row.mb-3
    = f.label :current_password, t('devise_views.current_password'), class: 'col-form-label col-md-2'
    .col-md-4
      = f.password_field :current_password, class: 'form-control'

  .row.mb-3
    = f.label :password, t('devise_views.new_password'), class: 'col-form-label col-md-2'
    .col-md-4
      = f.password_field :password, autocomplete: "off", class: 'form-control'

  .row.mb-3
    = f.label :password_confirmation, t('devise_views.confirm_password'), class: 'col-form-label col-md-2'
    .col-md-4= f.password_field :password_confirmation, class: 'form-control'

  .row.mb-3
    .offset-md-2.col-md-8
      = f.submit t('devise_views.save'), class: 'btn btn-primary'

      = f.hidden_field(:tos_agreement, value: true)

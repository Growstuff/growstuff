- site_name = ENV['GROWSTUFF_SITE_NAME']
%p= t('devise_views.greeting', name: @resource.login_name)
%p= t('devise_views.unlock_body', site_name: site_name)
%p= link_to t('devise_views.unlock_account'), unlock_url(@resource, unlock_token: @token)
%p= t('devise_views.unlock_help_html', link: link_to(t('devise_views.reset_password'), new_password_url(@resource)))
%p= t('devise_views.see_you')
%p
  = t('devise_views.team', site_name: site_name)
  %br/
  = link_to root_url, root_url

- site_name = ENV['GROWSTUFF_SITE_NAME']
%p= t('devise_views.greeting', name: @resource.login_name)
%p= t('devise_views.reset_body', site_name: site_name)
%p= link_to t('devise_views.change_my_password'), edit_password_url(@resource, reset_password_token: @token)
%p= t('devise_views.reset_ignore')
%p= t('devise_views.see_you')
%p
  = t('devise_views.team', site_name: site_name)
  %br/
  = link_to root_url, root_url

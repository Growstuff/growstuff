- site_name = ENV['GROWSTUFF_SITE_NAME']
%p= t('devise_views.greeting', name: @resource.login_name)
%p= t('devise_views.confirmation_body', site_name: site_name)
%p= link_to t('devise_views.confirm_account'), confirmation_url(@resource, confirmation_token: @token)
%p= t('devise_views.confirmed_help', login: @resource.login_name, email: @resource.email)
%p= t('devise_views.welcome_html', site_name: site_name, plant_link: link_to(t('devise_views.plant_things'), url_for(controller: '/crops', only_path: false)), forums_link: link_to(t('devise_views.forums'), url_for(controller: '/forums', only_path: false)))
%p= t('devise_views.guidelines_help_html', site_name: site_name, link: link_to(t('devise_views.guidelines'), policy_community_url))
%p= t('devise_views.looking_forward')
%p
  = t('devise_views.team', site_name: site_name)
  %br/
  = link_to root_url, root_url

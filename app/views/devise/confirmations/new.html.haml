= render 'devise/shared/card', title: 'Resend confirmation instructions' do
  = bootstrap_form_for(resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post }) do |f|
    = render 'devise/shared/error_messages', resource: resource
    %p Enter either your login name or your email address to resend the confirmation email.
    = f.text_field :login, label: 'Login name or email', autofocus: true
    = f.submit 'Resend confirmation instructions', class: 'btn btn-success w-100'

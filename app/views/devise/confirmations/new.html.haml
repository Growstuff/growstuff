= render 'devise/shared/card', title: t('devise_views.resend_confirmation') do
  = bootstrap_form_for(resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post }) do |f|
    = render 'devise/shared/error_messages', resource: resource
    %p= t('devise_views.confirmation_help')
    = f.text_field :login, label: t('devise_views.login'), autofocus: true
    = f.submit t('devise_views.resend_confirmation'), class: 'btn btn-success w-100'

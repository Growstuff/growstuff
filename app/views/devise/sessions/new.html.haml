= render 'devise/shared/card', title: 'Sign in' do
  = bootstrap_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f|
    = f.text_field :login, label: 'Login name or email', autocomplete: 'username', required: true
    = f.password_field :password, autocomplete: 'current-password', required: true
    - if devise_mapping.rememberable?
      = f.check_box :remember_me, label: 'Keep me signed in'
    = f.submit 'Sign in', class: 'btn btn-success w-100'

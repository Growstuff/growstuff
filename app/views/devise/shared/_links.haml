- if controller_name != 'sessions'
  %p.mb-1= link_to t('devise_views.sign_in'), new_session_path(resource_name)

- if devise_mapping.registerable? && controller_name != 'registrations'
  %p.mb-1= link_to t('devise_views.join_free'), new_registration_path(resource_name)

- if devise_mapping.recoverable? && controller_name != 'passwords'
  %p.mb-1= link_to t('devise_views.forgot_password'), new_password_path(resource_name)

- if devise_mapping.confirmable? && controller_name != 'confirmations'
  %p.mb-1= link_to t('devise_views.missing_confirmation'), new_confirmation_path(resource_name)

- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks'
  %p.mb-1= link_to t('devise_views.missing_unlock'), new_unlock_path(resource_name)

- if %w(sessions registrations).include?(controller_name)
  - Authentication.enabled_sign_in_providers.each do |provider|
    = render "authentications/sign_in/#{provider}", label: t('devise_views.continue_with', provider: provider.titleize), tos: controller_name == 'registrations'

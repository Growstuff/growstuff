- if controller_name != 'sessions'
  %p.mb-1= link_to 'Sign in', new_session_path(resource_name)

- if devise_mapping.registerable? && controller_name != 'registrations'
  %p.mb-1= link_to 'Join free', new_registration_path(resource_name)

- if devise_mapping.recoverable? && controller_name != 'passwords'
  %p.mb-1= link_to 'Forgot your password?', new_password_path(resource_name)

- if devise_mapping.confirmable? && controller_name != 'confirmations'
  %p.mb-1= link_to "Didn't receive confirmation instructions?", new_confirmation_path(resource_name)

- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks'
  %p.mb-1= link_to "Didn't receive unlock instructions?", new_unlock_path(resource_name)

- Authentication.enabled_sign_in_providers.each do |provider|
  = render "authentications/sign_in/#{provider}", label: "Continue with #{provider.titleize}"

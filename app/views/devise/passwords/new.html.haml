= render 'devise/shared/card', title: t('devise_views.forgot_password') do
  = bootstrap_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f|
    = render 'devise/shared/error_messages', resource: resource
    %p= t('devise_views.password_help')
    = f.email_field :login, label: t('devise_views.email'), autocomplete: 'email', autofocus: true
    = f.submit t('devise_views.send_reset'), class: 'btn btn-success w-100'

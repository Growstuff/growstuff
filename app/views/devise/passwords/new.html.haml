= render 'devise/shared/card', title: 'Forgot your password?' do
  = bootstrap_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f|
    = render 'devise/shared/error_messages', resource: resource
    %p Enter your email address and we'll send you a link to choose a new password.
    = f.email_field :login, label: 'Email', autocomplete: 'email', autofocus: true
    = f.submit 'Send me reset password instructions', class: 'btn btn-success w-100'

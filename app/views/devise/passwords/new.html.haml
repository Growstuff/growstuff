= render 'devise/shared/card', title: 'Forgot your password?' do
  = form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, role: 'form' }) do |f|
    = render 'devise/shared/error_messages', resource: resource
    %p Enter your email address and we'll send you a link to choose a new password.
    .mb-3
      = f.label :login, 'Email', class: 'form-label fw-semibold'
      = f.email_field :login, class: 'form-control', autocomplete: 'email', autofocus: true
    = f.submit 'Send me reset password instructions', class: 'btn btn-success w-100'

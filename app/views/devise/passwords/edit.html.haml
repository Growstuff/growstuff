- content_for :title, t('devise_views.change_password')

= render 'devise/shared/card', title: t('devise_views.change_password') do
  = bootstrap_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f|
    = render 'devise/shared/error_messages', resource: resource
    = f.hidden_field :reset_password_token
    = f.password_field :password, label: t('devise_views.new_password'), autocomplete: 'new-password', autofocus: true
    = f.password_field :password_confirmation, label: t('devise_views.confirm_password'), autocomplete: 'new-password'
    = f.submit t('devise_views.change_my_password'), class: 'btn btn-success w-100'

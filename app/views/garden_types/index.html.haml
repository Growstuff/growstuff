- content_for :title, t('.title')

%p
  = t('.description', site_name: ENV['GROWSTUFF_SITE_NAME'])

.index-cards
  - @garden_types.each do |garden_type|
    = render partial: "thumbnail", locals: { garden_type: garden_type }

- if can? :create, GardenType
  %div
    = link_to t('.new_garden_type'), new_garden_type_path, class: 'btn btn-primary'

.pagination
  = will_paginate @garden_types

- animals = member.domesticated_animals.includes(:photos).order(:name, :id)
- can_add = current_member == member && can?(:create, DomesticatedAnimal)
- if animals.any? || can_add
  %section.record-page.mb-4#domesticated-animals
    .section-header
      %h2= t('domesticated_animals.title')
      - if can_add
        = link_to t('domesticated_animals.add'), new_domesticated_animal_path,
                  class: 'btn btn-sm section-add'
    .row
      - animals.each do |animal|
        .col-sm-6.col-lg-4.mb-3
          .card.h-100
            - if animal.default_photo
              = link_to animal do
                = image_tag animal.default_photo.thumbnail_url, alt: animal.name, class: 'card-img-top'
            .card-body
              %h3.h5= link_to animal.name, animal
              %p.mb-0= t("domesticated_animals.categories.#{animal.category}")
              %small.text-muted= animal.species

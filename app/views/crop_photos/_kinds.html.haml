-# What a photo added to a crop shows, which is where the crop page puts it.
-# `prefix` keeps the ids apart where there are several on a page.
- prefix = local_assigns.fetch(:prefix, 'kind')
%fieldset.mb-3
  %legend.form-label.fs-6= t('crop_photos.kinds.legend')
  - [['', 'plant'], *PhotoAssociation::CROP_KINDS.map { |kind| [kind, kind] }].each do |value, key|
    .form-check
      = radio_button_tag :kind, value, value.blank?, class: 'form-check-input', id: "#{prefix}-#{key}"
      %label.form-check-label{ for: "#{prefix}-#{key}" }
        = t("crop_photos.kinds.#{key}")
        %small.d-block.text-muted= t("crop_photos.kinds.#{key}_hint")

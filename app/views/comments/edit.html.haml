= content_for :title, "Editing comment"

%p
  Editing comment on
  - if @comment.commentable.kind_of?(Post)
    = link_to @comment.commentable.subject, @comment.commentable
  - elsif @comment.commentable.kind_of?(Photo)    
    = link_to @comment.commentable.title, @comment.commentable

= render 'form'

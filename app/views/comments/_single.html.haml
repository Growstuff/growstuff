.card.comment
  .card-body
    .row
      .col
        = render "members/tiny", member: comment.author
        - if can?(:edit, comment) || can?(:destroy, comment)
          %hr/
          = actions_menu('comment', id: comment.id, align: :start) do
            - if can? :edit, comment
              = menu_modal_link :edit, t('buttons.edit'), "#comment-#{comment.id}-edit-modal"
            - if can? :destroy, comment
              = menu_delete_button(comment)
          - if can? :edit, comment
            = render 'comments/edit_modal', comment:
      .col-md-9.border-start
        .comment-meta.text-muted
          - author = comment.author.discarded? ? t('.deleted_member') : link_to(comment.author.login_name, member_path(comment.author))
          = t('.attribution_html', author: author, date: l(comment.created_at, format: :long))
          - if comment.updated_at > comment.created_at
            = t('.edited_at', date: l(comment.updated_at, format: :long))

        .comment-body
          :markdown
            #{ strip_tags markdownify(comment.body) }

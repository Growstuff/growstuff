<?xml version="1.0" encoding="UTF-8"?>
%rss{ version: 2.0 }
  %channel
    %title= t('.feed_title', site: ENV['GROWSTUFF_SITE_NAME'])
    %link= comments_url
    - @comments.each do |comment|
      %item
        %title= t('.item_title', author: comment.author.discarded? ? t('comments.single.deleted_member') : comment.author.login_name, subject: comment.commentable.subject)
        %description
          :escaped_markdown
            <p>
            #{ t('.item_description_html', subject: link_to(comment.commentable.subject, polymorphic_url(comment.commentable))) }
            </p>

          :escaped_markdown
            #{ strip_tags markdownify(comment.body) }

        %pubdate= comment.created_at.to_fs(:rfc822)
        %link= polymorphic_url(comment.commentable)
        %guid= comment_url(comment)

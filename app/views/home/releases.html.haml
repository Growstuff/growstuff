- content_for :title, t('.title')

%h1= t('.title')
- github_releases.each do |release|
  %section.releases
    %h2= link_to release[:title], release[:link], target: "_blank", rel: 'noopener'
    .card
      .card-header
        %small= release[:updated].to_date.to_s
      .card-body= release[:content].html_safe
%p
  = link_to t('.find_out_more'), 'https://github.com/Growstuff/growstuff/releases', target: "_blank", rel: 'noopener', class: 'btn w-100'

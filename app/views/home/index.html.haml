- content_for :title do
  = ENV['GROWSTUFF_SITE_NAME']
- content_for :meta_description do
  Growstuff is a community of food gardeners. Let's learn to grow food together.

- if member_signed_in?
  - content_for :scripts do
    = javascript_include_tag 'react_islands', defer: true
  = render 'home/dashboard/ideas'
  - if current_member.setup_todo? && @dashboard.stage != :new
    = render 'home/setup_todo'
  = render "home/dashboard/#{@dashboard.stage}", dashboard: @dashboard
  = render 'home/dashboard/action_bar', dashboard: @dashboard
- else
  = render 'blurb'
  = render 'recent'
  = render 'recent_posts', boxed: false
  = render 'why_join'

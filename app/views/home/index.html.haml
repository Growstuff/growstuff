- content_for :title do
  = ENV['GROWSTUFF_SITE_NAME']
- content_for :meta_description do
  Growstuff is a community of food gardeners. Let's learn to grow food together.

- if member_signed_in?
  - content_for :scripts do
    = javascript_include_tag 'react_islands', defer: true
  = render "home/dashboard/#{@dashboard.stage}", dashboard: @dashboard
  = render 'home/dashboard/action_bar'
- else
  %section= render 'blurb'
  = render 'recent'
  = render 'why_join'

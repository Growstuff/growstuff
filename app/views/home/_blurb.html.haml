.home-hero
  .home-hero-text
    %p.home-hero-badge= t('.badge')
    %h1= t('.headline_html')
    %p.home-hero-intro= t('.intro', site_name: ENV['GROWSTUFF_SITE_NAME'])
    .home-hero-actions
      = link_to(t('.sign_up'), new_member_registration_path, class: 'btn btn-warning btn-lg')
      = link_to(t('.sign_in_linktext'), new_member_session_path, class: 'home-hero-signin')
    %p.home-hero-note= t('.public_note')
  .home-hero-stats= render 'stats'

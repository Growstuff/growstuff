- planting = Planting.homepage_records(6).detect { |candidate| candidate.thumbnail_url.present? }
.home-hero
  .home-hero-text
    %p.home-hero-badge= t('.badge')
    %h1= t('.headline_html')
    %p.home-hero-intro= t('.intro', site_name: ENV['GROWSTUFF_SITE_NAME'])
    .home-hero-actions
      = link_to(t('.sign_up'), new_member_registration_path, data: { auth_dialog: 'sign_up' }, class: 'btn btn-warning btn-lg')
      = link_to(t('.sign_in_linktext'), new_member_session_path, data: { auth_dialog: 'sign_in' }, class: 'home-hero-signin')
      = bluesky_link(t('.sign_in_bluesky'), class: 'home-hero-signin')
      = mastodon_link(t('.sign_in_mastodon'), class: 'home-hero-signin')
    %p.home-hero-note= t('.public_note')
  - if planting
    = link_to planting_path(slug: planting.slug), class: 'home-hero-photo' do
      = image_tag planting.thumbnail_url, alt: "Image of #{planting.display_name} by #{planting.owner_login_name}"
      %span.home-hero-photo-caption
        = planting.display_name
        %br
        %i= t('.photo_by', login: planting.owner_login_name)
= render 'stats'

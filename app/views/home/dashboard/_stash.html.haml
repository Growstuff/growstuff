-# Packets they hold, one per crop, with how many varieties of it.
- stash = dashboard.seeds_on_hand
= home_section(title, action: link_to(t('home.dashboard.add_seeds'), new_seed_path, class: 'home-section-add')) do
  - if stash.empty?
    %p= t('home.dashboard.no_seeds')
  - else
    .index-cards
      - stash.each do |crop, seeds|
        = render 'seeds/card', seed: seeds.first
    - if dashboard.seed_varieties > stash.size
      %p= link_to t('home.dashboard.all_varieties', count: dashboard.seed_varieties), member_seeds_path(current_member)

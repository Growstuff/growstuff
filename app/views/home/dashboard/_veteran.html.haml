-# Years of data: the numbers, the year's harvest, every bed, and how this year compares.
= render 'home/dashboard/header', dashboard:, title: t('home.dashboard.garden_title_html', name: current_member.login_name).html_safe

.home-stats-tiles
  = render 'home/dashboard/stat', value: dashboard.plantings_this_year, label: t('home.dashboard.stat_plantings'), change: dashboard.plantings_this_year - dashboard.plantings_last_year
  = render 'home/dashboard/stat', value: "#{dashboard.kilograms_this_year} kg", label: t('home.dashboard.stat_kilograms'), change: dashboard.kilograms_this_year - dashboard.kilograms_last_year, unit: ' kg'
  = render 'home/dashboard/stat', value: dashboard.harvests_this_year, label: t('home.dashboard.stat_harvests'), change: dashboard.harvests_this_year - dashboard.harvests_last_year
  = render 'home/dashboard/stat', value: dashboard.seed_varieties, label: t('home.dashboard.stat_varieties')

= render 'home/dashboard/this_week', dashboard:
= render 'home/dashboard/tiles', dashboard:

= home_section(t('home.dashboard.harvest_by_month')) do
  = react_component 'HarvestChart', harvest_chart_props(dashboard)

= home_section(t('home.dashboard.growing_now'), id: 'growing-now', action: plant_picker(dashboard, label: t('home.index.plant'), button_class: 'home-section-add')) do
  = react_component 'GrowingTable', growing_table_props(dashboard)
  %p= link_to t('home.dashboard.see_all_plantings', count: current_member.plantings.count), member_plantings_path(current_member)

= home_section(t('home.dashboard.beds'), action: react_component('GardenPicker', { label: t('home.dashboard.add_bed'), buttonClass: 'home-section-add' })) do
  .home-beds
    - dashboard.beds.each do |bed|
      = link_to garden_path(slug: bed[:garden].slug), class: 'home-bed' do
        %b= bed[:garden].name
        %span= t('home.dashboard.bed_counts', plantings: bed[:plantings], ready: bed[:ready])

.row
  .col-12.col-lg-6= render 'home/dashboard/stash', dashboard:, title: t('home.dashboard.seeds_on_hand')
  .col-12.col-lg-6
    = home_section(t('home.dashboard.compared')) do
      %p.home-section-note= t('home.dashboard.compared_note')
      - comparisons = dashboard.compared_with_last_year
      - if comparisons.empty?
        - last_year = dashboard.planted_this_time_last_year
        - if last_year.any?
          %p= t('home.dashboard.last_year_planted', crops: last_year.to_sentence)
        - else
          %p= t('home.dashboard.compared_empty')
      - comparisons.each do |comparison|
        .home-feed
          %span
            %b= comparison.crop
            = comparison.text
.row
  .col-12.col-lg-6= render 'home/dashboard/friends', dashboard:
  .col-12.col-lg-6= render 'home/dashboard/latitude', dashboard:
= render 'home/recent_posts', boxed: true

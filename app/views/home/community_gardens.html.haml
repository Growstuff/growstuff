- content_for :title do
  = t('.title')
- content_for :meta_description do
  = t('.meta_description')

.jumbotron
  .container
    %h1.display-4= t('.header')
    %p.lead= t('.lead')

.container
  .row
    .col-md-6
      %h2= t('.get_started')
      %p= t('.get_started_text')
      %p
        = link_to t('.sign_up'), new_member_registration_path, class: 'btn btn-success btn-lg'
    .col-md-6
      %h2= t('.collaborate')
      %p= t('.collaborate_text')
      %p
        = link_to t('.learn_more'), gardens_path, class: 'btn btn-info btn-lg'

  %hr

  .row
    .col-12
      %h2= t('.features_title')
      %ul
        - t('.features_list').each do |feature|
          %li= feature

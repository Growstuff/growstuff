- content_for :title, t('.title')
- content_for :scripts do
  = javascript_include_tag 'react_islands', defer: true

%h1.mt-3= t('.title')
= render 'suggestions/climate', climate: @climate, member: current_member, selected: @season, payload: @season_payload, dashboard: @dashboard if @dashboard.located?

- if !@dashboard.located?
  %p= t('.not_located')
  = render 'home/dashboard/location_picker', label: t('home.dashboard.set_location'), button_class: 'btn btn-success'
- else
  = render 'home/dashboard/hidden_suggestions', dashboard: @dashboard
  - if @dashboard.suggestions_enabled?
    .home-suggestion-links
      = render 'home/dashboard/stop_suggesting'

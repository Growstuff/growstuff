-# The frost section of a planting or garden page: what frost danger means today, drawn against the season (and the planting, if there is one).
- verdict = frost_verdict(frost)
%section.frost-section
  .section-header
    %h2= t('frost.title')
    = link_to t('frost.experimental'), '#about-frost-estimates', class: 'frost-section-badge'
  .frost-section-body
    -# The verdict is a note like the weather section's: an icon for how it stands, a bold line and the sentence under it.
    - note = frost_verdict_note(frost.verdict)
    .weather-note{ class: "weather-note--#{note[:level]}", role: 'status', data: { verdict: frost.verdict } }
      %span.weather-note-icons
        %i.fas.weather-note-icon{ class: "fa-#{note[:icon]}", 'aria-hidden': true }
      %div
        %strong= verdict[:title]
        %span= verdict[:body]
    -# The verdict is what most people need; the season and the figures behind it are one click away.
    - unless frost.verdict == :rare
      %details.section-details
        %summary= t('frost.show_details')
        .section-details-body
          = render 'frost/timeline', frost: frost
          .frost-cards
            - frost_cards(frost).each do |card|
              .frost-card
                .frost-card-label= card[:label]
                .frost-card-value= card[:value]
                .frost-card-note= card[:note]
          = render 'frost/credit'
    .frost-about#about-frost-estimates
      %p
        %strong= t('frost.experimental_heading')
        = t('frost.about_estimates')
      = render 'frost/credit' if frost.verdict == :rare

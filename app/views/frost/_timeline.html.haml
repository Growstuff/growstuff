-# The frost danger season on one axis of whole months, with the planting against it when there is one.
- planting = frost_planting?(frost)
.frost-timeline
  %h3= t(planting ? 'frost.timeline.title' : 'frost.timeline.title_place')
  .frost-chart{ role: 'img', 'aria-label': frost_timeline_description(frost) }
    .frost-lanes
      = frost_today_tags(frost)
      .frost-lane-label= t('frost.timeline.row_danger')
      .frost-lane
        = safe_join(frost.danger_bands.map { |band| frost_band_tag(frost, band) })
      - if planting
        .frost-lane-label= t('frost.timeline.row_planting')
        .frost-lane
          = safe_join(frost.planting_bands.map { |band| frost_band_tag(frost, band) })
    - if planting && !frost.long_lived?
      - direction = frost.planted_days_before_usual_end.negative? ? 'after' : 'before'
      %p.frost-annotation= t("frost.timeline.annotation_#{direction}", days: frost_days(frost.planted_days_before_usual_end.abs))
    .frost-axis{ 'aria-hidden': true }= frost_axis_tags(frost)
  %ul.frost-legend
    - (%i(usual possible) + frost.planting_bands.map(&:kind).uniq).each do |kind|
      %li
        %span.frost-key{ class: "frost-band--#{kind}" }
        = t("frost.timeline.legend.#{kind}")

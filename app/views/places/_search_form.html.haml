%form.d-flex.flex-wrap.align-items-center.gap-2{ action: search_places_path, method: :get, role: 'form' }
  .mb-0
    = label_tag :new_place, t('.change_location'), class: 'visually-hidden'
    = text_field_tag :new_place, '', class: 'form-control', placeholder: t('.placeholder')
  = submit_tag t('.search'), class: 'btn btn-primary', id: "search_button"
%br/

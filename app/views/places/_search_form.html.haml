-# Look up another place: the box and its button sit together, and the box is wide enough to read what is typed.
%form.place-search.input-group{ action: search_places_path, method: :get, role: 'search' }
  = label_tag :new_place, t('.change_location'), class: 'visually-hidden'
  = search_field_tag :new_place, nil, class: 'form-control', placeholder: t('.placeholder')
  = submit_tag t('.search'), class: 'btn btn-primary', id: 'search_button'

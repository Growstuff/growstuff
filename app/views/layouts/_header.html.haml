%nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.sticky-top
  %a.navbar-brand{ href: root_path }
    = image_tag("pear.png", class: 'logo', alt: 'Growstuff brand logo (drawing of a pear)')
    .d-none.d-md-block
      %span.site-name Growstuff
  -# On a phone the bar carries what matters most; the rest is in the menu.
  .navbar-phone.d-lg-none
    - if member_signed_in?
      = link_to member_path(current_member), class: 'navbar-phone-avatar', 'aria-label': 'Your profile' do
        = image_tag(avatar_uri(current_member, 50), alt: '', height: 36, width: 36)
    - else
      = link_to t('layouts.menu.sign_in'), new_member_session_path, class: 'navbar-phone-signin'
      = link_to t('layouts.menu.sign_up'), new_member_registration_path, class: 'btn btn-signup navbar-phone-join'
    %button.navbar-phone-button.navbar-search-toggle{ type: 'button', 'aria-label' => 'Search', 'aria-controls' => 'navbarSupportedContent', 'data-bs-target' => '#navbarSupportedContent', 'data-bs-toggle' => 'collapse' }
      %svg{ width: 20, height: 20, viewBox: '0 0 16 16', 'aria-hidden': 'true' }
        %circle{ cx: 6.5, cy: 6.5, r: 4.5, fill: 'none', stroke: 'currentColor', 'stroke-width': 1.6 }
        %path{ d: 'M10 10l4 4', stroke: 'currentColor', 'stroke-width': 1.6, 'stroke-linecap': 'round' }
    %button.navbar-toggler{ "aria-controls" => "navbarSupportedContent", "aria-expanded" => "false", "aria-label" => "Toggle navigation", "data-bs-target" => "#navbarSupportedContent", "data-bs-toggle" => "collapse", type: "button" }
      %span.navbar-toggler-icon
  = render 'layouts/menu'

-# On a phone the + in the top bar slides this sheet up from the bottom. Bootstrap
-# shows every offcanvas inline in an expanded navbar, so it is hidden on a desktop.
#quickAdd.offcanvas.offcanvas-bottom.quick-add.d-lg-none{ tabindex: -1, 'aria-label' => t('layouts.menu.add') }
  .offcanvas-body
    = render 'layouts/add_links', link_class: 'quick-add-link'

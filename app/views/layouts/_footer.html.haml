- cache 'footer', expires: 1.week do
  .container-fluid.text-center.text-md-start
    .row
      .col-md-4#footer1
        %ul
          %li
            = link_to 'https://github.com/Growstuff/growstuff/wiki' do
              = icon 'fas', 'question'
              About
          %li
            = link_to 'https://github.com/Growstuff/growstuff' do
              = icon 'fab', 'github'
              Open Source
          %li
            = link_to 'https://github.com/Growstuff/growstuff/graphs/contributors' do
              = icon 'fas', 'users'
              Growstuff Team
          %li
            = link_to 'https://github.com/Growstuff/growstuff/wiki' do
              = icon 'fas', 'people-carry'
              Get Involved
      .col-md-4#footer2
        %ul
          %li
            = link_to policy_tos_path do
              = icon 'fas', 'file'
              Terms Of Service
          %li
            = link_to policy_privacy_path do
              = icon 'fas', 'user-secret'
              Privacy Policy
          %li
            = link_to policy_data_use_path do
              = icon 'fas', 'database'
              Data Use Policy
          %li
            = link_to policy_community_path do
              = icon 'fas', 'heart'
              Community Guidelines
      .col-md-4#footer3
        .badge.text-bg-success= link_to 'API', '/api-docs'
        %ul
          %li
            = link_to support_path do
              = icon 'fas', 'hands-helping'
              Support
          %li
            = link_to contact_path do
              = icon 'fas', 'envelope'
              Contact
          %li
            = link_to 'https://ko-fi.com/jennyscottthompson', target: '_blank', rel: 'noopener' do
              = icon 'fas', 'dollar-sign'
              Donate - Buy us a coffee
        %div{ style: "float: right;" }
          = link_to "https://opendefinition.org/ossd/" do
            = image_tag 'open_service.png', alt: "Open Service"

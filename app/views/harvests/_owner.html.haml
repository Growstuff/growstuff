.card
  .card-body
    .row
      .col-md-6
        %h4
          = t('.harvested_by_html', owner: link_to(harvest.owner, harvest.owner))
        = link_to t('.view_all', owner: harvest.owner), member_harvests_path(harvest.owner)

        - if harvest.planting.present?
          %p
            = t('.harvested_from_html', planting: link_to(harvest.planting, harvest.planting))
        - if harvest.owner.location
          %p
            %small
              = t('.nearby_html', location: link_to(harvest.owner.location, place_path(harvest.owner.location, anchor: "harvests")))
      .col-md-6= render "members/avatar", member: harvest.owner

-# The same three-dot kebab as every other record page, in the top right of
-# the hero. Each item carries a green line icon; delete is red.
- if can?(:edit, harvest)
  -# One flex item, not three: this sits in the hero's justify-content-between
  -# row, and a loose modal or island beside the dropdown would be distributed
  -# across the row and drag the kebab in off the right edge.
  .record-actions
    = actions_menu('harvest') do
      = menu_modal_link(:edit, t('buttons.edit'), '#harvest-edit-modal')
      = menu_add_photo_link(harvest)
      .dropdown-divider
      = menu_delete_button(harvest)

    -# The dialog the Edit item opens. Outside the dropdown, so it is not torn
    -# down with the menu when it closes.
    = render 'harvests/edit_modal', harvest: harvest

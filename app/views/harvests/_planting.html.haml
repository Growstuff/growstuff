- if @harvest.planting.nil? && @matching_plantings && @matching_plantings.any? && @harvest.owner == current_member
  .alert.alert-info{role: "alert"}
    = bootstrap_form_for(@harvest) do |f|
      = t('.is_this_from')
      - @matching_plantings.each do |planting|
        = f.radio_button :planting_id, planting.id, label: planting
      = f.submit t('.save'), class: 'btn btn-sm'

- if @harvest.planting.present? && @harvest.planting.overall_rating.blank?
  .alert.alert-info{role: "alert"}
    = t('.unrated_notice')
    = link_to t('.rate_planting'), edit_planting_path(@harvest.planting, anchor: "planting_overall_rating"), class: 'alert-link'

- owner = entry.owner
- groups = entry_groups(entry)
- lines = groups.size + entry.photo_groups.size
- images = entry_images(entry)
%article.neighbours-entry
  = link_to image_tag(avatar_uri(owner, 48), alt: '', width: 48, height: 48, class: 'neighbours-avatar'), member_path(owner)
  .neighbours-entry-body
    .neighbours-entry-head
      = link_to owner.login_name, member_path(owner), class: 'fw-bold'
      - if entry.tag
        %span.neighbours-tag{ class: entry.tag }= t(".#{entry.tag}")
      %small= entry_when(entry)
    - if lines == 1
      .neighbours-line
        - if groups.any?
          - kind, garden, items = groups.first
          = group_icon(kind)
          %p= group_sentence(kind, garden, items)
        - else
          = group_icon('photo')
          %p= photo_group_text(*entry.photo_groups.first)
    - else
      %p.neighbours-entry-text= t('.did_things_html', count: entry.items.size)
      %ul.neighbours-entry-list
        - groups.each do |kind, garden, items|
          %li.neighbours-line
            = group_icon(kind)
            %p= group_sentence(kind, garden, items)
        - entry.photo_groups.each do |subject, count, alone|
          %li.neighbours-line
            = group_icon('photo')
            %p= photo_group_text(subject, count, alone)
    - if images.any?
      .neighbours-entry-photos{ class: ('one' if images.one?) }
        - images.each do |image|
          = link_to polymorphic_path(image[:link]) do
            = image_tag image[:url], alt: ''
    - entry.others.select { |item| item.type == 'garden_layout' }.each do |item|
      = render 'layout', garden: item.record, owner:
    - if lines == 1 && entry.others.size <= 1 && (liked = (entry.others.first || entry.photos.first).record).respond_to?(:liked_by?)
      .neighbours-entry-actions= render 'likes/likes', object: liked

- content_for :title, t('.title')

- content_for :breadcrumbs do
  %li.breadcrumb-item= link_to t('layouts.menu.gardens'), gardens_path
  %li.breadcrumb-item.active= t('gardens.nursery_name')

%h1= t('.title')

.mb-4
  = render 'what_is_a_nursery'

.row.row-cols-1.row-cols-md-3.g-3
  .col
    .card.h-100
      .card-body
        %h2.h5.card-title= t('.use_existing')
        - if @candidates.any?
          = form_tag nursery_path, method: :post do
            = label_tag :garden_slug, t('.which_garden'), class: 'form-label'
            = select_tag :garden_slug, options_from_collection_for_select(@candidates, :slug, :name),
                         class: 'form-select mb-3'
            = submit_tag t('.use_this_garden'), class: 'btn btn-primary'
        - else
          %p.card-text.text-muted= t('.no_other_garden')
  .col
    .card.h-100
      .card-body
        %h2.h5.card-title= t('.make_new')
        %p.card-text.text-muted= t('.make_new_text')
        = button_to t('.make_a_nursery'), nursery_path, method: :post, class: 'btn btn-primary'
  .col
    .card.h-100
      .card-body
        %h2.h5.card-title= t('.dont_need')
        %p.card-text.text-muted
          Skip raising seedlings on Growstuff. We won't ask again, and you can change your mind
          from your gardens page.
        = button_to 'No nursery for me', nursery_decline_path, method: :post, class: 'btn btn-outline-secondary'

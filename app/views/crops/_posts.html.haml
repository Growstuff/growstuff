%a{ name: 'posts' }
%h2 What people are saying about #{crop.name.pluralize}

- if @posts.empty?
  %p.text-muted Nobody has posted about #{crop.name.pluralize} yet.
  - unless can? :create, Post
    = render partial: "shared/signin_signup",
            locals: { to: "post your tips and experiences growing #{crop.name.pluralize}" }
- else
  = pagination_nav @pagy

  .index-cards
    - @posts.each do |post|
      .card.card-double= render 'posts/preview', post: post

  = pagination_nav @pagy

-# The action sits at the foot of the section, on the right, whether or not
-# anyone has posted yet.
- if can? :create, Post
  .section-footer
    = link_to "Post something", new_post_path(crop_id: crop.slug), class: 'btn btn-outline-secondary btn-sm'

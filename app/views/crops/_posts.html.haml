%a{ name: 'posts' }
%h2= t('.heading', crop: crop.name.pluralize)

- if @posts.empty?
  %p.text-muted= t('.empty', crop: crop.name.pluralize)
  - unless can? :create, Post
    = render partial: "shared/signin_signup",
            locals: { to: t('.track_posts', crop: crop.name.pluralize) }
- else
  = will_paginate @posts

  .index-cards
    - @posts.each do |post|
      .card.card-double= render 'posts/preview', post: post

  = will_paginate @posts

-# The action sits at the foot of the section, on the right, whether or not
-# anyone has posted yet.
- if can? :create, Post
  .section-footer
    = link_to t('.post_something'), new_post_path(crop_id: crop.slug), class: 'btn btn-outline-secondary btn-sm'

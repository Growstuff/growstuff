%h2 #{photo_icon} Photos
- photos = crop.photos_with_varieties
- [Crop, Planting, Harvest, Seed].each do |model_name|
  - of_model = photos.by_model(model_name)
  - if of_model.any?
    %h3 #{@crop.name.capitalize} #{t("activerecord.models.#{model_name.to_s.downcase}.other")}
    = render 'photos/gallery', photos: of_model.includes(:owner).order(likes_count: :desc, created_at: :desc).limit(5)
- if photos.count.positive?
  .section-footer
    = link_to 'More photos', crop_photos_path(@crop), class: 'btn btn-outline-secondary btn-sm'

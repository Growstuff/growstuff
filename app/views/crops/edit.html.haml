- content_for :title, t('.title', name: @crop.name)

- if @crop.approval_status == "approved"
  - if @crop.requester
    %p
      = t('.requested_by_html', requester_link: link_to(@crop.requester, @crop.requester), time_ago: distance_of_time_in_words(@crop.created_at, Time.zone.now))
    %p
      = t('.approved_by_html', approver_link: link_to(@crop.creator, @crop.creator))
  - else
    %p
      = t('.added_by_html', creator_link: link_to(@crop.creator, @crop.creator), time_ago: distance_of_time_in_words(@crop.created_at, Time.zone.now))
- elsif @crop.approval_status == "pending"
  .alert.alert-danger
    %p
      = t('.requested_by_html', requester_link: link_to(@crop.requester, @crop.requester), time_ago: distance_of_time_in_words(@crop.created_at, Time.zone.now))
    %p
      = t('.status_html', status: @crop.approval_status)
- elsif @crop.approval_status == "rejected"
  .alert.alert-danger
    %p
      = t('.requested_by_html', requester_link: link_to(@crop.requester, @crop.requester), time_ago: distance_of_time_in_words(@crop.created_at, Time.zone.now))
    %p
      = t('.status_by_html', status: @crop.approval_status, creator_link: link_to(@crop.creator, @crop.creator))

= render 'form'

-# The growing facts the predictions cards don't already cover. Fact cards, so
-# they sit in the same grid rather than as a list of their own in the sidebar.
-# Height, spread, row spacing and degree days are rendered by _predictions.
- if crop.sowing_method.present?
  = render 'layouts/fact_card',
    title: 'Sowing method', value: crop.sowing_method, description: nil
- if crop.sun_requirements.present?
  = render 'layouts/fact_card',
    title: 'Sun', value: crop.sun_requirements, description: nil
- if crop.harvests.any?
  - part, frequency = crop.popular_plant_parts.first
  - if part
    = render 'layouts/fact_card',
      title: 'Grown for', value: part[1], description: "harvested #{pluralize(frequency, 'time')}"

-# Sits directly under the crop's name, because it is one of its names.
-# Wranglers edit or delete each one from its own menu; adding is in the crop's
-# actions menu. Both open a dialog.
.scientific_names.crop-sci-names
  - if crop.scientific_names.empty?
    %span.text-muted No scientific name recorded
  - else
    - crop.scientific_names.each do |sn|
      - if can? :edit, sn
        %span.dropdown.d-inline-block
          %a.dropdown-toggle.crop-sci-name{ "aria-expanded" => "false", "data-bs-toggle" => "dropdown", href: '#', role: "button" }= sn.name
          .dropdown-menu
            %a.dropdown-item{ href: "#", "data-bs-toggle" => "modal", "data-bs-target" => "#scientific-name-#{sn.id}" }= t('.edit')
            .dropdown-divider
            = link_to t('.delete'), sn, method: :delete, data: { confirm: 'Are you sure?' }, class: 'dropdown-item text-danger'
      - elsif sn.gbif_key
        = link_to sn.name, "https://www.gbif.org/species/#{sn.gbif_key}", class: 'crop-sci-name', target: "_blank", rel: "noopener noreferrer"
      - else
        %span.crop-sci-name= sn.name
      - if sn.wikidata_id.present?
        = link_to "WD", "https://www.wikidata.org/wiki/#{sn.wikidata_id}", class: 'badge text-bg-info', target: '_blank', rel: 'noopener noreferrer', title: 'Wikidata'

-# Sits directly under the crop's name, because it is one of its names.
-# Wranglers add and edit them from the crop's actions menu, in a dialog.
%p.crop-sci-names
  - if crop.scientific_names.empty?
    %span.text-muted No scientific name recorded
  - else
    - crop.scientific_names.each do |sn|
      - if can? :edit, sn
        %a.crop-sci-name{ href: "#", "data-bs-toggle" => "modal", "data-bs-target" => "#scientific-name-#{sn.id}", title: "Edit #{sn.name}" }= sn.name
      - elsif sn.gbif_key
        = link_to sn.name, "https://www.gbif.org/species/#{sn.gbif_key}", class: 'crop-sci-name', target: "_blank", rel: "noopener noreferrer"
      - else
        %span.crop-sci-name= sn.name
      - if sn.wikidata_id.present?
        = link_to "WD", "https://www.wikidata.org/wiki/#{sn.wikidata_id}", class: 'badge text-bg-info', target: '_blank', rel: 'noopener noreferrer', title: 'Wikidata'

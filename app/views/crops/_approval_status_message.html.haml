- if crop.pending?
  .alert.alert-danger
    %b= t('.pending_title')
    %p= t('.requested_by', requester: crop.requester, time_ago: time_ago_in_words(crop.created_at))
    - unless crop.request_notes.blank?
      %p= t('.request_notes', notes: crop.request_notes)

- if crop.rejected?
  .alert.alert-danger
    %b= t('.rejected_message', reason: crop.rejection_explanation)

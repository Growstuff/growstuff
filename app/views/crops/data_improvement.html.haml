- content_for :title, t('.title')
%h1= t('.title')

- tabs = %i(photos descriptions youtube alternate_names wikidata public_food_key row_spacing sun_requirements height)
- labels = tabs.index_with { |key| t(".tabs.#{key}") }

%ul.nav.nav-tabs
  - labels.each do |key, value|
    %li.nav-item
      = link_to value, data_improvement_crops_path(tab: key), class: ['nav-link', ('active' if @active_tab == key.to_s)], aria: { current: ('page' if @active_tab == key.to_s) }

.tab-content
  .tab-pane.active
    .alert= t('.missing', field: labels[@active_tab.to_sym])
    = render 'crop_list', crops: @crops

    = will_paginate @crops

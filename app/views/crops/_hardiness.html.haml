-# How much frost the crop takes, and where that came from. Nothing at all when we don't know.
- if crop.hardiness != Hardiness::UNKNOWN
  .card.fact-card.growing-fact.hardiness-card
    .card-body.text-center
      %h3= t('.title')
      %strong= t(".levels.#{crop.hardiness}.name")
      %span= t(".levels.#{crop.hardiness}.meaning")
      - if crop.hardiness_source.present?
        %small.crop-fact-median= t(".sources.#{crop.hardiness_source}")
      %small.text-muted= t('frost.experimental')

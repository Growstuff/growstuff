-# The crop search in the top bar: one field with a magnifier inside it, which
-# is also the button that searches.
= form_tag search_crops_path, method: :get, class: 'navbar-search', id: 'navbar-search', role: 'search' do
  %button.navbar-search-submit{ type: 'submit', title: 'Search', 'aria-label' => 'Search' }
    %svg{ width: 16, height: 16, viewBox: '0 0 16 16', 'aria-hidden': 'true' }
      %circle{ cx: 6.5, cy: 6.5, r: 4.5, fill: 'none', stroke: 'currentColor', 'stroke-width': 1.6 }
      %path{ d: 'M10 10l4 4', stroke: 'currentColor', 'stroke-width': 1.6, 'stroke-linecap': 'round' }
  %input.form-control{ name: 'term', 'aria-label' => 'Search crops', placeholder: 'Search crops', type: 'search', id: 'term' }/

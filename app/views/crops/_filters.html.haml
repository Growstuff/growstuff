-# Narrows the crop list: by parent crop for anyone, and by location, season, nearby gardeners, who they follow and what they
-# have grown for members.
- place = current_member&.location_place
= form_tag crops_path, method: :get, class: 'crop-filters card card-body mb-3' do
  .row.g-4
    .col-md-4
      = react_component('CropFilterPicker', { name: 'parent', label: t('.parent'), placeholder: t('.parent_placeholder'), removeLabel: t('.remove'),
        initial: (filter.parent && { id: filter.parent.id, name: filter.parent.name }) })
    - if current_member
      .col-md-5
        = render 'crops/filter_toggles', name: 'season', heading: t('.season'), values: CropFilter::SEASONS, selected: filter.seasons,
          labels: ->(value) { t("seasons.#{value}") }
      .col-md-3
        = render 'crops/filter_toggles', name: 'history', heading: t('.history'), values: CropFilter::HISTORIES,
          selected: Array(params[:history]), labels: ->(value) { t(".history_#{value}") }
      .col-12
        .crop-filter-checks
          - %i(suits nearby friends seeds).each do |key|
            .form-check.form-check-inline
              = check_box_tag key, 1, filter.public_send(:"#{key}?"), class: 'form-check-input', id: "filter_#{key}"
              = label_tag "filter_#{key}", key == :suits && place ? t('.suits_at', place:) : t(".#{key}"), class: 'form-check-label'
    - if filter.wrangler?
      .col-md-4
        = render 'crops/filter_toggles', name: 'ecocrop', heading: t('.ecocrop'), values: CropFilter::ECOCROP_LINKS,
          selected: Array(params[:ecocrop]), labels: ->(value) { t(".ecocrop_#{value}") }
  .crop-filters-footer
    .crop-filter-status
      - if filter.active?
        = link_to t('.clear'), crops_path, class: 'btn btn-link ps-0'
      - if current_member && !current_member.located?
        %p.text-muted.small.mt-2.mb-0
          = t('.needs_location')
          = link_to t('.set_location'), edit_member_registration_path
      - elsif current_member && filter.suiting? && !filter.climate?
        %p.text-muted.small.mt-2.mb-0= t('.no_climate')
      - elsif !current_member
        %p.text-muted.small.mt-2.mb-0
          = t('.sign_in_for_more')
          = link_to t('.sign_in'), new_member_session_path
    .crop-filters-apply
      = submit_tag t('.apply'), name: nil, class: 'btn btn-primary'

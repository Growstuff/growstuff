- missing_attributes = [crop.height, crop.spread, crop.row_spacing, crop.growing_degree_days].any?(&:blank?)
.section-header
  %h2
    -# Decorative: the heading already says what this is.
    %span.heading-emoji{ 'aria-hidden' => 'true' } 🪄
    #{crop.name.capitalize} facts
  - if can?(:wrangle, crop) && missing_attributes
    = link_to 'Add more attributes', edit_crop_path(crop, anchor: ":~:text=Data"), class: 'btn btn-sm section-add'
.index-cards.facts
  - unless crop.perennial.nil?
    .card.fact-card.lifespan-card
      .card-body.text-center
        %h3
          Lifespan
          = editable :select, crop, :perennial, display_field: '.lifespan-display', values: [['Annual', false], ['Perennial', true]]
        .lifespan-display
          = link_to 'https://en.wikipedia.org/wiki/Annual_vs._perennial_plant_evolution', class: 'lifespan-word' do
            = crop.perennial? ? 'Perennial' : 'Annual'
          - if crop.perennial?
            %small living more than two years
          - else
            %small living and reproducing in a single year or less
            - if crop.median_lifespan.present?
              - weeks = in_weeks(crop.median_lifespan)
              .crop-median-lifespan
                %i.far.fa-calendar.fa-2x.amber-text{ 'aria-hidden': 'true' }
                - if weeks > 1
                  %strong #{weeks} #{'week'.pluralize(weeks)}
                  %small median lifespan
                - else
                  %small.text-muted We don't have enough data yet on the median lifespan.

  - if (style = crop.effective_harvest_style)
    = render 'layouts/fact_card',
      title: t('crops.predictions.harvest_style'),
      value: t("crops.harvest_style.#{style}.value"),
      description: t("crops.harvest_style.#{style}.description")
  - if crop.median_days_to_first_harvest.present?
    = render 'layouts/fact_card',
      title: 'First harvest expected',
      value: in_weeks(crop.median_days_to_first_harvest),
      description: "#{'week'.pluralize(in_weeks(crop.median_days_to_first_harvest))} after planting"
  - if crop.annual? && crop.median_days_to_last_harvest.present?
    = render 'layouts/fact_card',
      title: "Last harvest expected",
      value: in_weeks(crop.median_days_to_last_harvest),
      description: "#{'week'.pluralize(in_weeks(crop.median_days_to_last_harvest))} after planting"
  - if (size = size_fact(crop))
    = render 'layouts/fact_card', title: size[:title], value: size[:value], description: nil
  = render 'crops/growing_facts', crop: crop
  - if crop.growing_degree_days.present?
    = render 'layouts/fact_card',
      title: 'Growing Degree Days', value: crop.growing_degree_days, description: nil
  = render 'openfarm_data', crop: crop
= render 'crops/growing_degree_days', crop: crop

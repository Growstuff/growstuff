- missing_attributes = [crop.height, crop.spread, crop.row_spacing, crop.growing_degree_days_figure].any?(&:blank?)
.section-header
  %h2
    -# Decorative: the heading already says what this is.
    %span.heading-emoji{ 'aria-hidden' => 'true' } 🪄
    = t('.title', crop: crop.name.capitalize)
  - if can?(:wrangle, crop) && missing_attributes
    = link_to t('.add_attributes'), edit_crop_path(crop, anchor: ":~:text=Data"), class: 'btn btn-sm section-add'
.index-cards.facts
  - unless crop.perennial.nil?
    .card.fact-card.lifespan-card
      .card-body.text-center
        %h3
          = t('crops.fields.lifespan')
          = editable :select, crop, :perennial, display_field: '.lifespan-display',
            values: [[t('crops.fields.lifespan_annual'), false], [t('crops.fields.lifespan_perennial'), true]]
        .lifespan-display
          = link_to 'https://en.wikipedia.org/wiki/Annual_vs._perennial_plant_evolution', class: 'lifespan-word' do
            = crop.perennial? ? t('crops.fields.lifespan_perennial') : t('crops.fields.lifespan_annual')
          - if crop.perennial?
            %small= t('.perennial_hint')
          - else
            %small= t('.annual_hint')
            - if crop.median_lifespan.present?
              - weeks = in_weeks(crop.median_lifespan)
              .crop-median-lifespan
                %i.far.fa-calendar.fa-2x.amber-text{ 'aria-hidden': 'true' }
                - if weeks > 1
                  %strong= t('.weeks', count: weeks)
                  %small= t('.median_lifespan')
                - else
                  %small.text-muted= t('.insufficient_lifespan_data')

  - if (style = crop.effective_harvest_style)
    = render 'layouts/fact_card',
      title: t('crops.predictions.harvest_style'),
      value: t("crops.harvest_style.#{style}.value"),
      description: t("crops.harvest_style.#{style}.description")
  -# The first and last harvest to expect, together: the last only for an annual, which stops.
  - harvest_rows = []
  - harvest_rows << [t('.first_harvest'), in_weeks(crop.median_days_to_first_harvest)] if crop.median_days_to_first_harvest.present?
  - harvest_rows << [t('.last_harvest'), in_weeks(crop.median_days_to_last_harvest)] if crop.annual? && crop.median_days_to_last_harvest.present?
  - if harvest_rows.any?
    .card.fact-card.growing-fact.harvest-window-card
      .card-body.text-center
        - harvest_rows.each do |label, weeks|
          .crop-sow-hemisphere
            %small= label
            %strong= weeks
            %span= t('.weeks_after_planting', count: weeks)
  - if (size = size_fact(crop))
    = render 'layouts/fact_card', title: size[:title], value: size[:value], description: nil
  = render 'crops/growing_facts', crop: crop
  = render 'crops/hardiness', crop: crop
  - if crop.growing_degree_days_figure
    = render 'layouts/fact_card',
      title: t('.degree_days'), value: crop.growing_degree_days_figure, description: nil
  = render 'openfarm_data', crop: crop
  - ecocrop_facts(crop.ecocrop_data).each do |fact|
    = render 'crops/ecocrop_fact', fact:
= render 'crops/growing_degree_days', crop: crop

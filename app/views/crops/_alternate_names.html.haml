-# Also under the name: what this crop is called elsewhere. Wranglers add and
-# edit them from the crop's actions menu, in a dialog.
- if crop.alternate_names.any?
  %p.crop-alt-names
    %span.text-muted Also known as
    - crop.alternate_names.each do |an|
      - if can? :edit, an
        %a.badge.text-bg-light{ href: "#", "data-bs-toggle" => "modal", "data-bs-target" => "#alternate-name-#{an.id}", title: "Edit #{an.name}" }= "#{an.name} (#{an.language})"
      - else
        %span.badge.text-bg-light= "#{an.name} (#{an.language})"

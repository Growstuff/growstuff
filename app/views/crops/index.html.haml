- content_for :title, t('.title')
- content_for :meta_description, t('.meta_description')

- content_for :buttonbar do
  - if can? :wrangle, Crop
    = link_to t('.wrangle'), wrangle_crops_path, class: 'btn btn-secondary'
  = link_to t('crops.data_improvement.title'), data_improvement_crops_path, class: 'btn btn-info'
  - if can? :create, Crop
    = link_to t('.add_crop'), new_crop_path, class: 'btn btn-primary'

- content_for :breadcrumbs do
  %li.breadcrumb-item.active= link_to t('.crops'), crops_path

%section.crops
  %h2= t('.title')
  = will_paginate @crops
  .index-cards
    - @crops.each do |c|
      = render 'crops/thumbnail', crop: c

  = will_paginate @crops

%ul.list-inline
  %li= t('.formats')
  %li= link_to "CSV", crops_path(format: 'csv')
  %li= link_to "JSON", crops_path(format: 'json')
  %li= link_to "RSS", crops_path(format: 'rss')

-# Sidebar content: the section around it supplies the box and the heading.
-# "You have N seeds of this crop" lived in the counts list that the hero's
-# headline numbers replaced; it belongs here, with the rest of the seeds.
- if member_signed_in?
  %p.mb-2= link_to display_seed_availability(current_member, crop), member_seeds_path(current_member, crop_slug: crop.slug)
- if crop.seeds.empty?
  %p.text-muted= t('.empty')
- else
  %ul.list-group.list-group-flush
    - crop.seeds.tradable.each do |seed|
      %li.list-group-item
        = link_to t('.will_trade', owner: seed.owner, tradable_to: seed.tradable_to), seed_path(seed), class: 'card-link'
        .float-end= render 'members/location', member: seed.owner
    %li.list-group-item.d-flex.justify-content-between.align-items-center
      = link_to crop_seeds_path(crop), class: 'card-link' do
        = seed_icon
        = t('.view_all', crop: crop.name)
      %span.badge.text-bg-primary.rounded-pill= crop.seeds.size

%ul.list-group.list-group-flush
  %li.list-group-item
    = link_to crop_ebay_seeds_url(crop), class: 'card-link', target: "_blank", rel: "noopener noreferrer" do
      = icon 'fas', 'money-check-alt'
      = t('.purchase_via_ebay')
  - if crop.approved?
    - if current_member
      %li.list-group-item
        = link_to new_seed_path(crop_id: crop.id), class: 'card-link', data: { record_dialog: 'seeds', crop_id: crop.id, crop_name: crop.name } do
          = seed_icon
          = t('.list_seeds', crop: crop.name)
    - else
      %li.list-group-item.list-group-item-light
        = icon 'fas', 'user'
        = render partial: 'shared/signin_signup', locals: { to: t('.trade_seeds') }

- content_for :buttonbar do
  - if can? :create, Crop
    = link_to t('.add_new_crop'), new_crop_path, class: 'btn btn-primary'

- content_for :breadcrumbs do
  %li.breadcrumb-item= link_to t('.breadcrumbs_crops'), crops_path
  %li.breadcrumb-item.active= link_to t('.breadcrumbs_search'), search_crops_path(term: @term)

- if @term
  - content_for :title, t('.title_matching', term: @term)
  %h1
    = t('.title_matching', term: @term)
    - if @crops
      %span.text-muted= t('.found_count', count: @crops.total_entries)
- else
  - content_for :title, t('.title')
  %h1= t('.title')

= bootstrap_form_tag(url: search_crops_path, method: :get, html: { id: 'crop-search'}, layout: :inline) do |f|
  = f.label :term, t('.search_crops_label'), class: 'visually-hidden'
  = f.text_field 'term', class: 'search-query input-medium',
                   placeholder: t('.search_crops_placeholder'),
                   label: 'crop',
                   value: @term
  = f.submit t('.search_button'), class: 'btn btn-success'

- if @crops.empty?
  %h2= t('.no_results_title')
  %p= t('.no_results_message', term: @term)
  %p
    - browse_link = link_to(t('.browse_database'), crops_path)
    - if can? :create, Crop
      - add_link = link_to(t('.adding_new_crop'), new_crop_path)
      = t('.try_browsing_or_adding_html', browse_link: browse_link, add_link: add_link)
    - else
      = t('.try_browsing_html', browse_link: browse_link)

- else
  = will_paginate @crops

  .index-cards
    - @crops.each do |crop|
      = render 'crops/thumbnail', crop: crop


  = will_paginate @crops

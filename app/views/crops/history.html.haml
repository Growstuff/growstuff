- content_for :title, t('.title', crop: @crop.name)

%h1= t('.title', crop: @crop.name)

%p
  = link_to t('.back', crop: @crop.name), @crop

- if @versions.empty?
  %p.text-muted= t('.empty')
- else
  .card
    %ul.list-group.list-group-flush
      - @versions.each do |version|
        - next if version.changeset.blank?

        %li.list-group-item
          .d-flex.w-100.justify-content-between
            %h2.h5.mb-1.edit-event= t(".events.#{version.event}", default: version.event.humanize)
            %small= t('.time_ago', time: time_ago_in_words(version.created_at))
          - member = @version_members[version.whodunnit.to_i]
          - if member
            %p.mb-1
              = t('.made_by_html', member: link_to(member.login_name, member))
          = render 'shared/version_changeset', version: version

  = will_paginate @versions

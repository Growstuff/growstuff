- content_for :title, "Edit history of #{@crop.name}"

%h1 Edit history of #{@crop.name}

%p
  = link_to "Back to #{@crop.name}", @crop

- if @versions.empty?
  %p.text-muted This crop has no recorded edits.
- else
  .card
    %ul.list-group.list-group-flush
      - @versions.each do |version|
        - next if version.changeset.blank?

        %li.list-group-item
          .d-flex.w-100.justify-content-between
            %h2.h5.mb-1.edit-event= version.event.humanize
            %small #{time_ago_in_words(version.created_at)} ago
          - member = @version_members[version.whodunnit.to_i]
          - if member
            %p.mb-1
              Made by
              = link_to member.login_name, member
          = render 'shared/version_changeset', version: version

  = pagination_nav @pagy

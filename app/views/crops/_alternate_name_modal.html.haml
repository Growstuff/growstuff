-# Add or edit one alternate name, in a dialog over the crop page. Same shape
-# as the scientific name dialog.
- id = alternate_name.persisted? ? "alternate-name-#{alternate_name.id}" : 'alternate-name-new'
.modal.fade{ id: id, "aria-hidden" => "true", "aria-labelledby" => "#{id}-title", role: "dialog", tabindex: "-1" }
  .modal-dialog{ role: "document" }
    .modal-content
      = form_for alternate_name do |f|
        = f.hidden_field :crop_id, value: crop.id
        .modal-header
          %h4.modal-title{ id: "#{id}-title" }
            = alternate_name.persisted? ? t('.edit_title') : t('.add_title', crop: crop.name)
          %button.btn-close{ "aria-label" => t('.close'), "data-bs-dismiss" => "modal", type: "button" }
        .modal-body
          - if alternate_name.errors.any?
            .alert.alert-danger{ role: 'alert' }
              %ul.mb-0
                - alternate_name.errors.full_messages.each do |message|
                  %li= message
          .mb-3
            = f.label :name, t('.name'), class: 'form-label'
            = f.text_field :name, class: 'form-control', required: true
          .mb-3
            = f.label :language, t('.language'), class: 'form-label'
            -# The same list the full form offers, and a language is required.
            = f.select :language, I18nData.languages.map { |code, name| [name.split(";").first, code] }, { selected: alternate_name.language || 'en' }, class: 'form-select'
        .modal-footer
          %button.btn.btn-secondary{ "data-bs-dismiss" => "modal", type: "button" }= t('.cancel')
          = f.submit t('.save'), class: 'btn btn-primary'

-# What growing degree days are, for a crop that has a figure for them: set by a wrangler, or
-# from the heat it needs according to EcoCrop. Says what we use them for, and what we don't.
- heat = crop.ecocrop_heat_data
- if crop.growing_degree_days.present? || heat
  %details.growing-degree-days-explainer.mt-3
    %summary= t('.summary')
    %p.mt-2= t('.intro')
    %p= t('.example')
    - if crop.growing_degree_days.present?
      %p= t('.needs_html', crop: crop.name.capitalize, degree_days: content_tag(:strong, crop.growing_degree_days))
    - if heat
      %p
        = t('.cycle_html', crop: crop.name,
          tmin: content_tag(:strong, "#{heat.tmin}°C"),
          gmin: heat.gmin,
          degree_days: content_tag(:strong, number_with_precision(heat.first_harvest_degree_days, precision: 0)))
    %p.mb-0= t('.usage', crop: crop.name)

- data = crop.ecocrop_data
- if data
  %section.crop-ecocrop
    .section-header
      %h2 Ecological requirements
    %div
      %p.text-muted.small
        Data from the FAO EcoCrop database for
        %em= data.scientificname
        - if data.auth.present?
          = data.auth
      %table.table.table-sm.table-borderless
        %tbody
          - if data.famname.present?
            %tr
              %th Family / Taxonomy
              %td= safe_join(data.famname.split(':'), tag.br)
          - if data.ktmp.present? || data.ktmpr.present?
            %tr
              %th Killing temperature
              %td
                - parts = []
                - parts << "growth: #{data.ktmp} °C" if data.ktmp.present?
                - parts << "rest: #{data.ktmpr} °C" if data.ktmpr.present?
                = parts.join(', ')
          - if data.lifo.present? && data.lifo.any?
            %tr
              %th Life form
              %td= data.lifo.join(', ')
          - if data.lispa.present? && data.lispa.any?
            %tr
              %th Life span
              %td= data.lispa.join(', ')
          - if data.habi.present? && data.habi.any?
            %tr
              %th Habit
              %td= data.habi.join(', ')
          - if data.dep.present?
            %tr
              %th Optimal soil depth
              %td= data.dep
          - if data.text.present? && data.text.any?
            %tr
              %th Optimal soil texture
              %td= data.text.join(', ')
          - if data.fer.present?
            %tr
              %th Optimal soil fertility
              %td= data.fer
          - if data.dra.present? && data.dra.any?
            %tr
              %th Optimal soil drainage
              %td= data.dra.join(', ')
          - if data.sal.present?
            %tr
              %th Optimal soil salinity
              %td= data.sal
          - if data.photo.present? && data.photo.any?
            %tr
              %th Photoperiod
              %td= data.photo.join(', ')

    .card-footer.text-muted.small
      %p.mb-2
        Licensed under
        = link_to "CC-BY-4.0", "https://creativecommons.org/licenses/by/4.0/", target: "_blank", rel: "noopener noreferrer"
        \.
      %p.mb-0.citation.small
        Food and Agriculture Organization of the United Nations (2025) ECOCROP, the crop ecological requirements database. Version 1.
        = succeed "." do
          = link_to "https://data.apps.fao.org/catalog/dataset/ecocrop", "https://data.apps.fao.org/catalog/dataset/ecocrop", target: "_blank", rel: "noopener noreferrer"
        Accessed through the CGIAR Climate Action Data Hub,
        = succeed "." do
          = link_to "https://cgiar-climate-data-hub.github.io/catalog/ecocrop_1/", "https://cgiar-climate-data-hub.github.io/catalog/ecocrop_1/", target: "_blank", rel: "noopener noreferrer"

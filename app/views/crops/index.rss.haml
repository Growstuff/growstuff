<?xml version="1.0" encoding="UTF-8"?>
%rss{ version: 2.0 }
  %channel
    %title= t('.feed_title', site: ENV.fetch('GROWSTUFF_SITE_NAME', nil))
    %link= crops_url
    - @crops.each do |crop|
      %item
        %title= crop.name
        %pubdate= crop.created_at.to_fs(:rfc822)
        %link= crop_url(crop)
        %guid= crop_url(crop)

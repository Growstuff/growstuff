-# The step-by-step jobs members are offered when they plant this crop: its own
-# templates and, for a variety, those of the crop it is a variety of. Drawn as a
-# notepad, like the jobs a member gets from them.
- templates = crop.published_job_templates.includes(:steps).order(:name)
- if templates.any?
  .crop-job-templates
    - templates.each do |template|
      .crop-notepad
        -# The section's heading already says what this is: a template's own name is
        -# only needed to tell several apart, or to say it is for part of the year.
        - if templates.size > 1 || !template.season_any?
          .crop-notepad-title
            %h3= template.name
            - unless template.season_any?
              %span.crop-notepad-season= crop_job_option(:season, template.season)
        %ol.crop-notepad-steps
          - template.steps.each do |step|
            %li.crop-job-step
              %span.crop-notepad-name
                - if step.external_uri.present?
                  = link_to step.name, step.external_uri, rel: 'nofollow noopener', target: '_blank'
                - else
                  = step.name
              %span.crop-notepad-when= crop_job_when(step)
              - unless step.repeat_once?
                %span.crop-notepad-repeat= crop_job_option(:repeat, step.repeat)
    - if member_signed_in?
      - adder = AddCropJobs.new(current_member, crop)
      - if adder.pending?
        - open_plantings = adder.open_plantings
        - modal = { 'data-bs-toggle': 'modal', 'data-bs-target': '#crop-jobs-modal' }
        - if open_plantings.empty?
          -# No planting to add them to, so go straight to asking which day to plant.
          %button.btn.btn-secondary.crop-job-add{ type: 'button', **modal }
            = menu_icon(:job)
            = t('crop_jobs.add', crop: crop.name)
        - else
          .dropdown.crop-job-add
            %button.btn.btn-secondary.dropdown-toggle{ type: 'button', 'data-bs-toggle': 'dropdown',
                                                       'aria-expanded': 'false' }
              = menu_icon(:job)
              = t('crop_jobs.add', crop: crop.name)
            %ul.dropdown-menu
              - open_plantings.each do |planting|
                - planted = l(planting.planted_at.to_date, format: '%-d %b %Y')
                - name = planting.garden&.name
                - label = t('crop_jobs.add_to_planting', crop: planting.crop.name, garden: name, date: planted)
                %li
                  = button_to crop_jobs_path(crop), params: { planting_id: planting.id }, class: 'dropdown-item' do
                    = menu_icon(:planting)
                    = label
              - if adder.to_come?
                %li
                  %hr.dropdown-divider
                %li
                  %button.dropdown-item{ type: 'button', **modal }
                    = menu_icon(:add)
                    = t('crop_jobs.new_planting', crop: crop.name)
      - else
        %p.crop-job-added.text-muted
          = t('crop_jobs.already_added', crop: crop.name)
          = link_to t('crop_jobs.see_jobs'), jobs_path
      = render 'job_modal', crop: crop, adder: adder if adder.to_come?
    - else
      %p.crop-job-signup
        = link_to 'Sign up to track these tasks and get other suggestions.',
                  new_member_registration_path, data: { auth_dialog: 'sign_up' }

-# The step-by-step jobs members are offered when they plant this crop: its own
-# templates and, for a variety, those of the crop it is a variety of. Drawn as a
-# notepad, like the jobs a member gets from them.
- templates = CropJobTemplate.published.for_crop(crop).includes(:steps).order(:name)
- if templates.any?
  .crop-job-templates
    - templates.each do |template|
      .crop-notepad
        .crop-notepad-title
          %h3= template.name
          - unless template.season_any?
            %span.crop-notepad-season= crop_job_option(:season, template.season)
        %ol.crop-notepad-steps
          - template.steps.each do |step|
            %li.crop-job-step
              %span.crop-notepad-name
                - if step.external_uri.present?
                  = link_to step.name, step.external_uri, rel: 'nofollow noopener', target: '_blank'
                - else
                  = step.name
              %span.crop-notepad-when= crop_job_when(step)
              - unless step.repeat_once?
                %span.crop-notepad-repeat= crop_job_option(:repeat, step.repeat)
    - if member_signed_in?
      - if AddCropJobs.new(current_member, crop).pending?
        = button_to t('crop_jobs.add', crop: crop.name), crop_jobs_path(crop), class: 'btn btn-secondary crop-job-add'
      - else
        %p.crop-job-added.text-muted
          = t('crop_jobs.already_added', crop: crop.name)
          = link_to t('crop_jobs.see_jobs'), jobs_path
    - else
      %p.crop-job-signup
        = link_to 'Sign up to track these tasks and get other suggestions.',
                  new_member_registration_path, data: { auth_dialog: 'sign_up' }

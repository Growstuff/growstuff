- content_for :title, (can?(:wrangle, @crop) ? t('.new_crop') : t('.suggest_crop'))

- unless can? :wrangle, @crop
  %p
    = t('.intro')
  %ul
    %li
      = t('.search_suggestion_html', search_link: link_to(t('.search_our_crops'), search_crops_path))
    %li
      = t('.edible_only')
    %li
      = t('.wikipedia_requirement')

= render 'form'

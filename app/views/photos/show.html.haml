- heading = photo_heading(@photo)
- content_for :title, heading
- content_for :opengraph do
  = tag("meta", property: "og:title", content: heading)
  = tag("meta", property: "og:image", content: @photo.fullsize_url)
  = tag("meta", property: "og:image:user_generated", content: "true")
  = tag("meta", property: "og:type", content: "website")
  = tag("meta", property: "og:url", content: request.original_url)
  = tag("meta", property: "og:site_name", content: ENV['GROWSTUFF_SITE_NAME'])

- content_for :breadcrumbs do
  %li.breadcrumb-item= link_to t('.photos'), photos_path
  %li.breadcrumb-item.active= link_to t('.photo_by', name: photo_credit_name(@photo)), @photo

-# What the photo is, and its menu, top right. Then the photo and what it shows,
-# beside who took it and what it may be used for.
.photo-page-header
  .photo-page-title
    %h1.mb-0= heading
    %small.text-muted
      = @photo.title
      - if @photo.date_taken.present?
        &middot;
        = t('.taken', date: I18n.l(@photo.date_taken.to_date, format: :long))
  = render 'photos/actions', photo: @photo
.photo-page{id: "photo-#{@photo.id}"}
  .photo-page-main
    = render 'photos/polaroid', photo: @photo
    = render 'photos/shows', photo: @photo, crops: @crops
    = render 'photos/comments', photo: @photo
  .photo-page-side
    - if photo_by_outsider?(@photo)
      = render 'photos/photographer_outsider', photo: @photo
    - else
      = render 'photos/photographer', member: @photo.owner
    = render 'photos/licence', photo: @photo

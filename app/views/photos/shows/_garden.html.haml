= link_to garden_path(thing), class: 'shows-card shows-card-other' do
  .shows-card-head
    = garden_icon
    = t('.kind')
  .shows-card-body
    %h3.shows-card-title= thing.to_s
    %span.shows-card-who
      = render 'photos/initial', member: thing.owner, size: 'small'
      = t('.by', owner: thing.owner.to_s)

= link_to harvest_path(thing), class: 'shows-card shows-card-harvest' do
  .shows-card-head
    = harvest_icon
    = t('.kind')
  .shows-card-body
    %h3.shows-card-title= t('.title', crop: thing.crop.name)
    %span.shows-card-who
      = render 'photos/initial', member: thing.owner, size: 'small'
      = t('.by', owner: thing.owner.to_s)
    %span.shows-card-facts
      - if thing.harvested_at.present?
        %span= t('.picked', date: I18n.l(thing.harvested_at))
      - if thing.plant_part_name.present?
        %span= thing.plant_part_name
    %p.mb-0= t('.about')
    %span.btn.shows-card-button.shows-card-button-harvest= t('.go')

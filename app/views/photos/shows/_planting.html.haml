= link_to planting_path(thing), class: 'shows-card shows-card-planting' do
  .shows-card-head
    = planting_icon
    = t('.kind')
  .shows-card-body
    %h3.shows-card-title= thing.display_name
    %span.shows-card-who
      = render 'photos/initial', member: thing.owner, size: 'small'
      = t('.by', owner: thing.owner.to_s)
    %span.shows-card-facts
      - if thing.planted_at.present?
        %span= t('.planted', date: I18n.l(thing.planted_at))
      - if thing.quantity.present?
        %span= t('.plants', count: thing.quantity)
    %p.mb-0= t('.about')
    %span.btn.btn-primary.shows-card-button= t('.go')

%h2
  :ruby
    item = link_to(@item, @item)
    inaturalist = link_to('iNaturalist', 'https://inaturalist.org/', target: '_blank', rel: 'noopener')
    plantnet = link_to('Pl@ntNet', 'https://identify.plantnet.org/', target: '_blank', rel: 'noopener')
  = t('photos.new.sources_html', item: item, inaturalist: inaturalist, plantnet: plantnet)

- if @please_reconnect_flickr
  %h2.alert= t('photos.new.reconnect_heading')

  %p= t('photos.new.token_expired')

  = button_to '/members/auth/flickr', class: "btn btn-lg" do
    = icon 'fab', 'flickr'
    = t('photos.new.reconnect')
- elsif @flickr_auth
  %p
    - account = link_to(@flickr_auth.name, "http://flickr.com/photos/#{@flickr_auth.uid}")
    = t('photos.new.connected_html', account: account)
    = t('photos.new.select_photo')
  %p
    = bootstrap_form_tag(url: new_photo_path, method: :get, layout: :inline) do |f|
      - if @sets.present?
        - albums = options_for_select(@sets, @current_set)
        = f.select :set, albums, label: t('photos.new.album'), include_blank: true
      = f.text_field :tag, value: @current_tag, label: t('photos.new.tag')
      = hidden_field_tag :type, @type
      = hidden_field_tag :id, @id
      = hidden_field_tag :label, @label if @label.present?
      = f.submit t('photos.new.search'), class: "btn btn-success"

  - if @sets && @current_set
    %h2= @sets.key(@current_set)

  .row.pagination
    .col-md-12= page_entries_info @photos
    .col-md-12= will_paginate @photos

  .row
    - @photos.each do |photo|
      .col-md-2.col-6
        .card
          - target = { id: @id, type: @type, label: @label.presence }
          - path = photos_path(photo: { source_id: photo.id, source: 'flickr' }, **target)
          = link_to path, method: :post do
            = image_tag(FlickRaw.url_z(photo), alt: photo.title, class: 'img img-card')
          .card-body= photo.title

  .row.pagination
    .col-md-12= will_paginate @photos
- else
  %h2.alert= t('photos.new.connect_required')

  %p
    = button_to '/members/auth/flickr', class: :btn do
      = icon 'fab', 'flickr'
      = t('photos.new.connect')

-# On a seed's own page: whether each of its photos is of the packet, and which
-# side. Everyone sees what it is; the seed's owner can change it.
- label = seed.label_of(photo)
.packet-label.small.mt-1
  - if label
    %span.badge.text-bg-secondary= t("seeds.packet.label_#{label}")
  - if can?(:update, seed)
    - PhotoAssociation::LABELS['Seed'].without(label).each do |choice|
      = link_to t("seeds.packet.mark_#{choice}"), packet_label_path(seed, photo, choice), method: :patch, class: 'me-2'
    - not_packet_path = packet_label_path(seed, photo, '')
    = link_to t('seeds.packet.not_packet'), not_packet_path, method: :patch, class: 'me-2' if label

%h1
  - if @crop
    Photos of #{@crop.name}
  - elsif @planting.present?
    Photos of #{@planting}
  - else
    Most recent photos added to #{ENV['GROWSTUFF_SITE_NAME']}.

- content_for :breadcrumbs do
  %li.breadcrumb-item= link_to 'Photos', photos_path

= pagination_nav @pagy

.index-cards
  - @photos.each do |p|
    = render 'photos/card', photo: p

= pagination_info @pagy, "photos"
= pagination_nav @pagy

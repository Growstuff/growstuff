:ruby
  title = if @crop
    t('.photos_of', subject: @crop.name)
  elsif @planting.present?
    t('.photos_of', subject: @planting)
  else
    t('.recent', site: ENV.fetch('GROWSTUFF_SITE_NAME', nil))
  end
- content_for :title, title

%h1= title

- content_for :breadcrumbs do
  %li.breadcrumb-item= link_to t('.photos'), photos_path

= will_paginate @photos

.index-cards
  - @photos.each do |p|
    = render 'photos/card', photo: p

= page_entries_info @photos
= will_paginate @photos

-# What the photo shows: a card for each record it is attached to, headed with the
-# kind of record, so you can follow the photo back to it.
- records = %i(plantings harvests seeds gardens posts jobs).flat_map { |kind| photo.public_send(kind).map { |thing| [kind, thing] } }
%section.photo-shows
  %h2.photo-shows-heading= t('.heading')
  %p.text-muted
    = photo_by_outsider?(photo) ? t('.outsider_intro', site: photo.source.to_s.titleize) : t('.intro')
  .photo-shows-cards
    - records.each do |kind, thing|
      .photo-shows-item
        = render "photos/shows/#{kind.to_s.singularize}", thing: thing
        = render 'photos/association_delete_button', photo: photo, type: kind.to_s.singularize, thing: thing
    - crops.each do |crop|
      .photo-shows-item.photo-shows-item-wide
        = render 'photos/shows/crop', crop: crop, outsider: photo_by_outsider?(photo)
        = render 'photos/association_delete_button', photo: photo, type: 'crop', thing: crop

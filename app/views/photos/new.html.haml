- content_for :title, t('.title')

%h1= t('.title')
%h2
  :ruby
    item = link_to(@item, @item)
    inaturalist = link_to('iNaturalist', 'https://inaturalist.org/', target: '_blank', rel: 'noopener')
    plantnet = link_to('Pl@ntNet', 'https://identify.plantnet.org/', target: '_blank', rel: 'noopener')
  = t('.sources_html', item: item, inaturalist: inaturalist, plantnet: plantnet)

- if @please_reconnect_flickr
  %h2.alert= t('.reconnect_heading')

  %p= t('.token_expired')

  = button_to '/members/auth/flickr', class: "btn btn-lg" do
    = icon 'fab', 'flickr'
    = t('.reconnect')


- elsif @flickr_auth
  %p
    = t('.connected_html', account: link_to(@flickr_auth.name, "http://flickr.com/photos/#{@flickr_auth.uid}"))
    = t('.select_photo')


  %p
    = bootstrap_form_tag(url: new_photo_path, method: :get, layout: :inline) do |f|
      - if @sets && !@sets.empty?
        = f.select :set, options_for_select(@sets, @current_set), label: t('.album'), include_blank: true
      = f.text_field :tag, value: @current_tag, label: t('.tag')
      = hidden_field_tag :type, @type
      = hidden_field_tag :id, @id
      = hidden_field_tag :label, @label if @label.present?
      = f.submit t('.search'), class: "btn btn-success"

  - if @sets && @current_set
    %h2= @sets.key(@current_set)

  .row.pagination
    .col-md-12= page_entries_info @photos
    .col-md-12= will_paginate @photos

  .row
    - @photos.each do |photo|
      .col-md-2.col-6
        .card
          = link_to photos_path(photo: { source_id: photo.id, source: 'flickr' }, id: @id, type: @type, label: @label.presence), method: :post do
            = image_tag(FlickRaw.url_z(photo), alt: photo.title, class: 'img img-card')
          .card-body= photo.title

  .row.pagination
    .col-md-12= will_paginate @photos
- else
  %h2.alert= t('.connect_required')

  %p
    = button_to '/members/auth/flickr', class: :btn do
      = icon 'fab', 'flickr'
      = t('.connect')

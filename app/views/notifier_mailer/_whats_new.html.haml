-# What we've added since we last emailed this member; see NewFeatures.
%section.whats-new
  %h2 New since we last emailed you
  %p We have #{pluralize(features.size, 'new feature')} to tell you about:
  %ul
    - features.each do |feature|
      %li
        %b= link_to feature.title, feature.url(@member, self)
        &ndash; #{feature.description}

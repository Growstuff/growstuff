%p
  = t('notifier_mailer.shared.greeting', login_name: @member.login_name)

%p
  = t('notifier_mailer.crop_request.new_intro', login_name: @request.requester.login_name, sitename: ENV['GROWSTUFF_SITE_NAME'])

%ul
  %li= t('notifier_mailer.crop_request.name', name: @request.name)
  %li= t('notifier_mailer.crop_request.wikipedia_url', url: @request.en_wikipedia_url.presence || t('notifier_mailer.crop_request.not_specified'))
  %li= t('notifier_mailer.crop_request.notes', notes: @request.request_notes)

%p
  = t('notifier_mailer.crop_request.wrangler_prompt', link: link_to(t('notifier_mailer.crop_request.approve_or_reject'), edit_crop_url(@request))).html_safe

%p
  = t('notifier_mailer.crop_request.thanks')

= render partial: 'signature'

%p= t('notifier_mailer.shared.greeting', login_name: @member.login_name)

%p
  = t('notifier_mailer.crop_request.approved_intro', link: link_to(@crop.name, crop_url(@crop))).html_safe

%ul
  %li
    = link_to t('notifier_mailer.crop_request.plant_crop', crop_name: @crop.name), new_planting_url(crop_id: @crop.id)
  %li
    = link_to t('notifier_mailer.crop_request.harvest_crop', crop_name: @crop.name), new_harvest_url(crop_id: @crop.id)
  %li
    = link_to t('notifier_mailer.crop_request.stash_crop', crop_name: @crop.name), new_seed_url(crop_id: @crop.id)

= render partial: 'signature'

%p= t('notifier_mailer.shared.greeting', login_name: @member.login_name)

%h2= t('notifier_mailer.harvest_reminder.heading')

%p= t('notifier_mailer.harvest_reminder.intro')

%ul
  - @plantings.each do |planting|
    %li
      = render 'planting', planting: planting
      = t('notifier_mailer.harvest_reminder.predicted_date', date: l(planting.first_harvest_predicted_at.to_date))

%p= t('notifier_mailer.shared.harvest_question')
%p
  = link_to t('notifier_mailer.shared.record_harvest'), root_url, class: 'btn'

%p= t('notifier_mailer.shared.garden_overview_intro')
%p
  = link_to member_gardens_url(@member), class: 'btn' do
    = t('notifier_mailer.shared.garden_overview')
%p
  = t('notifier_mailer.shared.or_on')
  = link_to member_url(@member) do
    = t('notifier_mailer.shared.profile_page')

%h4= t('notifier_mailer.shared.see_you_soon', sitename: @sitename)

= render partial: 'signature'

%hr/
%p
  = t('notifier_mailer.harvest_reminder.unsubscribe_prompt')
  = link_to t('notifier_mailer.harvest_reminder.unsubscribe'), unsubscribe_member_url(message: @signed_message)

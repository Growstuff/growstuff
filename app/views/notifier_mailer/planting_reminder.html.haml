%p= t('notifier_mailer.shared.greeting', login_name: @member.login_name)

%h2= t('notifier_mailer.planting_reminder.heading', sitename: @sitename)

- if @outlook.new_features.any?
  = render 'whats_new', features: @outlook.new_features

= render 'outlook', outlook: @outlook

- if @member.plantings.empty?
  %p= t('notifier_mailer.planting_reminder.empty_intro', sitename: @sitename)
  %p
    = link_to t('notifier_mailer.planting_reminder.get_started'), new_planting_url
    = t('notifier_mailer.planting_reminder.by_planting')

- else
  - if @harvesting.size.positive?
    %section.harvests
      %h2= t('notifier_mailer.planting_reminder.ready_to_harvest')
      %p= t('notifier_mailer.planting_reminder.congratulations')
      %ul
        - @harvesting.each do |planting|
          %li= render 'planting', planting: planting

  - if @others.size.positive?
    %section.progress
      %h2= t('notifier_mailer.planting_reminder.progress_report')
      %ul
        - @others.each do |planting|
          %li
            = render 'planting', planting: planting
            = t('notifier_mailer.planting_reminder.progress_status', percentage: sprintf('%.0f', planting.percentage_grown), days: (planting.finish_predicted_at - Time.zone.today).to_i)

  - if @late.size.positive?
    %section.late
      %h2= t('notifier_mailer.planting_reminder.late')
      %p
        = t('notifier_mailer.planting_reminder.late_intro', login_link: link_to(t('notifier_mailer.planting_reminder.log_in'), new_member_session_url)).html_safe
      %ul
        - @late.each do |planting|
          %li= render 'planting', planting: planting

  - if @super_late.size.positive?
    %section.superlate
      %h2= t('notifier_mailer.planting_reminder.super_late')
      %p= t('notifier_mailer.planting_reminder.super_late_intro')
      %ul
        - @super_late.each do |planting|
          %li
            = render 'planting', planting: planting
            = t('notifier_mailer.planting_reminder.planted_on', date: l(planting.planted_at.to_date))

%p= t('notifier_mailer.shared.harvest_question')
%p
  = link_to t('notifier_mailer.shared.record_harvest'), root_url, class: 'btn'

%p= t('notifier_mailer.planting_reminder.planting_question')
%p
  = link_to t('notifier_mailer.planting_reminder.add_planting'), root_url, class: 'btn'

%p= t('notifier_mailer.shared.garden_overview_intro')
%p
  = link_to member_gardens_url(@member), class: 'btn' do
    = t('notifier_mailer.shared.garden_overview')
%p
  = t('notifier_mailer.shared.or_on')
  = link_to member_url(@member) do
    = t('notifier_mailer.shared.profile_page')

%h4= t('notifier_mailer.shared.see_you_soon', sitename: @sitename)

= render partial: 'signature'

%hr/
%p
  = t('notifier_mailer.planting_reminder.unsubscribe_prompt')
  = link_to t('notifier_mailer.planting_reminder.unsubscribe'), unsubscribe_member_url(@signed_message)

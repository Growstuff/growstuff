-# Season, weather and crops to sow for where the member gardens, or else a nudge to say where that is.
- if outlook.located?
  %section.outlook
    %h2= t('notifier_mailer.outlook.heading')
    %p
      = t('notifier_mailer.outlook.season_intro', season: (outlook.season ? t("seasons.#{outlook.season}") : ''))
      - if outlook.place
        = t('notifier_mailer.outlook.season_place', place: outlook.place)
    - if outlook.soil
      - soil = weather_summary([outlook.soil])[:soil_temp]
      %p= t('notifier_mailer.outlook.soil_temp', soil: soil, date: l(outlook.soil.date, format: '%-d %B'))
    - if outlook.recent.any? && (figures = weather_figures(weather_summary(outlook.recent)))
      %p= t('notifier_mailer.outlook.recent_weather', from: l(outlook.recent.first.date, format: '%-d %B'), to: l(outlook.recent.last.date, format: '%-d %B'), figures: figures)
    - if outlook.expected.any? && (figures = weather_figures(weather_summary(outlook.expected)))
      %p= t('notifier_mailer.outlook.expected_weather', figures: figures)
    - if outlook.crops.any?
      %h3= t('notifier_mailer.outlook.worth_sowing')
      %p= t('notifier_mailer.outlook.planting_at_latitude')
      %ul
        - outlook.crops.each do |crop|
          %li= link_to crop.name, crop_url(crop)
- else
  %section.outlook
    %p= t('notifier_mailer.outlook.unlocated_prompt')
    %p
      = link_to t('notifier_mailer.outlook.set_location'), root_url, class: 'btn'

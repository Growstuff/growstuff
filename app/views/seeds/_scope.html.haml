-# Whose seeds to look at. Only offered to a signed-in member, since three of
-# the four depend on who they are.
- if current_member
  .seed-scope-row
    .seed-scope{ role: 'group', 'aria-label': t('seeds.ui.whose_seeds') }
      - mine = @owner == current_member
      - scope = params[:scope]
      = link_to t('seeds.ui.mine'), seed_view_path(path: member_seeds_path(current_member), scope: nil, within: nil), class: ('active' if mine)
      = link_to t('seeds.ui.following'), seed_view_path(path: seeds_path, scope: 'following'), class: ('active' if @owner.blank? && scope == 'following')
      = link_to t('seeds.ui.near_me'), seed_view_path(path: seeds_path, scope: 'near'), class: ('active' if @owner.blank? && scope == 'near')
      = link_to t('seeds.ui.everyone'), seed_view_path(path: seeds_path, scope: nil), class: ('active' if @owner.blank? && scope.blank?)
    - if can?(:create, Seed)
      = link_to t('seeds.ui.add_seeds'), new_seed_path(crop_id: @crop&.id), class: 'btn btn-primary btn-sm', data: { record_dialog: 'seeds', crop_id: @crop&.id, crop_name: @crop&.name }

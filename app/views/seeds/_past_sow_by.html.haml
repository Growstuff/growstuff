-# Seed past its sow-by year often still grows; this says so, and lets a
-# gardener see which packets they are.
- if params[:past] == '1'
  .seed-tip
    %div
      %b= t('.showing')
    = link_to t('.show_all'), seed_view_path(past: nil)
- else
  .seed-tip
    %div
      %b= t('.count', count: @past_count)
      = t('.hint')
    = link_to t('.show_those', count: @past_count), seed_view_path(past: 1)

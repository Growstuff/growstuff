-# What the packet says about sowing, for the forms that edit all of a packet at once.
.mb-3
  %label.form-label= t('seeds.ui.when_to_sow')
  = render 'seeds/sow_months_field', model: seed, prefix: prefix
.row.mb-3
  .col-md-6
    = f.number_field :germination_days_min, min: 0, label: t('seeds.ui.germination_min')
  .col-md-6
    = f.number_field :germination_days_max, min: 0, label: t('seeds.ui.germination_max')
.mb-3
  = f.text_area :how_to_sow, rows: 3, label: t('seeds.ui.how_to_sow')

- content_for :breadcrumbs do
  - if @owner
    %li.breadcrumb-item= link_to 'Seeds', seeds_path
    %li.breadcrumb-item.active= link_to "#{@owner}'s seeds", member_seeds_path(@owner)
  - else
    %li.breadcrumb-item.active= link_to 'Seeds', seeds_path

- content_for :title, title('seeds', @owner, @crop, @planting)
- content_for :meta_description, "Browse and search for seeds."

%header.seed-header
  %h1
    = seed_icon
    = title('seeds', @owner, @crop, @planting)
  .seed-header-actions
    - if current_member.present?
      %ul.nav.nav-pills.seed-scope
        %li.nav-item= link_to 'Mine', member_seeds_path(current_member), class: ['nav-link', ('active' if @owner == current_member)]
        %li.nav-item= link_to 'Everyone', seeds_path, class: ['nav-link', ('active' if @owner.blank?)]
      - if can?(:create, Seed)
        = link_to 'Add seeds', new_seed_path, class: 'btn btn-primary'
    - else
      = render 'shared/signin_signup', to: 'record your seeds'
- if @owner || @crop
  = render 'seeds/context'

%section
  %ul.nav.nav-tabs.seed-tabs
    %li.nav-item
      = link_to url_for(finished: nil, all: nil, page: nil), class: ['nav-link', ('active' unless @show_finished || @show_all)] do
        In stock
        %small= @in_stock_count
    %li.nav-item
      = link_to url_for(finished: 1, all: nil, page: nil), class: ['nav-link', ('active' if @show_finished)] do
        Finished
        %small= @finished_count
  %ul.seed-chips
    - shared = Seed::TRADABLE_TO_VALUES - ['nowhere']
    %li= link_to 'All', url_for(tradeable_to: nil, page: nil), class: ['seed-chip', ('active' if params[:tradeable_to].blank?)]
    %li= link_to 'Shared with others', url_for(tradeable_to: shared, page: nil), class: ['seed-chip', ('active' if params[:tradeable_to].is_a?(Array))]
    - shared.each do |value|
      %li= link_to value.capitalize, url_for(tradeable_to: value, page: nil), class: ['seed-chip', ('active' if params[:tradeable_to] == value)]
  - if @crop && !member_signed_in?
    %p
      = link_to 'Sign in', new_member_session_path
      or
      = link_to 'sign up', new_member_registration_path
      to see seed traders near you.
  - elsif @sort_by_distance
    %p.text-muted Sorted by distance from your location.
  = will_paginate @seeds
  - if @seeds.blank? && @query.blank?
    %p No seeds recorded yet
  = form_tag url_for, method: :get, class: 'seed-search', role: 'search' do
    - { group: params[:group], view: params[:view], finished: params[:finished] }.compact_blank.each do |name, value|
      = hidden_field_tag name, value
    = label_tag :q, 'Search seeds', class: 'visually-hidden'
    = search_field_tag :q, @query, placeholder: 'Search seeds by crop', class: 'form-control'
    = submit_tag 'Search', name: nil, class: 'btn btn-primary'
  - if @query.present?
    = render 'seeds/search_summary'
  .seed-controls
    %div
      %span.seed-controls-label Group by
      .seed-seg{ role: 'group', 'aria-label': 'Group by' }
        - { 'crop' => 'Crop', 'source' => 'Where from', 'year' => 'Year saved', 'heirloom' => 'Heirloom or hybrid' }.each do |key, label|
          = link_to label, url_for(group: key, page: nil), class: ('active' if @group_by == key)
    .seed-seg{ role: 'group', 'aria-label': 'View as' }
      = link_to 'Cards', url_for(view: nil, page: nil), class: ('active' unless @list_view)
      = link_to 'List', url_for(view: 'list', page: nil), class: ('active' if @list_view)
  - if @seeds.blank? && @query.present?
    = render 'seeds/none'
  - elsif @list_view
    = render 'seeds/list', shelves: @shelves
  - else
    - @shelves.each do |shelf, seeds|
      = render 'seeds/shelf', shelf: shelf, seeds: seeds, owned: @owner.present? && @owner == current_member, everyone: @everyone

  = will_paginate @seeds

  %section.open-data
    %h2 Open Data
    %p= t('label.data')
    - ['csv', 'json', 'rss'].each do |format|
      .badge.text-bg-info
        = link_to (@owner ? member_seeds_path(@owner, format: format) : seeds_path(format: format)) do
          = icon 'fas', format.to_s
          = format.upcase
    .badge.text-bg-success= link_to 'API Methods', '/api-docs'

.card
  .card-body
    .row
      .col-md-8
        %h4
          = t('seeds.ui.saved_by_html', owner: link_to(@seed.owner, @seed.owner))
        = link_to t('seeds.ui.view_all', owner: @seed.owner), member_seeds_path(@seed.owner)

      .col-md-4= render "members/avatar", member: @seed.owner
    .row
      .col-12
        - if @seed.owner.location
          %p
            %small
              = t('seeds.ui.nearby_html', location: link_to(@seed.owner.location, place_path(@seed.owner.location, anchor: "seeds")))

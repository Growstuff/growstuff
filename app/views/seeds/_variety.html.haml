-# One variety in everyone's seeds, as a packet with a pile behind it: the pile
-# is the gardeners who share it. The packet shown is the nearest one.
- nearest = nearest_first(packets).first
- gardeners = packets.map(&:owner_id).uniq.size
- crop = nearest.crop
- open_path = url_for(open: crop.id, page: nil, anchor: "variety-#{crop.id}")
- opened = (crop.id == @open_crop_id)
- where = [nearest.owner_login_name, nearest.owner_location&.split(',')&.first].compact_blank.join(' · ')
.seed-stack.seed-variety{ id: "variety-#{crop.id}", class: ('seed-variety-open' if opened) }
  .seed-stack-pile{ class: ('seed-stack-pile-single' if gardeners == 1) }
    - if @owned_crop_ids.include?(crop.id)
      %span.seed-have-it You have it
    .seed-packet
      .seed-packet-tear{ 'aria-hidden' => 'true' }
      = link_to image_tag(nearest.thumbnail_url || placeholder_image, alt: crop.name, class: 'seed-packet-window'), open_path
      %h4.seed-packet-name= link_to crop.name, open_path
      - if nearest.heirloom != 'unknown'
        %p
          %span.seed-pill{ class: "seed-pill-#{nearest.heirloom}" }= nearest.heirloom.capitalize
      %p.seed-packet-who= link_to (opened ? 'Close ▴' : "#{pluralize gardeners, 'gardener'} ▸ see who"), (opened ? url_for(open: nil, page: nil, anchor: "variety-#{crop.id}") : open_path)
      .seed-packet-rule= ["nearest: #{where}", seed_distance(nearest)].compact_blank.join(', ')

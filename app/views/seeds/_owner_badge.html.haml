-# Whose packet it is: their avatar, small, beside the packet. Hover for who they
-# are and how far away.
- label = seed_owner_label(seed)
= link_to member_path(seed.owner), class: 'seed-owner', title: label, 'aria-label': label do
  = image_tag avatar_uri(seed.owner, 32), alt: '', width: 32, height: 32

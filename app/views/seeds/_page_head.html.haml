-# The top of the page: whose library it is and what is in it, which crop's
-# seeds these are with the ways to plant or save it, or what the page is for.
%header.seed-head
  - if @owner
    = link_to image_tag(avatar_uri(@owner, 72), alt: @owner.login_name, width: 72, height: 72, class: 'seed-head-image'), member_path(@owner)
  - elsif @crop
    = link_to image_tag(crop_image_path(@crop), alt: t('seeds.ui.crop_image_alt', crop: @crop.name), width: 72, height: 72, class: 'seed-head-image'), crop_path(@crop)
  .seed-head-about
    - if @owner
      %h1
        = t('seeds.ui.owner_library_html', owner: content_tag(:span, link_to(@owner.login_name, member_path(@owner)), class: 'login-name'))
      .seed-head-sub= @owner.location
    - elsif @crop
      %h1= link_to t('seeds.ui.crop_seeds', crop: @crop.name), crop_path(@crop)
      .seed-head-sub= @crop.default_scientific_name
    - elsif @planting
      %h1= title('seeds', nil, nil, @planting)
    - else
      %h1= t('seeds.ui.seeds')
      .seed-head-sub= t('seeds.ui.shared_seeds')
  - if @stats
    %ul.seed-head-stats
      - %i[packets varieties crops own].each do |key|
        %li
          %b= @stats[key]
          = t("seeds.ui.stats.#{key}", count: @stats[key])
  - elsif @crop && member_signed_in?
    .seed-head-actions
      = render 'plantings/modal', planting: Planting.new(crop: @crop, owner: current_member)
      = render 'seeds/modal', seed: Seed.new(crop: @crop, owner: current_member)

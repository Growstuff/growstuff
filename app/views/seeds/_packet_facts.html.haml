-# What a packet says: the first half of the packet sheet's list, in the order it is read
-# and sown in. The rest is ours: when it was saved, and whether it can be traded.
= render layout: 'seeds/fact_row',
         locals: { seed:, label: t('seeds.ui.variety'), display: 'variety', muted: seed.variety.blank?,
                   edit: [:text_field, :variety] } do
  %strong= seed.variety.presence || t('seeds.ui.not_specified')

= render layout: 'seeds/fact_row',
         locals: { seed:, label: t('seeds.ui.batch_number'), display: 'batchnumber', muted: seed.batch_number.blank?,
                   edit: [:text_field, :batch_number] } do
  %strong= seed.batch_number.presence || t('seeds.ui.not_specified')

= render layout: 'seeds/fact_row',
         locals: { seed:, label: t('seeds.ui.quantity'), display: 'quantity', muted: seed.quantity.blank?,
                   edit: [:text_field, :quantity] } do
  %strong= seed.quantity.presence || t('seeds.ui.not_specified')
  %span= t('seeds.ui.seed_unit', count: seed.quantity || 0)

= render layout: 'seeds/fact_row',
         locals: { seed:, label: t('seeds.ui.when_to_sow'), display: 'sowmonths', muted: seed.sow_months.empty?,
                   edit: ['seeds/sow_months_field', :sow_months] } do
  %strong= sow_months_text(seed.sow_months) || t('seeds.ui.not_specified')

= render layout: 'seeds/fact_row',
         locals: { seed:, label: t('seeds.ui.how_to_sow'), display: 'howtosow', muted: seed.how_to_sow.blank?,
                   edit: [:text_area, :how_to_sow] } do
  %strong.how-to-sow= seed.how_to_sow.presence || t('seeds.ui.not_specified')

= render layout: 'seeds/fact_row',
         locals: { seed:, label: t('seeds.ui.germination'), display: 'germination',
                   muted: seed.germination_days_min.blank? && seed.germination_days_max.blank?,
                   edit: [:number_range, %i(germination_days_min germination_days_max)] } do
  %strong= days_range_text(seed.germination_days_min, seed.germination_days_max) || t('seeds.ui.unknown')
  %span= t('seeds.ui.days')

= render layout: 'seeds/fact_row',
         locals: { seed:, label: t('seeds.ui.maturity'), display: 'maturity',
                   muted: seed.days_until_maturity_max.blank?,
                   edit: [:number_range, %i(days_until_maturity_min days_until_maturity_max)] } do
  %strong= render partial: 'days_until_maturity', locals: { seed: seed }
  %span= t('seeds.ui.days')

= render layout: 'seeds/fact_row',
         locals: { seed:, label: t('seeds.ui.row_spacing'), display: 'rowspacing', muted: seed.row_spacing.blank?,
                   edit: [:number_field, :row_spacing] } do
  %strong= seed.row_spacing.presence || t('seeds.ui.not_specified')
  %span= t('seeds.ui.cm')

= render layout: 'seeds/fact_row',
         locals: { seed:, label: t('seeds.ui.plant_before'), display: 'plantbefore', muted: seed.plant_before.blank?,
                   edit: [:number_field, :plant_before_year], values: Seed::PLANT_BEFORE_YEARS } do
  %strong= seed.plant_before.present? ? seed.plant_before.year : t('seeds.ui.unknown')

= render layout: 'seeds/fact_row',
         locals: { seed:, label: t('seeds.ui.heirloom_or_hybrid'), display: 'heirloom', muted: seed.heirloom_kind.blank?,
                   edit: [:select, :heirloom], values: Seed::HEIRLOOM_VALUES } do
  %strong= seed.heirloom_kind&.capitalize || t('seeds.ui.unknown')

-# What the packet claims. 'unknown' is the model's own "don't know", so it reads quietly.
- organic = seed.organic.presence || 'unknown'
= render layout: 'seeds/fact_row',
         locals: { seed:, label: t('seeds.ui.organic'), display: 'organic', muted: organic == 'unknown',
                   edit: [:select, :organic], values: Seed::ORGANIC_VALUES } do
  %strong= organic == 'unknown' ? t('seeds.ui.unknown') : organic.upcase_first

- gmo = seed.gmo.presence || 'unknown'
= render layout: 'seeds/fact_row',
         locals: { seed:, label: t('seeds.ui.gmo'), display: 'gmo', muted: gmo == 'unknown',
                   edit: [:select, :gmo], values: Seed::GMO_VALUES } do
  %strong= gmo == 'unknown' ? t('seeds.ui.unknown') : gmo.upcase_first

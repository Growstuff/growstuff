#modelSeedForm.modal.fade{"aria-hidden" => "true", "aria-labelledby" => "myModalLabel", role: "dialog", tabindex: "-1"}
  .modal-dialog{role: "document"}
    .modal-content
      .modal-header.text-center
        %h4.modal-title.w-100.fw-bold
          = seed_icon
          = t('seeds.ui.save_crop_seeds', crop: seed.crop.name)
        %button.btn-close{"aria-label" => t('seeds.ui.close'), "data-bs-dismiss" => "modal", type: "button"}

      .modal-body
        %h4= t('seeds.ui.adding_seeds')

        %h5= t('seeds.ui.offer_trade')

        %hr/
        %p= t('seeds.ui.trade_from', location: current_member.location)

        .btn-group.d-grid.flex-column{"aria-label" => t('seeds.ui.trade_label'), role: "group"}
          - Seed::TRADABLE_TO_VALUES.reverse.each do |scope|
            - unless scope == 'nowhere'
              = button_to seeds_path(seed: {crop_id: seed.crop_id, tradable_to: scope}), method: :post, class: 'btn col-12' do
                = t("seeds.ui.trade_scopes.#{scope}")

        %hr/
        %p
          = icon('fas', 'no')
          = t('seeds.ui.no_trade')
        = button_to seeds_path(seed: {crop_id: seed.crop_id, tradable_to: 'nowhere'}), method: :post, class: 'btn' do
          = t('seeds.ui.save_crop_seeds', crop: seed.crop_name)


%a.btn{"data-bs-target" => "#modelSeedForm", "data-bs-toggle" => "modal", href: ""}
  = seed_icon
  = t('seeds.ui.save_seeds')

-# The packet sheet: the facts of a packet of seed as a plain list, with what the
-# packet itself says beside it, so the one can be checked against the other. The
-# pencils edit a fact in its place; "Edit all" swaps the whole list for a form,
-# in the same place, and the packet stays beside it. Where the packet came from
-# is the ribbon on the hero photo, not a row here. See DESIGN.md.
- panel = render('seeds/packet_panel', seed: seed)
.packet-sheet.row{ data: { packet_sheet: '' } }
  %div{ class: panel.present? ? 'col-lg-6' : 'col-12' }
    %section.packet-sheet-main
      .section-header
        %h2 The packet
        - if can?(:edit, seed)
          %button.btn.btn-sm.section-add.packet-sheet-edit-all{ type: 'button', data: { packet_sheet_edit: '' } } Edit all

      %dl.packet-facts
        = render 'seeds/packet_facts', seed: seed

        -# A packet records the year its seed was saved, like a hand-written one.
        = render layout: 'seeds/fact_row',
                 locals: { seed:, label: 'Year saved', display: 'savedat', muted: seed.saved_at.blank?,
                           edit: [:date, :saved_at] } do
          %strong= seed.saved_at.present? ? seed.saved_at.year : 'Unknown'

        = render layout: 'seeds/fact_row',
                 locals: { seed:, label: 'Will trade', display: 'tradableto',
                           edit: [:select, :tradable_to], values: Seed::TRADABLE_TO_VALUES } do
          %strong= seed.tradable_to
          %span
            - if seed.owner.location.blank?
              (from unspecified location)
              - if current_member == seed.owner
                = link_to 'Set Location', edit_registration_path(current_member), class: 'btn btn-outline-secondary btn-sm'
            - else
              (from #{link_to seed.owner.location, place_path(seed.owner.location, anchor: 'seeds')})

        - if seed.finished_at.present? || seed.finished?
          = render layout: 'seeds/fact_row', locals: { seed:, label: 'Finished' } do
            %strong
              - if seed.finished_at.present?
                = I18n.t('date.abbr_month_names')[seed.finished_at.month]
              - elsif seed.finished?
                = finished_icon
            - if seed.finished_at.present?
              %span= seed.finished_at.year

      - if can?(:edit, seed)
        = bootstrap_form_for(seed, html: { class: 'packet-sheet-form' }) do |f|
          = render 'seeds/edit_fields', f: f, seed: seed
          .packet-sheet-form-actions
            = f.submit 'Save', class: 'btn btn-primary'
            %button.btn.btn-secondary{ type: 'button', data: { packet_sheet_cancel: '' } } Cancel

  - if panel.present?
    .col-lg-6
      = panel

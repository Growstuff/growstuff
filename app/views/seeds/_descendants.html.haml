-# What grew from this packet. Takes `seed` as a local like every other
-# partial here, rather than reaching for @seed.
- if seed.child_plantings.any?
  .index-cards
    - seed.child_plantings.each do |planting|
      = render 'plantings/card', planting: planting
- else
  %p.text-muted.mb-0 Nothing has been grown from these seeds yet.

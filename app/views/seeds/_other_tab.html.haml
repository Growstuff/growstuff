-# What the tab a search or filter has not looked in holds, so an empty result
-# is not read as "none anywhere".
- if @other_count.positive?
  = @show_finished ? t('.more_in_stock', count: @other_count) : t('.more_finished', count: @other_count)
  = link_to t('.show_them'), seed_view_path(finished: (@show_finished ? nil : 1))

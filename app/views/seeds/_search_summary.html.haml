-# What a search found, and what the other tab holds, so a search that comes up
-# empty in stock is not read as "none anywhere".
- other_count = @show_finished ? @in_stock_count : @finished_count
- other_label = @show_finished ? 'in stock' : 'finished'
- if @seeds.present?
  .seed-search-summary
    %b= "#{pluralize @seeds.total_entries, 'packet'} of #{@query} seeds."
    - if other_count.positive?
      #{other_count} more #{other_label}.
      = link_to 'Show them', url_for(finished: (@show_finished ? nil : 1), page: nil)

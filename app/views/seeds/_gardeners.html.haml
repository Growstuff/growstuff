-# Who shares a variety, nearest first, each with a way to ask them for seeds.
- crop = packets.first.crop
- gardeners = packets.map(&:owner_id).uniq.size
.seed-stack-panel.seed-gardeners
  .seed-stack-panel-head
    %b
      = crop.name
      %small.text-muted= "#{pluralize gardeners, 'gardener'} #{gardeners == 1 ? 'has' : 'have'} it · nearest first"
    %span
      = link_to "Open the #{crop.name} page →", crop_path(crop)
      = link_to 'Close ▴', url_for(open: nil, page: nil, anchor: "variety-#{crop.id}")
  %ul.seed-gardener-list
    - nearest_first(packets).uniq(&:owner_id).each do |seed|
      %li.seed-gardener
        = image_tag avatar_uri(seed.owner, 38), alt: seed.owner_login_name, width: 38, height: 38, class: 'seed-gardener-image'
        .seed-gardener-about
          %b= link_to seed.owner_login_name, member_path(seed.owner)
          %span.text-muted
            = [seed.owner_location&.split(',')&.first, seed_distance(seed)].compact_blank.join(' · ')
          %div.small.text-muted
            = [display_seed_quantity(seed).then { |q| seed.quantity ? "approx. #{q}" : nil }, (seed.saved_at && "saved #{seed.saved_at.year}")].compact.join(' · ')
        .seed-gardener-trade= "Will trade #{seed.tradable_to}"
        - if current_member && current_member != seed.owner
          - ask = { recipient_id: seed.owner_id, subject: "Interested in your #{seed.crop} seeds", seed_id: seed.id }
          = link_to 'Request seeds', new_message_path(ask), class: 'btn btn-primary btn-sm'
        - elsif current_member.blank?
          = link_to 'Sign in to request', new_member_session_path, class: 'btn btn-outline-primary btn-sm'

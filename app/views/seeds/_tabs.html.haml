-# In stock and finished, each with how many there are under the filters in force.
%ul.nav.nav-tabs
  %li.nav-item
    = link_to seed_view_path(finished: nil, all: nil), class: ['nav-link', ('active' unless @show_finished || @show_all)] do
      = t('.in_stock')
      %small= @in_stock_count
  %li.nav-item
    = link_to seed_view_path(finished: 1, all: nil), class: ['nav-link', ('active' if @show_finished)] do
      = t('.finished')
      %small= @finished_count

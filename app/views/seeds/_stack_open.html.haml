-# A pile of packets opened out: each packet as its own card, with the way to
-# the variety's page and to close the pile again.
- crop = packets.first.crop
.seed-stack-panel{ id: "stack-#{crop.id}" }
  .seed-stack-panel-head
    %b #{crop.name} · #{pluralize packets.size, 'packet'}
    %span
      = link_to "Open the #{crop.name} page →", crop_path(crop)
      = link_to 'Close ▴', url_for(open: nil, page: nil, anchor: "stack-#{crop.id}")
  .seed-shelf-packets
    - packets.each do |packet|
      = render 'seeds/packet', seed: packet

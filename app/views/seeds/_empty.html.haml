-# Nothing to show, and why: a filter hiding everything is not the same as having no seeds.
- if @filtered
  %p.seed-empty
    = t('.no_match')
    = link_to t('.show_all'), seed_view_path(**seed_filters_off)
- elsif @show_finished
  %p.seed-empty= t('.no_finished')
- else
  %p.seed-empty= t('.none_recorded')

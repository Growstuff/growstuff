-# Nothing to show, and why: a filter hiding everything is not the same as having no seeds.
- if @filtered
  %p.seed-empty
    No seeds match those filters.
    = link_to 'Show all seeds', seed_view_path(from: nil, heirloom: nil, shared: nil, sow_month: nil, within: nil, tradeable_to: nil, past: nil)
- elsif @show_finished
  %p.seed-empty No finished seeds yet.
- else
  %p.seed-empty No seeds recorded yet

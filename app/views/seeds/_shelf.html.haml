-# One shelf of seeds: a green bar naming the group, over the packets stood on
-# it, one pile for each variety. The first few shelves are open; the rest fold
-# up to their bar.
- stacks = seed_stacks(seeds, by_owner: everyone)
- counts = [pluralize(seeds.size, 'packet')]
- counts.unshift pluralize(stacks.map { |stack| stack.first.crop_id }.uniq.size, 'variety', plural: 'varieties') if stacks.size > 1
- counts << pluralize(seeds.map(&:owner_id).uniq.size, 'gardener') if everyone
%details.seed-shelf{ open: position < 3, id: "shelf-#{shelf.respond_to?(:id) ? shelf.id : shelf.to_s.parameterize}" }
  %summary.seed-shelf-bar
    %h3
      = shelf.is_a?(Crop) ? link_to(shelf.name, crop_path(shelf)) : shelf.capitalize
      %small= counts.join(' · ')
    - if owned && shelf.is_a?(Crop)
      = link_to '+ add seeds', new_seed_path(crop_id: shelf.id), class: 'seed-shelf-open-only', data: { record_dialog: 'seeds', crop_id: shelf.id, crop_name: shelf.name }
    %span.seed-shelf-closed-only ▸ Open shelf
  .seed-shelf-packets
    - stacks.each do |stack|
      = render 'seeds/stack', packets: stack, show_owner: everyone

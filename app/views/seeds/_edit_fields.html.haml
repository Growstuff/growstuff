-# Every field of a packet of seed that is edited by hand, for the form that
-# replaces the packet sheet's list. Changing the crop goes on to ask about the
-# plantings and other records grown from the packet.
.mb-3
  = label_tag 'crop', t('seeds.ui.change_crop')
  = auto_suggest seed, :crop, class: 'form-control', required: true
.row.mb-3
  .col-md-6
    = f.date_field :saved_at,
                   value: seed.saved_at ? seed.saved_at.to_fs(:ymd) : '',
                   label: t('seeds.ui.saved_at')
  .col-md-6
    = f.number_field :quantity, min: 0, label: t('seeds.ui.seed_quantity')
.row.mb-3
  .col-md-6
    = f.number_field :plant_before_year, label: t('seeds.ui.plant_before_year'),
                     min: Seed::PLANT_BEFORE_YEARS.first, max: Seed::PLANT_BEFORE_YEARS.last
  .col-md-6
    = f.select :tradable_to, Seed::TRADABLE_TO_VALUES.map { |value| [t("seeds.ui.trade_scopes.#{value}"), value] }, { include_blank: false, label: t('seeds.ui.trade_label') }
.row.mb-3
  .col-md-6
    = f.text_field :variety, label: t('seeds.ui.variety')
  .col-md-6
    = f.text_field :batch_number, label: t('seeds.ui.batch_number')
.row.mb-3
  .col-md-6
    = f.number_field :days_until_maturity_min, min: 1, label: t('seeds.ui.maturity_min')
  .col-md-6
    = f.number_field :days_until_maturity_max, min: 1, label: t('seeds.ui.maturity_max')
.row.mb-3
  .col-md-6
    = f.number_field :row_spacing, min: 1, label: t('seeds.ui.row_spacing_cm')
= render 'seeds/sowing_fields', f: f, seed: seed, prefix: 'edit-all'
.row.mb-3
  .col-md-4
    = f.select :organic, Seed::ORGANIC_VALUES, { include_blank: false, label: t('seeds.ui.organic') }
  .col-md-4
    = f.select :gmo, Seed::GMO_VALUES, { include_blank: false, label: t('seeds.ui.gmo') }
  .col-md-4
    = f.select :heirloom, Seed::HEIRLOOM_VALUES, { include_blank: false, label: t('seeds.ui.heirloom') }
  .col-md-4
    = f.select :hardiness, Seed::HARDINESS_VALUES.map { |value| [t("seeds.hardiness.#{value}"), value] }, { include_blank: false, label: t('seeds.hardiness.label') }
.mb-3
  = f.select :source, Seed::SOURCE_VALUES, { include_blank: false, label: t('seeds.ui.source_question') }
.mb-3
  = f.text_area :description, rows: 4, label: t('seeds.ui.notes')

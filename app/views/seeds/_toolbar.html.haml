-# Search, how to group, and cards or list on one line, then the chips that
-# narrow what is shown.
.seed-toolbar
  = form_tag url_for, method: :get, class: 'seed-search', role: 'search' do
    - request.query_parameters.slice('group', 'view', 'finished', 'from', 'within', 'scope').compact_blank.each do |name, value|
      = hidden_field_tag name, value
    = label_tag :q, 'Search seeds', class: 'visually-hidden'
    = search_field_tag :q, @query, placeholder: (@everyone ? 'Search all shared seeds' : 'Search seeds'), class: 'form-control'
  .seed-group-by
    %span.seed-toolbar-label Group by
    - { 'crop' => 'Crop', 'source' => 'Where from', 'year' => 'Year saved', 'heirloom' => 'Heirloom or hybrid' }.each do |key, label|
      = seed_choice_link label, @group_by == key, group: key
  .seed-seg{ role: 'group', 'aria-label': 'View as' }
    = seed_choice_link 'Cards', !@list_view, css_class: nil, view: nil
    = seed_choice_link 'List', @list_view, css_class: nil, view: 'list'
%ul.seed-chips
  - seed_filter_chips(everyone: @everyone).each do |label, url_params, active|
    %li= seed_choice_link label, active, **url_params

= form_with url: member_mastodon_omniauth_authorize_path, class: 'mb-3', data: { turbo: false } do |f|
  = f.label :identifier, 'Mastodon address', class: 'form-label'
  .input-group
    = f.text_field :identifier, placeholder: 'alice@mastodon.social', class: 'form-control', required: true, autocomplete: 'username', autocapitalize: 'none', spellcheck: false
    = f.button class: 'btn btn-outline-dark' do
      = icon 'fab', 'mastodon'
      = label
  .form-text We only ask who you are. We can't post for you.
  - if local_assigns.fetch(:tos, true)
    .form-check.mt-2
      = f.check_box :tos_agreement, { class: 'form-check-input', required: true }, '1', nil
      = f.label :tos_agreement, class: 'form-check-label' do
        I agree to the
        = link_to 'Terms of Service', '/policy/tos', target: '_blank', rel: 'noopener'

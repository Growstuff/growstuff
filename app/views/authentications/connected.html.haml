!!! 5
%html{lang: I18n.locale}
  %head
    %meta{charset: 'utf-8'}
    %meta{name: 'viewport', content: 'width=device-width, initial-scale=1'}
    %title= t(@connected ? '.connected_title' : '.not_connected_title')
    = stylesheet_link_tag 'application'
  %body.p-4
    - if @connected
      %h1= t('.connected_heading')
      %p= t('.connected_help')
    - else
      %h1= t('.not_connected_heading')
      %p= t('.not_connected_help')
    %button.btn{type: 'button', onclick: 'window.close()'}= t('.close_window')
    :javascript
      window.close();

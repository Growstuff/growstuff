development:
  adapter: postgresql
  database: growstuff_dev
  host: localhost
  user: postgres
  password: postgres
  variables:
    # Crop search (SearchCrops) relies on this threshold for the <% operator.
    pg_trgm.word_similarity_threshold: 0.35

test:
  adapter: postgresql
  database: growstuff_test
  host: localhost
  user: postgres
  password: postgres
  variables:
    # Crop search (SearchCrops) relies on this threshold for the <% operator.
    pg_trgm.word_similarity_threshold: 0.35

production:
  adapter: postgresql
  database: growstuff_prod
  pool: 5
  timeout: 5000
  username: growstuff
  host: localhost
  password: thisisnottherealpassword
  variables:
    # Crop search (SearchCrops) relies on this threshold for the <% operator.
    pg_trgm.word_similarity_threshold: 0.35

staging:
  adapter: postgresql
  database: growstuff_prod
  pool: 5
  timeout: 5000
  username: growstuff
  host: localhost
  password: thisisnottherealpassword
  variables:
    # Crop search (SearchCrops) relies on this threshold for the <% operator.
    pg_trgm.word_similarity_threshold: 0.35
